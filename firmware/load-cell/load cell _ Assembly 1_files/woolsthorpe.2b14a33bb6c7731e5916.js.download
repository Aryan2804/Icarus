al learning projects, school clubs/organizations, and academic research. I will not use this plan for government, commercial, or other organizational use" | i18next }}\n          </span>\n        </label>\n      </div>\n      <div class="consent-checkbox">\n        <label for="privacyConsentAccepted" id="privacy_consent_text">\n          <input type="checkbox" ng-model="$ctrl.state.options.privacyConsentAccepted" name="privacyConsentAccepted" required\n            id="privacyConsentAccepted" />\n          <span class="os-radio-or-checkbox-text"\n            ng-i18next="[html:i18next]({privacyPolicyLink: $ctrl.privacyPolicyLink, termsOfUseLink: $ctrl.termsOfUseLink })I agree to these terms as well as Onshape\'s <a href=\'__termsOfUseLink__\' target=\'_blank\'>Terms of Use</a> and <a href=\'__privacyPolicyLink__\' target=\'_blank\'>Privacy Policy</a> and confirm that the above information is accurate and truthful."></span>\n        </label>\n      </div>\n    </div>\n    <div class="os-form-group wide-form-group">\n    </div>\n    <div class="os-form-group">\n      <div>\n        <button class="btn btn-primary" id="btn-user-account-save" ng-disabled="eduRenewalForm.$invalid">{{\n          "Renew Education subscription" | i18next}}</button>\n      </div>\n    </div>\n  </form>\n</div>\n</div>\n')}]),e.exports=i},48228:function(e,t,n){var i="/project/web/ts/userSettings/settings.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="os-profile-vertical-list">\n  \x3c!-- locale section --\x3e\n  <osx-preference-language></osx-preference-language>\n  \x3c!-- Theming preference section --\x3e\n  <osx-preference-themes\n    [user-current-theme]="$ctrl.userCurrentTheme"\n    (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n  </osx-preference-themes>\n\n  \x3c!-- decimal format section --\x3e\n  <osx-preference-decimal-format\n    [use-decimal-comma]="$ctrl.useDecimalComma"\n    (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n  </osx-preference-decimal-format>\n\n  \x3c!-- Startup page section --\x3e\n  <div class="user-profile-section-header" ng-if="$ctrl.isEnterprise()">\n    <h4>{{ "Startup page" | i18next }}</h4>\n  </div>\n  <div class="user-settings" ng-if="$ctrl.isEnterprise()">\n    <osx-startup-page\n      [startup-page]="$ctrl.startupPage"\n      [startup-page-message]="$ctrl.startupPageMessage"\n      (update-startup-page)="$ctrl.updateStartupPage($event)">\n    </osx-startup-page>\n  </div>\n\n  \x3c!-- Unit section --\x3e\n  <div class="user-profile-section-header">\n    <h4>{{ "Units" | i18next }}</h4>\n  </div>\n  <div class="user-profile-sub-section">\n    <span>{{\'Change the default units for all newly created documents. Units for existing documents are not changed.\' | i18next}}\n      <a href="{{$ctrl.helpUrl}}" target="_blank">{{\'Learn more about default units.\' | i18next}}</a>\n    </span>\n  </div>\n  \x3c!-- Default Unit and precision section --\x3e\n  <div class="user-settings">\n    <div class="os-form-container">\n      <form class="form-horizontal" ng-submit="$ctrl.updateUserUnitAndDisplayPrecision()">\n        <osx-system-units\n          [is-for-user-settings]="true"\n          [is-for-new-user-setup]="false"\n          [user-settings]="$ctrl.userSettings"\n          (on-unit-change)="$ctrl.onUnitChange($event)"\n          (on-precision-change)="$ctrl.onPrecisionChange($event)">\n        </osx-system-units>\n        <div>\n          <table class="os-units-display-precision-table">\n            <tbody>\n            \x3c!-- Time format --\x3e\n            <tr>\n              <td class="os-units-display-heading">\n                <label>{{"Time format" | i18next}}</label>\n              </td>\n            </tr>\n            <tr>\n              <td class="os-units-display">\n                <select class="form-control" id="userAccountSettings-time-format-