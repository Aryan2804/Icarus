-pane">\n  <div id="billofmaterials-toplevel" class="os-col" ng-controller="BOMController as bomController" os-context-menu="bomController.contextMenu()">\n    <div class="billofmaterials-header-tabs" os-parameter="bomController.tabParameter"></div>\n    <div class="tables-container-wrapper">\n      <div class="tables-container enable-user-select"\n           os-table-container\n           os-virtual-scroll\n           os-select-dropdown-bounds\n           os-scroll-selected>\n        <div data-parameter-id="bomTable">\n          <div class="os-row os-no-shrink os-wrap os-justify-between billofmaterials-context-select os-table-description">\n            <div class="os-table-header-responsive-first-row">\n              <label class="billofmaterials-context-label os-no-shrink">{{"BOM type:" | i18next}}</label>\n              <select class="bom-type-selector form-control billofmaterials-selector"\n                      ng-model="bomController.activeBomType"\n                      ng-change="bomController.onActiveBomTypeChanged()"\n                      ng-options="bomType.name for bomType in bomController.bomTypes | orderBy:\'name\' track by bomType.id">\n              </select>\n\n              <button class="os-button billofmaterials-sync-bom-plm-button"\n                      ng-if="bomController.canSyncBomToPLM() && !bomController.showJobQueue()"\n                      ng-click="bomController.syncBomToPLM()"\n                      ng-disabled="bomController.isSyncBomToPLMBtnDisabled()">\n                <os-svg icon="{{bomController.syncBomIcon()}}" data-bs-original-title="{{bomController.syncBomTooltip()}}"></os-svg>\n              </button>\n\n              <div class="btn-group" ng-if="bomController.showJobQueue()">\n                <button class="os-button btn btn-sm billofmaterials-sync-bom-plm-button"\n                        ng-click="bomController.syncBomToPLM()"\n                        ng-disabled="bomController.isSyncBomToPLMBtnDisabled()">\n                  <os-svg icon="{{bomController.syncBomIcon()}}" data-bs-original-title="{{bomController.syncBomTooltip()}}"></os-svg>\n                </button>\n                <button type="button" class="os-button btn btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown"\n                  aria-haspopup="true" aria-expanded="false">\n                </button>\n                <div class="dropdown-menu dropdown-menu-end">\n                  <a class="dropdown-item" ng-href="{{ bomController.getPLMJobQueueUrl() }}" target="_blank">{{\'Job queue\' | i18next}}</a>\n                </div>\n              </div>\n                <button class="os-button billofmaterials-open-bom-in-plm-button"\n                        ng-if="bomController.showSyncedItemLinkBtn()"\n                        ng-click="bomController.onSyncedItemLinkBtnClick()"\n                        ng-disabled="bomController.isSyncedItemLinkBtnDisabled()"\n                        data-bs-original-title="{{ \'tooltips:::Open in __pLMName__\' | i18next:{ pLMName: bomController.activeWorkflow.pLMName } }}">\n                    <os-svg icon="{{bomController.openSyncedItemIcon()}}" data-bs-original-title="{{bomController.syncedItemLinkBtnTooltip()}}"></os-svg>\n                </button>\n            </div>\n            <div class="os-table-header-responsive-last-row bom-header-flex-wrap">\n              <div ng-if="bomController.allowItemsManagement"\n                   class="billofmaterials-insert-items-button"\n                   data-bs-original-title="{{\'tooltips:::Insert items\' | i18next}}"\n                   data-bs-placement="right"\n                   ng-click="bomController.openInsertItemsDialog()">\n                <os-svg icon="insert-item-button"></os-svg>\n              </div>\n              <div class="dropdown os-add-property-dropdown add-bom-column" auto-close="outsideClick"\n                     data-bs-original-title="{{\'tooltips:::Add columns to the BOM table\' | i18next}}"\n                     data-bs-placement="left">\n                <div data-bs-toggle="dropdown"\n                     class="dropdown-toggle btn btn-secondary btn-sm small-secondary-btn manage-columns-button"\n                     data-bs-offset="0,0"\n                     ng-click="bomController.retrieveColumns()"\n                     >{{ "Add column" | i18next }}&ensp;\n                </div>\n\n                <ul class="add-column-dropdown-menu add-bom-column dropdown-menu dropdown-menu-end" role="menu" ng-switch="bomController.possibleColumns.length > 0">\n                  <li ng-switch-when="true" ng-repeat="column in bomController.possibleColumns">\n                    <a class="dropdown-item" ng-click="bomController.columnAdded(column, $event)" data-bs-original-title="{{ column.displayName }}">\n                      <span>{{ column.displayName }}</span>\n                    </a>\n                  </li>\n                  <li ng-switch-when="false">\n                    <a class="dropdown-item disabled"><span>{{"No columns available" | i18next}}</span></a>\n                  </li>\n                </ul>\n              </div>\n              <div class="dropdown-button-container">\n                <div ng-if="bomController.shouldShowApplyTemplates()"\n                     class="dropdown os-add-property-dropdown apply-bom-template" auto-close="always"\n                     data-bs-original-title="{{\'tooltips:::Apply template to BOM table\' | i18next}}"\n                     data-bs-placement="left">\n                  <div data-bs-toggle="dropdown"\n                       data-bs-offset="0,0"\n                       class="dropdown-toggle btn btn-secondary btn-sm small-secondary-btn manage-columns-button"\n                       >{{ "Apply template" | i18next }}&ensp;\n                  </div>\n\n                  <ul class="add-column-dropdown-menu apply-bom-template dropdown-menu dropdown-menu-end" role="menu"\n                      ng-switch="bomController.tableTemplates.length > 0">\n                    <li ng-switch-when="true" ng-repeat="template in bomController.tableTemplates">\n                      <a class="dropdown-item" ng-click="bomController.applyTemplateToBomTable(template)" data-bs-original-title="{{ template.name }}">\n                        <span>{{ template.name }}</span>\n                      </a>\n                    </li>\n                    <li ng-switch-when="false" class="disabled">\n                      <a class="dropdown-item"><span>{{ "No templates created" | i18next }}</span></a>\n                    </li>\n                  </ul>\n                </div>\n                \x3c!-- To keep it at right most side so that dropdown options will not get cut-off even when panel size is reduced (BEL-161813) --\x3e\n                <span class="os-pin-right"></span>\n                \x3c!-- Use ng-show nested inside an ng-if to solve BEL-79834 (each dropdown needs its own angular scope which is provided by ng-if but also needs the ng-show so that the dropdown isn\'t removed (so it can get all of its events) --\x3e\n                <div ng-if="true" class="os-no-shrink">\n                  <li class="dropdown os-table-more-button-container">\n                    <a data-bs-toggle="dropdown"\n                       class="os-table-more-button-control"\n                       >\n                      <os-svg icon="overflow"></os-svg>\n                    </a>\n                    <ul class="dropdown-menu dropdown-menu-end os-table-more-menu">\n                      <li ng-if="bomController.getCanCopyTable()">\n                        <a class="dropdown-item" os-clipboard\n                           os-generate-clipboard-text="bomController.copyActiveTableToClipboard()"\n                           os-clipboard-success="bomController.onCopyTableSuccess();"\n                           os-clipboard-error="bomController.onCopyTableFailed(e);">{{ "Copy table" | i18next}}</a>\n                      </li>\n                      <li ng-switch="bomController.showingExcluded">\n                        <a class="dropdown-item" ng-switch-when="true" ng-click="bomController.showExcluded(false)">{{ "Hide excluded/suppressed" | i18next}}</a>\n                        <a class="dropdown-item" ng-switch-when="false" ng-click="bomController.showExcluded(true)">{{ "Show excluded/suppressed" | i18next}}</a>\n                      </li>\n                      <li><a class="dropdown-item" ng-if="bomController.isIndented()" ng-click="bomController.expandOrCollapseAll(false)">{{ "Collapse all" | i18next}}</a></li>\n                      <li><a class="dropdown-item" ng-if="bomController.isIndented()" ng-click="bomController.expandOrCollapseAll(true)">{{ "Expand all" | i18next}}</a></li>\n                      <li ng-switch="bomController.isShowingTopLevelAssemblyRow()">\n                        <a class="dropdown-item" ng-switch-when="true" ng-click="bomController.showTopLevelAssemblyRow(false)">{{ "Hide top level assembly row" | i18next}}</a>\n                        <a class="dropdown-item" ng-switch-when="false" ng-click="bomController.showTopLevelAssemblyRow(true)">{{ "Show top level assembly row" | i18next}}</a>\n                      </li>\n                      <li><a class="dropdown-item" ng-if="bomController.shouldShowSaveAsTemplate()" ng-click="bomController.saveAsTemplate()">{{ "Save as template…" | i18next }}</a></li>\n                      <li ng-if="bomController.canExport()" class="dropdown-divider"></li>\n                      <li><a class="dropdown-item" ng-if="bomController.canExport()" ng-click="bomController.exportBillOfMaterials()">{{ "Export to CSV" | i18next}}</a></li>\n                    </ul>\n                  </li>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div ng-if="bomController.bomTable" ng-hide="bomController.retrievingBOMData">\n            <div ng-if="!bomController.isTableEmpty() && bomController.isRea