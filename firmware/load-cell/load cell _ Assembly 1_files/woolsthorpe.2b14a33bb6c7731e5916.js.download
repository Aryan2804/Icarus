el\' | i18next}}</button>\n    </div>\n  </div>\n</form>\n')}]),e.exports=i},46459:function(e,t,n){var i="/project/web/ts/release-management/revision-history-dialog.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="modal-header no-border">\n  <h3 class="modal-title">{{ "Revision history" | i18next}}</h3>\n  <button type="button" class="btn-close" ng-click="ctrl.close()" aria-hidden="true"></button>\n</div>\n<div class="modal-body">\n  <h4 class="m-0" data-bs-original-title="{{ partNumber }}">{{ partNumber }}</h4>\n  <os-spinner spinner="spinner"></os-spinner>\n  <div ng-if="!spinner.show" class="revision-history-view">\n    <part-history\n      message="message"\n      revisions="revisions"\n      compact="false"\n      row-class="\'revision-details-row\'"\n      revision-title-class="\'revision-details-title\'"\n      revision-subtitle-class="\'revision-details-subtitle\'"\n      on-view-btn-click="ctrl.showPackage(packageId, highlightItems)"\n      on-obsolete-btn-click="ctrl.obsoleteRevision(rev)">\n    </part-history>\n  </div>\n\n  <div class="modal-footer no-border revision-history-footer">\n    <button class="btn btn-secondary button-cancel" type="button" ng-click="ctrl.close()">{{"Close" | i18next}}</button>\n  </div>\n</div>\n')}]),e.exports=i},31269:function(e,t,n){var i="/project/web/ts/requestInvite/requestInvite.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="os-content-scroll-container">\n  <div class="os-brand-logo-container">\n    <img src="/images/logo-onshape-gray-green_medium.svg" alt="Onshape Brand" />\n  </div>\n  <div class="os-centered-form-container-narrow">\n    <os-form os-controller-name="RequestInviteController">\n      <h3>{{ "Create Free account" | i18next}}</h3>\n      <div class="os-form-group">\n        <os-form-field>\n          <input placeholder="{{\'Email\' | i18next}}" class="form-control" name="email" ng-model="RequestInviteController.user.email" type="text" required os-email spellcheck="false" />\n          <os-form-validation-list os-field-name="email">\n            <os-form-validation-item os-error-criteria="osForm.email.$invalid" os-message="{{\'Valid email required\' | i18next}}"></os-form-validation-item>\n          </os-form-validation-list>\n        </os-form-field>\n      </div>\n      <div class="os-form-group">\n        <h4>{{\'Name\' | i18next}}</h4>\n        <os-form-field class="os-form-field-half-width">\n          <input placeholder="{{\'First name\' | i18next}}" type="text" class="form-control" name="firstName" ng-model="RequestInviteController.user.firstName" ng-maxlength="64" spellcheck="false" required>\n          <os-form-validation-list os-field-name="firstName">\n            <os-form-validation-item os-error-criteria="osForm.firstName.$error.maxlength" os-message="{{\'64 character maximum\' | i18next}}"></os-form-validation-item>\n          </os-form-validation-list>\n        </os-form-field>\n        <os-form-field class="os-form-field-half-width">\n          <input placeholder="{{\'Last name\' | i18next}}" type="text" class="form-control" name="lastName" ng-model="RequestInviteController.user.lastName" ng-maxlength="64" spellcheck="false" required>\n          <os-form-validation-list os-field-name="lastName">\n            <os-form-validation-item os-error-criteria="osForm.lastName.$error.maxlength" os-message="{{\'64 character maximum\' | i18next}}"></os-form-validation-item>\n          </os-form-validation-list>\n        </os-form-field>\n        <div class="clearfix"></div>\n      </div>\n      <div class="os-form-group">\n        <h4>{{\'Role\' | i18next}}</h4>\n        <select class="form-control" ng-model="RequestInviteController.selectedRole.content" ng-options="userRole as userRole.label for userRole in RequestInviteController.userRoles">\n          <option value="" disabled>{{\'Choose your role:\' | i18next}}</option>\n        </select>\n      </div>\n      <div class="os-form-group">\n        <h4>{{\'Company\' | i18next}}</h4>\n        <os-form-field>\n          <input placeholder="{{\'Company name (optional)\' | i18next}}" type="text" name="defaultCompanyName" class="form-control" ng-model="RequestInviteController.user.defaultCompanyName" ng-maxlength="64" spellcheck="false">\n        </os-form-field>\n        <div>\n          <os-form-validation-list os-field-name="defaultCompanyName">\n            <os-form-validation-item os-error-criteria="osForm.defaultCompanyName.$error.maxlength" os-message="{{\'64 character maximum\' | i18next}}"></os-form-validation-item>\n          </os-form-validation-list>\n        </div>\n      </div>\n      <div class="os-form-field-container">\n        <input type="checkbox" id="EULA" name="EULA" ng-model="RequestInviteController.user.eulaAccepted">\n        <label for="EULA">{{ \'I agree to the\' | i18next}}</label>\n        <a ng-href="https://www.onshape.com/legal" target="_blank" class="add-space-left">{{\'Onshape Terms & Privacy\' | i18next}}</a>\n      </div>\n      <div class="os-form-btn-container">\n        <button type="submit" class="btn btn-primary" ng-disabled="!RequestInviteController.user.eulaAccepted || RequestInviteController.selectedRole.content.code < 1">{{ "Create Free account" | i18next}}</button>\n      </div>\n      <div class="os-form-footer" ng-if="!RequestInviteController.mobileBrowserDetected">\n        <a ng-click="RequestInviteController.goToSignIn()" class="os-link-to-sign-in" tabindex="6">{{\'Sign in\' | i18next}}</a>\n      </div>\n    </os-form>\n  </div>\n</div>\n')}]),e.exports=i},50964:function(e,t,n){var i="/project/web/ts/security/confirmPassword.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="modal-header">\n  <h4 class="modal-title">{{ "Confirm your Onshape password" | i18next}}</h4>\n  <button type="button" class="btn-close" aria-hidden="true" ng-click="confirmPasswordController.cancelDialog()"></button>\n</div>\n<div class="modal-body confirm-password">\n  <input bt-focus="true" placeholder="{{\'Password\' | i18next}}" class="form-control" name="password" ng-model="confirmPassword" type="password" os-enter="confirmPasswordController.close(confirmPassword)" required bt-focus="true"/>\n  <div class="notification-message">\n    {{notificationMessage}}\n  </div>\n</div>\n<div class="modal-footer">\n  <button class="btn btn-primary" ng-click="confirmPasswordController.close(confirmPassword)" aria-hidden="true" ng-disabled="!confirmPassword">{{ "OK" | i18next}}</button>\n  <button class="btn btn-secondary button-cancel" ng-click="confirmPasswordController.cancelDialog()">{{ "Cancel" | i18next}}</button>\n</div>\n')}]),e.exports=i},22549:function(e,t,n){var i="/project/web/ts/selectItem/selectItemWidget.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="select-item-dialog-main-body os-col"\n     ng-controller="SelectItemWidgetController as Ctrl"\n     ng-class="{\'fill-width\': viewState.fillWidth, \'showing-insertables\': viewState.getIsShowingInsertablesView(), \'showing-document-list\': viewState.getDocumentSelector().getCanShowDocumentList(), \'show-other-documents\': viewState.showOtherDocuments}">\n\n  \x3c!-- Fetching error in the dialog --\x3e\n  <div class="alert alert-info alert-small os-no-shrink" ng-if="viewState.shouldShowDocumentLoadError()">\n    {{ viewState.getDocumentSelector().getLoadError() }}\n  </div>\n\n  \x3c!-- Document source filters --\x3e\n  <div class="os-row os-dialog-tab-group os-dialog-tab-group-source os-no-shrink" ng-if="Ctrl.documentVersionPicker.shouldShowSourceFilters()">\n    <div class="os-dialog-tab document-version-picker-header-tab"\n         ng-repeat="documentSelector in Ctrl.documentVersionPicker.getDocumentSelectors()"\n         ng-if="documentSelector.getCanShowSelector()"\n         ng-class="{\'active-tab\': (viewState.getDocumentSelector() === documentSelector)}"\n         ng-disabled="viewState.getIsReadOnly()"\n         ng-click="Ctrl.documentVersionPicker.changeTabAsUserEdit(documentSelector)">{{documentSelector.getSelectorName()}}</div>\n  </div>\n\n  \x3c!-- Document title row --\x3e\n  <div class="os-dialog-title-row os-no-shrink"\n    ng-if="viewState.shouldShowDocumentTitleRow()">\n    <os-select-item-home-btn view-state="viewState"></os-select-item-home-btn>\n    <button class="os-button os-clear document-version-picker-go-back-from-selected-document"\n            type="button"\n            ng-if="viewState.getDocumentSelector().getCanGoBackFromPickedDocument()"\n            ng-click="viewState.getDocumentSelector().goBackFromPickedDocument()"\n            data-bs-original-title="{{ viewState.getDocumentSelector().getBackButtonTitle() }}"\n            data-bs-placement="left">\n      <os-svg icon="back-tab" class="button-icon"></os-svg>\n    </button>\n    <div class="select-item-dialog-document-name-box os-col os-grow">\n      <span class="select-item-dialog-document-name document-version-picker-current-document ellipseOverflowText"\n            ng-class="{\'no-workspace-name\': viewState.getDocumentSelector().getIsShowingReleasedItems()}">\n        {{viewState.getDocumentDisplayName()}}\n      </span>\n      <span class="select-item-dialog-document-version-name ellipseOverflowText"\n            ng-show="!viewState.getDocumentSelector().getIsShowingReleasedItems() && !!viewState.getDocumentSelector().getWorkspaceOrVersionName()">\n        <img src="/images/version-graph-button.svg" class="select-item-dialog-document-version-image"/>\n        {{viewState.getDocumentSelector().getWorkspaceOrVersionName()}}\n      </span>\n    </div>\n    <button class="os-button document-released-items-picker-button"\n            ng-class="{\'os-active\': viewState.getDocumentSelector().getIsShowingReleasedItems()}"\n            ng-click="viewState.getDocumentSelector().toggleReleasedItemsView()"\n            ng-if="Ctrl.documentVersionPicker.getCanShowSwitchVersionOrReleaseButton() && viewState.getDocumentSelector().canShowReleasedItemsFilter()"\n            ng-disabled="!viewState.getDocumentSelector().getHasLinkAccessToSelectedDocument()"\n            type="button"\n            data-bs-original-title="{{\'View released items\' | i18next}}"\n            data-bs-placement="left">\n      <os-svg icon="released"></os-svg>\n    </button>\n    <button class="os-button document-version-picker-create-version-button"\n            ng-show="Ctrl.documentVersionPicker.getCanShowCreateVersionButton()"\n            ng-click="viewState.getDocumentSelector().promptForSavingVersion()"\n            type="button"\n            ng-disabled="!Ctrl.insertableSelector.getIsCreateVersionEnabled()"\n            data-bs-original-title="{{\'tooltips:::Create version…\' | i18next}}"\n            data-bs-placement="left">\n      <os-svg icon="create-version-button"></os-svg>\n    </button>\n    <button class="os-button document-version-picker-version-button"\n            ng-class="{\'os-active\': viewState.showVersionGraph}"\n            ng-show="Ctrl.documentVersionPicker.getCanShowSwitchVersionOrReleaseButton()"\n            ng-disabled="!viewState.getDocumentSelector().getHasLinkAccessToSelectedDocument()"\n            ng-click="viewState.getDocumentSelector().toggleVersionGraph()"\n            type="button"\n            data-bs-original-title="{{\'Version graph\' | i18next}}"\n            data-bs-placement="left">\n      <os-svg icon="version-graph-button"></os-svg>\n    </button>\n  </div>\n\n  \x3c!--  Element type filters --\x3e\n  <div ng-if="viewState.shouldShowElementTypeTabs(documentInsertableSet)"\n       class="os-dialog-tab-group os-no-shrink">\n    <div class="os-dialog-tab insert-filter"\n         ng-repeat="insertableGroup in documentInsertableSet.getGroups()"\n         ng-class="{\'active-tab\': documentInsertableSet.getIsGroupActive(insertableGroup)}"\n         ng-click="documentInsertableSet.switchToInsertableGroup(insertableGroup)">\n      {{insertableGroup.getDisplayName()}}\n    </div>\n  </div>\n\n  \x3c!-- Document search box --\x3e\n  <div ng-show="viewState.shouldShowDocumentSearchBox()"\n       class="os-control-container document-version-picker-search-container ng-cloak">\n    <search-box class="os-row search-box select-item-document-search"\n                placeholder="viewState.documentSearchPlaceholder"\n                search-query="viewState.documentSearchText"\n                with-query="viewState.documentSearchText"\n                with-criteria="true"\n                is-active="viewState.shouldShowDocumentSearchBox()"\n                excluded-fields="viewState.getDocumentSelector().getCriteriaToExcludeFromSearch()"\n                searchable-types="::(viewState.getDocumentSelector().getSearchableTypes())"\n    ></search-box>\n  </div>\n\n  \x3c!-- Insertables search box --\x3e\n  <div class="os-control-container document-version-picker-search-container"\n       ng-if="viewState.shouldShowInsertablesSearchBox(Ctrl.insertableSelector)">\n    <div class="os-control-row">\n      <os-search-box class="select-item-insertables-search os-search-box-container os-grow os-field"\n                     trim="false"\n                     search-text="viewState.insertablesSearchText"\n                     placeholder="viewState.insertablesSearchPlaceholder">\n      </os-search-box>\n    </div>\n  </div>\n\n  \x3c!-- Document list title row --\x3e\n  <div class="os-dialog-title-row os-no-shrink"\n       ng-if="viewState.shouldShowDocumentListFilterTitleBar()">\n    <os-select-item-home-btn view-state="viewState"></os-select-item-home-btn>\n    <button class="os-button os-clear document-version-picker-go-back-to-filters-list"\n            type="button"\n            ng-if="viewState.getDocumentSelector().getCanGoBackFromDocumentList()"\n            ng-click="viewState.getDocumentSelector().goBackFromDocumentList()"\n            ng-disabled="viewState.getIsReadonly()"\n            data-bs-original-title="{{ viewState.getDocumentSelector().getBackButtonTitle() }}"\n            data-bs-placement="left">\n      <os-svg icon="back-tab" class="button-icon"> </os-svg>\n    </button>\n    <div class="os-col os-grow document-version-picker-selected-filter">\n      <span class="select-item-dialog-document-name document-version-picker-current-filter">{{viewState.getDocumentSelector().getSelectedFilterTitle()}}</span>\n    </div>\n  </div>\n\n  \x3c!-- Standard content--\x3e\n  <div ng-include="\'/project/web/ts/standardContent/standardContent.html\'" ng-controller="StandardContentDialogController as ctrl" class="standard-content-container" ng-show="viewState.shouldShowStandardContent()"></div>\n\n  \x3c!-- Non-Geometric items--\x3e\n  <div ng-include="\'/project/web/ts/items/insertItemsTemplate.html\'" ng-controller="InsertItemsController as ctrl" class="insert-items-container" ng-show="viewState.shouldShowNonGeometricItems()"></div>\n\n  \x3c!-- Document filter list--\x3e\n  <div class="document-version-picker-section document-version-picker-document-filters select-item-dialog-subdialog-container"\n    ng-show="viewState.shouldShowDocumentFilterList()">\n    <osx-document-filters-component\n      [is-flat]="true"\n      display-source="documentVersionPicker"\n      [view-state]="viewState"\n      [global-tree-nodes]="globalTreeNodes"\n      (change-tree-node)="changeTreeNode($event.treeNode, $event.$event)"\n      (change-filter)="changeFilter($event.filterType)"\n      (change-filter-to-recently-referenced)="changeFilterToRecentlyReferenced($event.fullParameterId)"\n      [user-teams]="userTeams"\n      (change-team)="changeTeam($event.team)"\n      [user-labels]="userLabels"\n      (change-label)="changeLabel($event.label)"\n      [show-public-filter]="showPublicDocumentFilter">\n    </osx-document-filters-component>\n  </div>\n\n  \x3c!-- Element Libraries--\x3e\n  <div ng-include="\'/project/web/ts/elementLibrary/elementLibraryComponentTemplate.html\'"\n    ng-controller="ElementLibraryController as ctrl" ng-if="viewState.shouldShowElementLibraries()"\n    class="os-element-library-container"></div>\n\n  \x3c!-- Toolbar FS tables--\x3e\n  <div ng-include="\'/project/web/ts/selectItem/toolbarFsTableComponentTemplate.html\'"\n    ng-controller="ToolbarFsTableController as ctrl" ng-if="viewState.shouldShowToolbarFsTables()"\n    class="toolbar-fs-tables-container"></div>\n\n  \x3c!-- Document list--\x3e\n  <div class="document-version-picker-section document-version-picker-document-list select-item-dialog-subdialog-content"\n       ng-if="viewState.shouldShowDocumentsList()" when-scrolled="viewState.getDocumentSelector().documentVersionPickerSearchResult.loadNextDocuments()">\n    <div ng-show="viewState.getDocumentSelector().documentVersionPickerSearchResult.isFetchingFirstPage()" class="ns-select-item-dialog-item-empty">\n      <span>{{"Loading…" | i18next}}</span>\n    </div>\n    <div ng-if="!viewState.getDocumentSelector().documentVersionPickerSearchResult.isFetchingFirstPage()">\n      <div ng-show="viewState.getDocumentSelector().documentVersionPickerSearchResult.isEmpty()" class="ns-select-item-dialog-item-empty">\n        <span ng-if="!viewState.documentSearchText">{{"No documents found" | i18next}}</span>\n        <span ng-if="viewState.documentSearchText">{{"No results found" | i18next}}</span>\n\n      </div>\n      <picker-item-list class="select-item-tree" doc-selector="viewState.getDocumentSelector()"></picker-item-list>\n    </div>\n  </div>\n\n  \x3c!-- Version graph--\x3e\n  <div class="os-col document-version-picker-section document-version-picker-version-graph"\n       ng-if="viewState.shouldShowVersionGraph()"\n       ng-class="Ctrl.documentVersionPicker.getVersionGraphNgClasses()">\n    <div class="os-dialog-title-row os-version-graph-legend os-no-shrink">\n      <os-svg icon="workspace"></os-svg>\n      <span class="workspace-name">{{"Workspace" | i18next}}</span>\n      <os-svg icon="version"></os-svg>\n      <span class="version-name">{{"Version" | i18next}}</span>\n    </div>\n    <div class="os-dialog-title-row os-version-graph-legend os-no-shrink" ng-if="isReleaseEnabled()">\n      <os-svg icon="revision-pending"></os-svg>\n      <span class="version-name">{{"Release candidate" | i18next}}</span>\n      <os-svg icon="revision"></os-svg>\n      <span class="version-name">{{"Release" | i18next}}</span>\n    </div>\n    <div class="os-versions-container os-grow">\n      <div ng-if="doingQueries" class="os-padded-centered-holder">\n        <span >{{ "Loading versions…" | i18next}}</span>\n      </div>\n      <div ng-if="doingQueries" class="os-padded-centered-holder">\n        <div class="os-spinner-medium os-spinner-spinning"></div>\n      </div>\n      <div os-version-graph\n           class="os-version-graph"\n           ng-show="showContent"\n           ng-style="{width: svgWidth + \'px\'}">\n      </div>\n      <div ng-show="showContent" class="os-version-list os-col">\n        <div ng-repeat="workspaceOrVersion in displayedWorkspacesAndVersions"\n             class="os-row os-align-center os-version-row os-selectable-item {{viewState.getDocumentSelector().isWorkspaceOrVersionSelectable(workspaceOrVersion) ? \'os-selectable-version\' : \'os-disabled-version\'}}"\n             ng-class="{\'os-selected\': viewState.getDocumentSelector().getIsCurrentWorkspaceOrVersion(workspaceOrVersion.id)}"\n             ng-click="viewState.getDocumentSelector().selectVersion(documentId, workspaceOrVersion)"\n             ng-style="{\'padding-left\': svgWidth + \'px\'}"\n             data-bs-original-title="{{workspaceOrVersion.name}}">\n          <span class="version-name">{{workspaceOrVersion.name}}</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \x3c!-- Filter buttons --\x3e\n  <div class= "os-control-container os-wrap os-no-shrink" ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getShouldShowFilterBar() && viewState.getIsShowingInsertablesView() && !Ctrl.insertableSelector.getIsLoadingElementsOrConfigurations()">\n    <div class="os-control-row" >\n      <button ng-repeat="filter in Ctrl.insertableSelector.getCurrentInsertablesGroup().getFilterBar().filterButtons"\n              class="os-button os-clear"\n              ng-class="{\'os-right-justified\': filter.isButtonRightJustified(), \'os-active\': filter.isFilterActive}"\n              ng-click="filter.toggleFilterButton()"\n              ng-if="filter.isFilterVisible"\n              ng-disabled="filter.isFilterDisabled"\n              data-bs-original-title="{{filter.filterDisplayName}}"\n              data-bs-placement="right">\n        <div class="button-content">\n          <os-svg icon="{{filter.iconName}}" class="button-icon"></os-svg>\n        </div>\n      </button>\n    </div>\n  </div>\n\n  \x3c!-- Insertables picker --\x3e\n  <div ng-if="viewState.getIsShowingInsertablesView()" os-select-dropdown-bounds\n       class="select-item-dialog-subdialog-container">\n    <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup()" class="select-item-dialog-subdialog-content" >\n      <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getChangesSinceVersionSave() > 0" class="select-item-warning alert alert-info">\n          <span ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getChangesSinceVersionSave() === 1">\n              {{"1 change since the last version." | i18next}}\n          </span>\n          <span ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getChangesSinceVersionSave() !== 1">\n              {{"__numberOfChanges__ changes since the last version." | i18next:{numberOfChanges: Ctrl.insertableSelector.getCurrentInsertablesGroup().getChangesSinceVersionSave()} }}\n          </span>\n          <div ng-if="!Ctrl.insertableSelector.getRestrictedVersionId() && Ctrl.documentVersionPicker.getCanShowCreateVersionButton()">\n            <span ng-if="!Ctrl.insertableSelector.getCurrentInsertablesGroup().hasMultipleVersions && Ctrl.insertableSelector.getCurrentInsertablesGroup().getIsSuccessfullyLoadedAndEmpty()">\n              {{ "__displayName__ need to be inserted from versioned documents. This document has not yet been versioned." | i18next:{displayName: Ctrl.insertableSelector.getCurrentInsertablesGroup().getDisplayName()} }}\n            </span>\n            <br>\n            <span ng-if="!Ctrl.insertableSelector.getCurrentInsertablesGroup().hasPermissionToSaveVersion">\n              {{ "You do not have permission to edit this document. Ask the owner to create a version." | i18next }}\n            </span>\n            <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().hasPermissionToSaveVersion" class="select-item-prompt-save-version">\n              <a\n                ng-click="viewState.getDocumentSelector().promptForSavingVersion()">\n                {{ "Create a version in __documentName__." | i18next:{documentName: viewState.getDocumentSelector().getSelectedDocumentName()} }}\n              </a>\n            </div>\n          </div>\n      </div>\n     <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().hasLoadingErrors()" class="select-item-warning alert alert-info">\n        <span>{{Ctrl.insertableSelector.getCurrentInsertablesGroup().getLoadErrorMessage()}}</span>\n     </div>\n\n      <div class="select-item-tree">\n        \x3c!--Element level insertables--\x3e\n        <div class="select-item-parent-group"\n          ng-repeat="elementInsertableViewModel in Ctrl.insertableSelector.getCurrentInsertablesGroup().getElementInsertableViewModels()"\n          ng-if="Ctrl.insertableSelector.shouldShowElementInsertable(elementInsertableViewModel)">\n          <div class="select-item-dialog-item-row parent-item-expander-row">\n\n            \x3c!--Element level collapse/expand buttons--\x3e\n            <div ng-if="elementInsertableViewModel.getCanShowExpanderButton()"\n                class="ns-select-item-dialog-item-expand-collapse"\n                ng-click="elementInsertableViewModel.toggleExpandedState()">\n              <os-svg\n                ng-if="elementInsertableViewModel.isExpanded"\n                class="os-icon-xsmall"\n                icon="expanded">\n              </os-svg>\n              <os-svg\n                ng-if="!elementInsertableViewModel.isExpanded"\n                class="os-icon-xsmall"\n                icon="collapsed">\n              </os-svg>\n            </div>\n\n            <div class="select-item-dialog-item parent-item"\n               data-bs-original-title="{{elementInsertableViewModel.getTooltip()}}"\n               os-single-double-click="{{Ctrl.closeAfterDoubleClick}}"\n               os-click="Ctrl.insertableSelector.selectElementInsertable(elementInsertableViewModel)"\n               os-double-click="Ctrl.insertableSelector.selectElementInsertableThenClose(elementInsertableViewModel)"  ng-class="{\'os-selectable-item\': Ctrl.insertableSelector.getCanTopLevelInsertableBeSelected(elementInsertableViewModel),\n              \'select-item-disabled-item\': elementInsertableViewModel.getIsDisabled(),\n              \'select-item-readonly-item\': viewState.getIsReadOnly(),\n              \'os-selected\': elementInsertableViewModel.isReferenceSelected}">\n\n              \x3c!--Element level image/icon/thumbnail container--\x3e\n              <div ng-if="Ctrl.insertableSelector.shouldShowElementThumbnail() || elementInsertableViewModel.hasReleased()" class="select-item-dialog-thumbnail-container os-no-shrink">\n\n                \x3c!--Element level icon--\x3e\n                <osc-svg-icon\n                  ng-if="elementInsertableViewModel.getHasIconImage()"\n                  icon="{{elementInsertableViewModel.getIconImageSource()}}"\n                  class="select-item-dialog-item-icon"\n                  height="30"\n                  width="50">\n                </osc-svg-icon>\n\n                \x3c!--Element level thumbnail--\x3e\n                <img ng-if="elementIn