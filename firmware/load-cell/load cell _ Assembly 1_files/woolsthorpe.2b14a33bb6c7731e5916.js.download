div>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n\n  \x3c!-- Credit card needs attention --\x3e\n  <div class="os-billing-banner os-plan-area" ng-if="$ctrl.showCreditCardBanner && !$ctrl.isCampaignApplicable() && !$ctrl.isFree2016User()">\n    <div class="credit-card-banner-container" ng-class="{ \'error-message\': $ctrl.nextChargePastDue() || $ctrl.isCreditCardExpired(), \'warning-message\': $ctrl.isCreditCardExpiring() }">\n      <span class="credit-card-banner"><strong>{{"Your account needs attention: " | i18next}} </strong></span>\n      \x3c!-- Account warnings  --\x3e\n      <span>\n        <span ng-if="$ctrl.isCreditCardExpired()" data-bs-original-title="{{$ctrl.creditCardExpriredError}}">{{ "Credit card has expired." | i18next }}</span>\n        <span ng-if="$ctrl.nextChargePastDue()" data-bs-original-title="{{$ctrl.chargeFailedError}}">{{ "Unable to process credit card for current payment." | i18next }}</span>\n        <span ng-if="$ctrl.isCreditCardExpiring()" data-bs-original-title="{{$ctrl.creditCardAboutToExprireWarning}}">{{ "Credit card is about to expire." | i18next }}</span>\n      </span>\n      <a os-ui-sref="woolsthorpe.userAccount.payment">{{"Update account" | i18next}}</a>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n\n  \x3c!-- Pro Trial banners --\x3e\n  <div class="os-billing-banner" ng-if="!$ctrl.showCreditCardBanner && $ctrl.isActivePlanTrialPlan() && !($ctrl.isOnProDiscoveryProgram() || $ctrl.isEnterpriseUser()) && $ctrl.isOwnerAccountTrialAccount() && $ctrl.canShowProTrialBanner()">\n    <div class="os-plan-area os-grow" ng-class="{ \'error-message\' : $ctrl.isTrialAccountExpiring() || ($ctrl.isTrialAccountExpired() && !$ctrl.isAwaitingDiscoveryApproval()), \'info-message\': !$ctrl.isTrialAccountExpiring() || $ctrl.isAwaitingDiscoveryApproval() }">\n      <span class="os-row" id="pro-limits-indicator"\n        ng-if="!$ctrl.isTrialAccountExpired() && !$ctrl.isAwaitingDiscoveryApproval() && !$ctrl.isQualifiedForDiscoveryProgram() && !$ctrl.isOnProDiscoveryProgram()">\n        <span class="os-grow">\n          <span ng-i18next="[html:i18next]({remainingDays:$ctrl.getRemainingTrialPeriod(), trialPlanName:$ctrl.getPlanName(), remainingDaysText:$ctrl.getRemainingTrialPeriodText() })You have <strong>__remainingDays__ __remainingDaysText__</strong> left in your __trialPlanName__ Trial."></span>\n          <span ng-if="$ctrl.isProAccount() && !$ctrl.isTrialAccountExpiring()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})Upgrade now to continue working with your team after __trialEndDate__ or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>."> </span>\n          <span ng-if="!$ctrl.isProAccount() && !$ctrl.isTrialAccountExpiring()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})<a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>Contact us</a> to continue editing private documents after __trialEndDate__ or for more information."> </span>\n          <span ng-if="$ctrl.isTrialAccountExpiring()" ng-i18next="[html:i18next]Need more time? <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>Request a trial extension</a>."></span>\n        </span>\n        <osx-plan-upgrade class="os-pin-right try-upgrade-button"></osx-plan-upgrade>\n      </span>\n\n      <span class="os-row" id="pro-limits-indicator" ng-if="!$ctrl.isTrialAccountExpired() && $ctrl.isQualifiedForDiscoveryProgram() && !$ctrl.isProDiscoveryTrialRejected()">\n        <span class="os-grow">\n          <span ng-i18next="[html:i18next]({remainingDays:$ctrl.getRemainingTrialPeriod(), trialPlanName:$ctrl.getPlanName(), remainingDaysText:$ctrl.getRemainingTrialPeriodText()})You have <strong>__remainingDays__ __remainingDaysText__</strong> left in your __trialPlanName__ Trial."></span>\n          <span ng-if="$ctrl.isProAccount() && !$ctrl.isStandardPlanBeforeProTrial()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})Your company may qualify for up to <strong>6 months</strong> of Onshape Professional at <strong>no cost</strong> through the Onshape Discovery Program."> </span>\n          <span ng-if="$ctrl.isProAccount() && $ctrl.isStandardPlanBeforeProTrial()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})Upgrade now to continue working with your team after __trialEndDate__ or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>."> </span>\n          <span ng-if="!$ctrl.isProAccount()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})<a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>Contact us</a> to continue editing private documents after __trialEndDate__ or for more information."> </span>\n        </span>\n        <button class="btn btn-secondary" ng-if="!$ctrl.isStandardPlanBeforeProTrial()" ng-click="$ctrl.goToGetDiscoveryProgram()" data-bs-original-title=\'{{"Apply for Onshape Discovery Program" | i18next}}\'>\n          {{"Extend Trial" | i18next}}\n        </button>\n        <osx-plan-upgrade ng-if="$ctrl.isStandardPlanBeforeProTrial()" class="os-pin-right try-upgrade-button"></osx-plan-upgrade>\n      </span>\n\n      <span class="os-grow"\n          id="pro-limits-indicator"\n          ng-if="$ctrl.isTrialAccountExpired() && !$ctrl.isAwaitingDiscoveryApproval()"\n          data-bs-original-title="{{$ctrl.proTrialExpiredWarning}}"\n          data-bs-placement="bottom"\n          ng-i18next="[html:i18next] Your Professional Trial has ended and your team\'s documents are view only. Upgrade now to continue editing or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>.">\n      </span>\n\n      <span class="os-grow"\n          id="awaiting-discovery-approval-indicator"\n          ng-if="$ctrl.isAwaitingDiscoveryApproval()"\n          data-bs-original-title="{{$ctrl.awaitingDoscoveryApprovalMessage}}"\n          data-bs-placement="bottom"\n          ng-i18next="[html:i18next] Your application for Onshape Discovery Program is under review. Enjoy this free trial of Onshape Professional while you wait.&nbsp;<a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>Contact us</a>&nbsp;if you have questions or need help.">\n      </span>\n\n      <span class="os-row" id="pro-limits-indicator" ng-if="$ctrl.isProDiscoveryTrialRejected() && $ctrl.isDiscoveryPlanEnabled">\n        <span class="os-grow">\n          <span ng-i18next="[html:i18next]({remainingDays:$ctrl.getRemainingTrialPeriod(), trialPlanName:$ctrl.getPlanName(), remainingDaysText:$ctrl.getRemainingTrialPeriodText() })You have <strong>__remainingDays__ __remainingDaysText__</strong> left in your __trialPlanName__ Trial."></span>\n          <span ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})Upgrade now to continue working with your team after __trialEndDate__ or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>."> </span>\n        </span>\n        <osx-plan-upgrade class="os-pin-right try-upgrade-button"></osx-plan-upgrade>\n      </span>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n\n  \x3c!-- Free User\'s banners --\x3e\n  <div class="os-billing-banner" ng-if="$ctrl.showFreeUserBanner()">\n    <div class="os-plan-area os-row info-message" ng-if="(!$ctrl.hasBeenOnAnyTrial() || $ctrl.hasBeenOnProDiscoveryTrial()) && !$ctrl.isPaidCustomerInPast() && !$ctrl.showTryProfessionalBanner() && !$ctrl.showInactiveCompanyBanner()">\n        <span ng-i18next="[html:i18next]Your <strong>Free</strong> subscription only allows public data. Try Onshape Professional to create, edit and share private data with your team."></span>\n        <div class="try-upgrade-button"><button class="btn btn-secondary" n