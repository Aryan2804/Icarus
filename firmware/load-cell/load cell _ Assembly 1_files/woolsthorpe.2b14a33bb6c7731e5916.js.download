oat uDraftShadowMapPixelHeight;\n\nuniform mediump vec4 uSteepDraftColor;\nuniform int uShowUndercut;\nuniform mediump vec4 uUndercutColor;\nuniform mediump vec4 uWithDirectionColor;\nuniform mediump vec4 uAgainstDirectionColor;\n\n{{{constants}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\n// Returns vec4(normalized x position in [0, 1], normalized y position in [0, 1], depth of this fragment)\nDECLARE_FRAG_COLOR\n\nvec3 sampleLocation(mat4 matrix) {\n    vec4 position = matrix * vec4(vWorldPosition, 1.0);\n    vec3 positionInNdcSpace = (1.0 / position.w) * vec3(position);\n    return 0.5 * positionInNdcSpace + 0.5;\n}\n\n\nfloat getCenterUndercutColorWeightSteep(float normalDotDraftDirection) {\n// Apply a larger sampling radius on steep fragments, since there tend to be more areas on them\n#define FILTER_RADIUS 3.0\n// Since there are more errors on such fragments, we have a fairly large sample bias factor to increase the number\n// of samples that need to be considered undercut before shading them as such\n#define SAMPLE_BIAS_FACTOR 0.75\n{{{undercutWeightFunction}}}\n}\n\nfloat getCenterUndercutColorWeight(float normalDotDraftDirection) {\n#undef FILTER_RADIUS\n#undef SAMPLE_BIAS_FACTOR\n// We use a smaller radius for oblique fragments in order to increase rendering efficiency\n#define FILTER_RADIUS 1.0\n// We can use also use a lower sample bias threshold\n#define SAMPLE_BIAS_FACTOR 0.5\n{{{undercutWeightFunction}}}\n}\n\n// If the fragment is steeper than this value relative to the pull direction, than we will take more samples to\n// apply a large filter around the fragment location.  This is needed because there could be a large amount of\n// variance between samples that are orthogonal to the cut direction.  (See BEL-75539, BEL-76191, for example)\n// 0.0871557 = cos(85 degrees)\n#define STEEP_UNDERCUT_THRESHOLD  0.0871557\n\nfloat getUndercutColorWeight(vec3 normal) {\n  float normalDotDraftDirection = abs(dot(uD