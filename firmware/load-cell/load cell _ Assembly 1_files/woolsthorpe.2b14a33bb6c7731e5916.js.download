   {{ "Checking workspace for out of date tabs…" | i18next }}\n      </p>\n      <p ng-show="ctrl.updatingInProgress">\n        {{ "Updating drawings…" | i18next }}\n      </p>\n      <p ng-show="ctrl.hasOutOfDateElements && ctrl.isDoneWithOutOfDateCheck && !ctrl.updatingInProgress" class="alert alert-warning version-or-workspace-dialog-out-of-date-element-warning">\n        <button class="os-button" type="button" ng-show="ctrl.hasOutOfDateElements && !ctrl.microversionId"\n          ng-disabled="ctrl.updatingInProgress" data-bs-original-title="{{\'Update drawings.\' | i18next}}"\n          ng-click="ctrl.updateOutOfDateDrawings()">\n          <os-svg icon="drawing-update"></os-svg>\n        </button>\n        {{ "These drawings should be updated before creating a version" | i18next }}:\n        <span ng-repeat="element in ctrl.outOfDateElements">\n          <a ng-if="!ctrl.microversionId" href="/documents/{{ctrl.documentId}}/w/{{ctrl.workspaceId}}/e/{{element.id}}" target="_blank">{{element.name}}{{$last ? \'\' : \', \'}} </a>\n          <a ng-if="ctrl.microversionId" href="/documents/{{ctrl.documentId}}/w/{{ctrl.workspaceId}}/m/{{ctrl.microversionId}}/e/{{element.id}}" target="_blank">{{element.name}}{{$last ? \'\' : \', \'}} </a>\n        </span>\n      </p>\n    </div>\n  </div>\n  <div ng-if="ctrl.shouldShowPublishUI()" class="publish-checklist-container">\n    <label class="checkbox publish-custom-features-label">\n      <input class="publish-custom-features-checkbox"\n             ng-disabled="ctrl.isCreatingVersionOrWorkspace"\n             type="checkbox"\n             ng-model="ctrl.publishCustomFeatures"/>\n      {{ "Publish custom features and tables" | i18next }}\n    </label>\n    <span class="publish-info-text-inline" ng-bind-html="ctrl.getPublishInfoText()"></span>\n    <div class="publish-fs-help-link">\n      <os-vue-help-link-component v-props="{helpContextKey: \'publish_fs\'}"></os-vue-help-link-component>\n    </div>\n    <publish-custom-feature