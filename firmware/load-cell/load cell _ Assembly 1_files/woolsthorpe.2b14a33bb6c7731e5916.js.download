()"></select>\n          </div>\n          <br /> <label style="margin-left: 340px;" for="name">Categories:</label>\n          <div style="display: block;">\n            <input style="margin-left: 120px;" type="radio"\n              ng-model="$ctrl.selectionData.selectedLevelIndex"\n              ng-value="2"> <select\n              style="padding: 0 0 0 7px; margin-left: 200px; width: 230px;"\n              id="categories"\n              ng-disabled="$ctrl.isContentLoading || $ctrl.categories.length === 0 || $ctrl.selectionData.selectedLevelIndex < 2"\n              ng-model="$ctrl.selectionData.selectedCategory"\n              ng-options="theCategory for theCategory in $ctrl.categories"\n              ng-change="$ctrl.onCategoryChange()"></select>\n          </div>\n          <br /> <label style="margin-left: 340px;" for="name">Types:</label>\n          <div style="display: block;">\n            <input style="margin-left: 120px;" type="radio"\n              ng-model="$ctrl.selectionData.selectedLevelIndex"\n              ng-value="3"> <select\n              style="padding: 0 0 0 7px; margin-left: 200px; width: 230px;"\n              id="types"\n              ng-disabled="$ctrl.isContentLoading || $ctrl.types.length === 0 || $ctrl.selectionData.selectedLevelIndex < 3"\n              ng-model="$ctrl.selectionData.selectedTypes"\n              ng-options="theTypes for theTypes in $ctrl.types"\n              ng-change="$ctrl.onTypesChange()"></select>\n          </div>\n          <br /> <label style="margin-left: 340px;" for="name">Type:</label>\n          <div style="display: block;">\n            <input style="margin-left: 120px;" type="radio"\n              ng-model="$ctrl.selectionData.selectedLevelIndex"\n              ng-value="4"> <select\n              style="padding: 0 0 0 7px; margin-left: 200px; width: 230px;"\n              id="type"\n              ng-disabled="$ctrl.isContentLoading || $ctrl.type.length === 0 || $ctrl.selectionData.selectedLevelIndex < 4"