     <h4 class="os-user-preference-inline-heading">{{ "Workflows" | i18next }}</h4>\n          <div class="os-user-preference-info popover-container">\n          <span class="os-question-mark"\n                popover-trigger="\'mouseenter\'"\n                popover-append-to-body="true"\n                uib-popover="{{ \'Choose whether to release your designs by manually creating versions and updating revision properties, or by using Onshape\\\'s managed workflows to create and approve Release candidates\' | i18next }}"\n                popover-placement="right">\n          </span>\n          </div>\n        </div>\n        <div class="user-settings">\n          <div class="workflows-enabled-container" ng-if="$ctrl.initialLoadComplete">\n            <label>\n              <input type="checkbox"\n                     id="workflow-enabled-checkbox"\n                     ng-model="$ctrl.workflowsEnabled"\n                     ng-disabled="!$ctrl.isAdmin"\n                     ng-change="$ctrl.onWorkflowsEnabledStateChanged()"\n              >\n              <span class="os-radio-or-checkbox-text">{{ "Enable managed workflows" | i18next }}</span>\n            </label>\n          </div>\n          <osx-workflow-manager-types ng-if="$ctrl.initialLoadComplete && !$ctrl.isUsingManualWorkflow()"\n                                  [initial-workflow-ids]="$ctrl.initialWorkflowIds"\n                                  [workflow-type-options]="$ctrl.workflowTypeOptions"\n                                  (on-workflows-changed)="$ctrl.onActiveWorkflowsChanged($event)"\n                                  (on-workflow-manager-loaded)="$ctrl.onPublishedWorkflowsLoaded($event)"\n                                  (on-selected-workflow-type-changed)="$ctrl.onWorkflowTypeChanged($event)"\n                                  (on-workflow-unpublished)="$ctrl.onWorkflowUnpublished($event)"\n                                  [is-enterprise]="$ctrl.isEnterprise"\n                                  [revision-sync-enabled]="$ctrl.revisionSyncEnabled"\n          ></osx-workflow-manager-types>\n        </div>\n      </fieldset>\n\n      <div ng-if="!$ctrl.isUsingManualWorkflow()">\n        <fieldset ng-disabled="!$ctrl.isAdmin">\n          \x3c!-- Revisions and part numbers --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Revisions and part numbers" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <revision-scheme-picker ng-if="!$ctrl.isUsingManualWorkflow()"\n                                    company-id="$ctrl.companyId"\n                                    original-revision-scheme-id="$ctrl.companyPolicies.revisionSchemeId"\n                                    editable="$ctrl.isAdmin"\n            ></revision-scheme-picker>\n            <div class="os-form-container">\n              <div>\n                <label>\n                  <span>{{ "Unreleased revision suffix:" | i18next }}</span>\n                  <input type="text" name="revisionSuffix" ng-model="$ctrl.company.releaseProcess.revisionSuffix" ng-trim="false" class="form-control">\n                </label>\n              </div>\n            </div>\n            <div class="os-form-container">\n              <properties-table-template-list\n                company-id="$ctrl.companyId"\n                template-type="$ctrl.templateType"\n              ></properties-table-template-list>\n            </div>\n            <div>\n              <a ng-href="{{$ctrl.numberingSchemeSettingsLink}}">{{ \'Click here to go to release management part number generation settings\' | i18next }}</a>\n            </div>\n          </div>\n\n          \x3c!-- Access --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Access" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.onlyAdminsCanEditPropertiesOfReleasedObjects" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Only administrators can edit the properties of released objects" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.onlyAdminsCanMarkObjectsAsNotRevisionManaged" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Only administrators can mark objects as not revision-managed" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.onlyAdminsCanDeleteDocumentsContainingReleasedObjects" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Only administrators can delete documents containing released objects" | i18next }}</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \x3c!-- Actions --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Actions" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.treatMetadataChangesAsChanges"\n                           ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require a new revision when an item\'s properties have changed" | i18next }}</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </div>\n        </fieldset>\n\n        \x3c!-- Watermarks --\x3e\n        <fieldset ng-disabled="!$ctrl.isAdmin">\n          <div class="user-profile-section-header">\n            <h4>{{ "Watermarks" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.actionShowDrawingsWatermark"\n                           ng-disabled="$ctrl.isUsingManualWorkflow()" ng-change="$ctrl.onToggleShowDrawingsWatermark()">\n                    <span class="os-radio-or-checkbox-text">{{ "Show watermark for drawings" | i18next }}</span>\n                  </label>\n                </div>\n                <div ng-if="!$ctrl.isUsingManualWorkflow() && $ctrl.company.releaseProcess.actionShowDrawingsWatermark">\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.hideWatermarkForNotRevManaged">\n                    <span class="os-radio-or-checkbox-text">{{ "Hide watermark for drawings that are not revision managed" | i18next }}</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </div>\n        </fieldset>\n        <div class="os-form-group-indent">\n          <button\n            type="button"\n            class="btn btn-primary"\n            ng-disabled="!$ctrl.company.releaseProcess.actionShowDrawingsWatermark"\n            ng-click="$ctrl.editWatermarks()"\n            id="btn-edit-watermarks"\n          >{{ $ctrl.getWatermaksButtonText() }}\n          </button>\n        </div>\n\n        <fieldset ng-disabled="!$ctrl.isAdmin">\n          \x3c!-- Dependencies --\x3e\n          \x3c!-- TODO - Raj enable after we can support it BEL-83540 or BEL-85924 --\x3e\n          <div class="user-profile-section-header" ng-hide="true">\n            <h4>{{ "Dependencies" | i18next }}</h4>\n          </div>\n          <div class="user-settings" ng-hide="true">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.requirePartsAndSubassembliesReleaseWithAssembly" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require the release of parts and sub-assemblies in an assembly when releasing the assembly" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.requirePartsAndSubassembliesReleaseWithDrawing" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require the release of parts and assemblies in a drawing when releasing the drawing" | i18next }}</span>\n                  </label>\n                </div>\n                \x3c!-- TODO - Raj enable after we can support it BEL-83540 --\x3e\n                <div ng-hide="true">\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.requireBasePartReleaseWithDerivedPart" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require the release of the base part when releasing a derived part" | i18next }}</span>\n                  </label>\n                </div>\n                \x3c!-- TODO - Raj enable after we can support it BEL-85924 --\x3e\n                <div ng-hide="true">\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.requireImageReleaseWithDrawing" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require the release of images in a Drawing when releasing the drawing" | i18next }}</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \x3c!-- Release conditions --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Release conditions" | i18next }} <small style="margin-left: 15px; display: inline-block; color: var(--os-text-secondary)">{{ "Selected conditions will prevent a Release from being created" | i18next }}</small></h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnFeatureListErrorsDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Prevent if a Part Studio feature list contains errors" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnRollbackBarNotAtEndDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Prevent if a Part Studio feature list is not rolled to the end" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnAssemblyTreeErrorsDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Prevent if an Assembly instance list contains errors" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnAssemblyRefsOutOfDateDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Prevent if an Assembly has pending reference updates" | i18next }}</span>\n                  </label>\n                </div>\n                \x3c!-- TODO - Raj enable after we can support it BEL-83539 --\x3e\n                <div ng-hide="true">\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnPendingContextEditsDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "When releasing an Assembly if a pending context edit exists" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnPendingDrawingUpdateDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Prevent if a Drawing has a pending update" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnPartNumberPendingDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Prevent if a part number is included in another pending Release candidate" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnPendingTaskDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Prevent if an item has a pending task" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnObsoleteRefsDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Prevent if an item references obsolete revisions" | i18next }}</span>\n                  </label>\n                </div>\n                \x3c!-- TODO - Raj enable after we can support it BEL-83036 --\x3e\n                <div ng-hide="true">\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnPendingDanglingDrawingObjectsDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "When releasing a Drawing if it has dangling dimensions, annotations or views" | i18next }}</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \x3c!-- Create Release candidate dialog --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Create Release candidate dialog" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.approverRequiredDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()" ng-change="$ctrl.onToggleRequireApprover()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require an approver in the Release dialog" | i18next }}</span>\n                  </label>\n                  <div class="os-user-preference-info popover-container" ng-if="$ctrl.isEnterprise">\n                  <span class="os-question-mark"\n                        popover-trigger="\'mouseenter\'"\n                        popover-append-to-body="true"\n                        uib-popover="{{ \'This option applies only when using the Onshape default release and obsoletion workflows.\' | i18next }}"\n                        popover-placement="right">\n                  </span>\n                  </div>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.requirePeerReview" ng-disabled="$ctrl.isUsingManualWorkflow() || !$ctrl.company.releaseProcess.approverRequiredDuringRelease">\n                    <span class="os-radio-or-checkbox-text">{{ "Do not allow creator as approver" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.requireAllApprovers" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require approval from all approvers" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.noteRequiredDuringRelease" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require a note in the Release dialog" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.allowReleaseItemsFromOtherDocuments" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ \'Allow adding items from other documents\' | i18next }}</span>\n                  </label>\n                </div>\n                <div ng-if="!$ctrl.isEnterprise">\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.approverRestriction.enabled" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text" ng-if="!$ctrl.company.approverRestriction.enabled">{{ "Restrict approvers to specific users or teams" | i18next }}</span>\n                    <span class="os-radio-or-checkbox-text" ng-if="$ctrl.company.approverRestriction.enabled">{{ "Restrict approvers to these users or teams:" | i18next }}</span>\n                  </label>\n                  <div class="inline-suggestion-box" ng-form="allowedApproversForm" ng-if="$ctrl.company.approverRestriction.enabled">\n                    <os-suggestions\n                      class="add-email"\n                      wrapper-class="form-control"\n                      ng-model="$ctrl.company.approverRestriction.allowedApprovers"\n                      ng-required="true"\n                      ng-disabled="!$ctrl.isAdmin"\n                      max-results="8"\n                      get-suggestions="$ctrl.findFriends(query, company.id)"\n                      os-input-tokens\n                      on-suggestion-selected="TokenController.addToken(suggestion)"\n                      placeholder="{{ \'Search users or teams\' | i18next }}">\n                    </os-suggestions>\n                    <div ng-messages="companyReleaseSettingsForm.allowedApproversForm.$error">\n                      <div ng-message="required" class="required-error-block text-danger">{{ "Required field must not be empty." | i18next }}</div>\n                    </div>\n                  </div>\n                </div>\n\n                <div class="release-property-name-override-enabled">\n                  <label>\n                    <input name="releasePropertyNameOverrideEnabled" type="checkbox" ng-model="$ctrl.company.releaseProcess.releasePropertyNameOverrideEnabled">\n                    <span class="os-radio-or-checkbox-text">{{ "Enter display names for Release & Obsoletion management properties" | i18next }}</span>\n                  </label>\n                </div>\n                <div class="os-form-container" ng-if="$ctrl.company.releaseProcess.releasePropertyNameOverrideEnabled">\n                  <div class="os-row">\n                    <div class="release-property-override-field">\n                      <label>\n                        <span>{{ "Release name:" | i18next }}</span>\n                        <input\n                          name="releaseNameOverride"\n                          type="text"\n                          ng-model="$ctrl.company.releaseProcess.releaseNameOverride"\n                          ng-trim="false" class="form-control"\n                          class="form-control"\n                          placeholder="{{\'Release name\' | i18next}}"\n                          ng-maxlength="{{$ctrl.DISPLAY_NAME_MAX_LENGTH}}"\n                          ng-class="{\'has-error\': companyReleaseSettingsForm.releaseNameOverride.$invalid}"\n                        >\n                      </label>\n                      <p\n                        class="text-danger"\n                        ng-show="companyReleaseSettingsForm.releaseNameOverride.$error.maxlength">\n                        {{ \'Length must not exceed __maxLength__ characters.\' | i18next:{maxLength: $ctrl.DISPLAY_NAME_MAX_LENGTH} }}\n                      </p>\n                    </div>\n                    <div class="release-property-override-field">\n                      <label>\n                        <span>{{ "Release notes:" | i18next }}</span>\n                        <input\n                          name="releaseDescriptionOverride"\n                          type="text"\n                          ng-model="$ctrl.company.releaseProcess.releaseDescriptionOverride"\n                          ng-trim="fals