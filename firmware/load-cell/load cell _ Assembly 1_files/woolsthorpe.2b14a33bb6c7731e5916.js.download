 | i18next }}</p>\n              <p class="compare-with-base-link">\n                <a class="btn-link" ng-click="ctrl.compareWithBase(ctrl.targetWorkspace)">\n                  {{ \'Compare with base\' | i18next }}<os-svg icon="arrow-up-right" class="new-tab-icon"></os-svg>\n                </a>\n              </p>\n            </div>\n          </div>\n          <div ng-if="overallStrategy === ctrl.MergeStrategyEnum.MERGE" class="overall-preview-strategy overall-preview-strategy-merge">\n            <div class="overall-preview-strategy-icon">\n              <os-svg icon="{{ ctrl.getMergeStrategyIcon(overallStrategy) }}" class="icon"></os-svg>\n            </div>\n            <div class="overall-preview-strategy-text">\n              <div class="overall-preview-strategy-title">{{ \'Merge changes\' | i18next }}</div>\n              <div ng-if="ctrl.elementsWithChanges.length !== 1" class="overall-change-count overall-merge-changes-count">{{ \'Combine all changes to __count__ tabs\' | i18next:{ count: ctrl.elementsWithChanges.length } }}</div>\n              <div ng-if="ctrl.elementsWithChanges.length === 1" class="overall-change-count overall-merge-changes-count">{{ \'Combine all changes to 1 tab\' | i18next }}</div>\n            </div>\n          </div>\n          <div ng-if="overallStrategy === ctrl.MergeStrategyEnum.REPLACE" class="overall-preview-strategy overall-preview-strategy-replace">\n            <div class="overall-preview-strategy-icon">\n              <os-svg icon="{{ ctrl.getMergeStrategyIcon(overallStrategy, ctrl.IconSizeEnum.LARGE, ctrl.targetTabChangesCount > 0) }}" class="icon"></os-svg>\n            </div>\n            <div class="overall-preview-strategy-text">\n              <div ng-bind-html="ctrl.getOverallReplaceTitleHtml()" class="overall-preview-strategy-title"></div>\n              <div ng-if="ctrl.sourceTabChangesCount !== 1" class="overall-change-count">{{ \'__count__ tabs have changes\' | i18next:{ count: ctrl.sourceTabChangesCount } }}</div>\n              <div ng-if="ctrl.sourceTabChangesCount === 1" class="overall-change-count">{{ \'1 tab has changes\' | i18next }}</div>\n              <div class="compare-with-base-link">\n                <a class="btn-link" ng-click="ctrl.compareWithBase(ctrl.sourceWorkspaceOrVersion)">\n                  {{ \'Compare with base\' | i18next }}<os-svg icon="arrow-up-right" class="new-tab-icon"></os-svg>\n                </a>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <h4 class="modal-title">{{ \'Tabs\' | i18next }}</h4>\n    <div class="element-preview-strategy-table" os-select-dropdown-bounds prevent-scrolling="true">\n      <div class="table-head">\n        <div class="table-row">\n          <div ng-if="ctrl.elementsWithChanges.length !== 1" class="tab-name">{{ \'__count__ tabs have changes\' | i18next:{ count: ctrl.elementsWithChanges.length} }}</div>\n          <div ng-if="ctrl.elementsWithChanges.length === 1" class="tab-name">{{ \'1 tab has changes\' | i18next }}</div>\n          <div ng-repeat="branch in ctrl.branchOrder" class="tab-changes selective-merge-tab-changes" ng-bind-html="ctrl.getBranchChangesTitleHtml(branch)"></div>\n          <div class="tab-strategy selective-merge-tab-strategy">{{ \'Tab merge strategy\' | i18next }}</div>\n        </div>\n      </div>\n      <div class="table-body">\n        <div ng-repeat="elementMergeConfig in ctrl.elementsWithChanges" class="table-row table-changes table-row-{{ $index }}" ng-class="{ \'row-even\': $even }">\n          <div class="tab-name">\n            <os-svg ng-if="elementMergeConfig.useSvgElementIcon()" icon="{{ elementMergeConfig.getElementIconSrc() }}" alt="{{ elementMergeConfig.getElementIconAlt() }}" class="icon"></os-svg>\n            <img ng-if="!elementMergeConfig.useSvgElementIcon()" ng-src="{{ elementMergeConfig.getElementIconSrc() }}" alt="{{ elementMergeConfig.getElementIconAlt() }}" class="icon">\n            <span class="tab-name-{{ $index }}" data-bs-original-title="{{ elementMergeConfig.elementTooltip }}">{{ elementMergeConfig.elementName }}</span>\n            <os-svg ng-if="elementMergeConfig.showInfoIcon"\n                    icon="performance-info"\n                    class="icon"\n                    data-bs-original-title="{{ elementMergeConfig.infoIconTooltipHtml }}"\n                    data-bs-html="true"\n                    data-bs-placement="top">\n            </os-svg>\n            <os-svg ng-if="elementMergeConfig.showErrorIcon"\n                    icon="error"\n                    class="icon"\n                    data-bs-original-title="{{ elementMergeConfig.errorIconTooltipHtml }}"\n                    data-bs-html="true"\n                    data-bs-placement="top">\n            </os-svg>\n            <a ng-if="elementMergeConfig.showOpenIcon" href="{{ ctrl.getSourceElementUrl(elementMergeConfig.getElementId()) }}" target="_blank">\n              <os-svg icon="open-icon"\n                      class="icon"\n                      data-bs-original-title="{{ elementMergeConfig.openIconTooltipText }}"\n                      data-bs-placement="top">\n              </os-svg>\n            </a>\n          </div>\n          <div ng-repeat="branch in ctrl.branchOrder"\n               class="tab-changes selective-merge-tab-changes"\n               ng-class="{ \'tab-target\': branch === ctrl.BranchEnum.TARGET, \'tab-source\': branch === ctrl.BranchEnum.SOURCE }">\n            <os-svg icon="{{ elementMergeConfig.getBranchStatusIcon(branch) }}" class="icon"></os-svg>\n            <span ng-bind="elementMergeConfig.getBranchStatusString(branch)"\n                  data-bs-original-title="{{ elementMergeConfig.getBranchStatusTooltip(branch) }}"\n                  ng-class="{ \'no-changes\': elementMergeConfig.getBranchStatus(branch) === ctrl.ElementBranchStatusEnum.NO_CHANGES }"></span>\n            <os-svg ng-if="elementMergeConfig.shouldShowDiscardedTabWarning(branch)"\n                    icon="error"\n                    class="icon"\n                    data-bs-original-title="{{ \'tooltips:::Tab will not exist in __targetname__ after merge\' | i18next:{ targetname: ctrl.escapedTargetName } }}"\n                    data-bs-placement="top"></os-svg>\n          </div>\n          <div class="tab-strategy selective-merge-tab-strategy">\n            <os-select ng-model="elementMergeConfig.strategy"\n                       ng-change="elementMergeConfig.onStrategyChanged()"\n                       ng-disabled="ctrl.protectedWorkspace"\n                       class="element-strategy-select element-strategy-container-{{ $index }}"\n                       backspace-reset="false"\n                       enter-activate="true">\n              <os-select-match>\n                <os-svg icon="{{ elementMergeConfig.getStrategyIcon(elementMergeConfig.strategy) }}" class="icon"></os-svg>\n                <span ng-bind-html="elementMergeConfig.getStrategyString()"></span>\n                <div ng-if="elementMergeConfig.isCustomized" class="element-strategy-triangle"></div>\n              </os-select-match>\n              <os-select-choices repeat="option.value.value as (key, option) in elementMergeConfig.dropdownOptions | osSelectParameterSearch:$select.search:true">\n                <os-svg icon="{{ elementMergeConfig.getStrategyIcon(option.value.value) }}" class="icon"></os-svg>\n                <span ng-bind-html="option.value.name | highlight:ctrl.escapeSearchString($select.search)" class="element-strategy-dropdown-text"></span>\n              </os-select-choices>\n            </os-select>\n          </div>\n        </div>\n        <div class="table-row unchanged-tabs-head">\n          <div class="unchanged-tabs-head-row" ng-class="{ \'unchanged-tabs-collapsible-head-row\': ctrl.elementsWithoutChanges.length !== 0 }" ng-click="ctrl.toggleNoChangesSection()">\n            <div ng-if="ctrl.elementsWithoutChanges.length !== 0" class="unchanged-tabs-toggle">\n              <os-svg icon="dropdown-arrow" class="unchanged-tabs-toggle-icon" ng-class="{ \'unchanged-tabs-toggle-icon-collapsed\' : ctrl.noChangesSectionCollapsed }"></os-svg>\n            </div>\n            <div ng-if="ctrl.elementsWithoutChanges.length === 0" class="unchanged-tabs-filler"></div>\n            <div ng-if="ctrl.elementsWithoutChanges.length !== 1" class="unchanged-tabs-title">{{ \'__count__ tabs have no changes\' | i18next:{ count: ctrl.elementsWithoutChanges.length} }}</div>\n            <div ng-if="ctrl.elementsWithoutChanges.length === 1" class="unchanged-tabs-title">{{ \'1 tab has no changes\' | i18next }}</div>\n          </div>\n        </div>\n        <div ng-show="!ctrl.noChangesSectionCollapsed" ng-repeat="elementMergeConfig in ctrl.elementsWithoutChanges" class="table-row unchanged-tab-row" ng-class="{ \'row-even\' : $even }">\n          <div class="tab-name">\n            <os-svg ng-if="elementMergeConfig.useSvgElementIcon()" icon="{{ elementMergeConfig.getElementIconSrc() }}" alt="{{ elementMergeConfig.getElementIconAlt() }}" class="icon"></os-svg>\n            <img ng-if="!elementMergeConfig.useSvgElementIcon()" ng-src="{{ elementMergeConfig.getElementIconSrc() }}" alt="{{ elementMergeConfig.getElementIconAlt() }}" class="icon">\n            <span class="tab-name-{{ $index }}" data-bs-original-title="{{ elementMergeConfig.elementTooltip }}">{{ elementMergeConfig.elementName }}</span>\n            <os-svg ng-if="elementMergeConfig.showInfoIcon"\n                    icon="performance-info"\n                    class="icon"\n                    data-bs-original-title="{{ elementMergeConfig.infoIconTooltipHtml }}"\n                    data-bs-html="true"\n                    data-bs-placement="top">\n            </os-svg>\n            <os-svg ng-if="elementMergeConfig.showErrorIcon"\n                    icon="error"\n                    class="icon"\n                    data-bs-original-title="{{ elementMergeConfig.errorIconTooltipHtml }}"\n                    data-bs-html="true"\n                    data-bs-placement="top">\n            </os-svg>\n            <a ng-if="elementMergeConfig.showOpenIcon" href="{{ ctrl.getSourceElementUrl(elementMergeConfig.getElementId()) }}" target="_blank">\n              <os-svg icon="open-icon"\n                      class="icon"\n                      data-bs-original-title="{{ elementMergeConfig.openIconTooltipText }}"\n                      data-bs-placement="top">\n              </os-svg>\n            </a>\n          </div>\n          \x3c!-- These empty tags exist to keep column padding consistent between the changed tabs and unchanged tabs sections --\x3e\n          <div ng-repeat="branch in ctrl.branchOrder"\n               class="tab-changes selective-merge-tab-changes"\n               ng-class="{ \'tab-target\': branch === ctrl.BranchEnum.TARGET, \'tab-source\': branch === ctrl.BranchEnum.SOURCE }">\n            <div class="icon"></div>\n            <span class="no-changes"></span>\n          </div>\n          <div class="tab-strategy selective-merge-tab-strategy"></div>\n        </div>\n      </div>\n    </div>\n    <div ng-if="ctrl.showWarningAlert" class="alert alert-warning">\n      <button ng-show="ctrl.showLibraryVersionUpgradeAction" class="os-button" type="button" ng-click="ctrl.onUpgrade()" data-bs-original-title="{{ ctrl.getLibraryVersionUpgradeActionText() }}">\n        <os-svg icon="update-now"></os-svg>\n      </button>\n      <os-svg ng-show="ctrl.showPendingUpgradeInfo" icon="update-later" class="icon" data-bs-original-title="{{ ctrl.getPendingUpgradeTooltipHtml() }}"></os-svg>\n      <span ng-bind-html="ctrl.alertMessageHtml" id="merge-alert-message"></span>\n    </div>\n    <div ng-if="ctrl.showInfoAlert" class="alert alert-info" ng-bind-html="ctrl.alertMessageHtml"></div>\n  </div>\n  <div class="modal-footer">\n    <a ng-href="{{ ctrl.helpUrl }}" target="help" class="help-button">\n      <os-svg icon="help-button" class="icon"></os-svg>\n    </a>\n    <div class="dialog-buttons">\n      <button class="btn btn-primary submit-button"\n              type="submit"\n              data-bs-original-title="{{ \'tooltips:::Merge into __targetname__\' | i18next:{ targetname: ctrl.escapedTargetName } }}"\n              data-bs-placement="top"\n              ng-disabled="!ctrl.isMergeAllowed">\n        {{ \'Merge\' | i18next }}\n      </button>\n      <button class="btn btn-secondary button-cancel" type="button" ng-click="ctrl.cancelDialog()">{{ \'Cancel\' | i18next }}</button>\n    </div>\n  </div>\n</form>\n')}]),e.exports=i},86414:function(e,t,n){var i="/project/web/woolsthorpe/app/partials/selectiveRestoreDialog.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'\x3c!-- Header of the dialog (title and cancel button) --\x3e\n<div class="modal-header">\n  <h4 class="modal-title selective-preview-dialog-title" ng-bind-html="ctrl.getTitleHtml()"></h4>\n  <button type="button" class="btn-close" ng-click="ctrl.cancelDialog()" aria-hidden="true"></button>\n</div>\n\n\x3c!-- Body of the dialog (either spinner while loading preview data or the form is displayed) --\x3e\n<os-spinner ng-if="ctrl.loadingSpinner.show" spinner="ctrl.loadingSpinner"></os-spinner>\n<form ng-if="!ctrl.loadingSpinner.show" ng-submit="ctrl.doSubmit()">\n  <div class="modal-body">\n    <div class="overall-preview-strategy-picker-container">\n      <h4 class="modal-title">\n        {{ \'Overall restore strategy\' | i18next }}\n      </h4>\n\n      \x3c!-- Overall restore strategy section --\x3e\n      <div class="overall-preview-strategy-picker">\n        <div ng-repeat="overallStrategy in ctrl.restoreStrategies"\n             ng-click="ctrl.setOverallRestoreStrategy(overallStrategy, true)"\n             class="overall-preview-strategy-container"\n             ng-class="{ \'active-overall-preview-strategy-container\': ctrl.overallRestoreStrategy === overallStrategy }">\n          <div ng-if="overallStrategy === ctrl.RestoreStrategyEnum.KEEP" class="overall-preview-strategy overall-preview-strategy-keep">\n            <div class="overall-preview-strategy-icon">\n              <os-svg icon="{{ ctrl.getRestoreStrategyIcon(overallStrategy) }}" class="icon"></os-svg>\n            </div>\n            <div class="overall-preview-strategy-text">\n              <div ng-bind-html="ctrl.getOverallKeepTitleHtml()" class="overall-preview-strategy-title"></div>\n              <div data-automation="overall-change-count"><i>{{ \'No changes\' | i18next }}</i></div>\n            </div>\n          </div>\n          <div ng-if="overallStrategy === ctrl.RestoreStrategyEnum.REPLACE" class="overall-preview-strategy overall-preview-strategy-replace">\n            <div class="overall-preview-strategy-icon">\n              <os-svg icon="{{ ctrl.getRestoreStrategyIcon(overallStrategy) }}" class="icon"></os-svg>\n            </div>\n            <div class="overall-preview-strategy-text">\n              <div ng-bind-html="ctrl.getOverallReplaceTitleHtml()" class="overall-preview-strategy-title"></div>\n              <div data-automation="overall-change-count" ng-if="ctrl.targetTabChangesCount === 0"><i>{{ ctrl.getOverallChangeCountString() }}</i></div>\n              <p ng-if="ctrl.targetTabChangesCount >= 1" class="compare-with-base-link">\n                <a class="btn-link" ng-click="ctrl.compareTargetAndSource()">\n                  <span ng-if="ctrl.targetTabChangesCount > 1" data-automation="overall-change-count">{{ ctrl.getOverallChangeCountString() }}</span>\n                  <span ng-if="ctrl.targetTabChangesCount === 1" data-automation="overall-change-count">{{ ctrl.getOverallChangeCountString() }}</span>\n                  <os-svg icon="arrow-up-right" class="new-tab-icon"></os-svg>\n                </a>\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \x3c!-- Customized restore strategy section --\x3e\n    <h4 class="modal-title">{{ \'Tabs\' | i18next }}</h4>\n    <div class="element-preview-strategy-table" os-select-dropdown-bounds prevent-scrolling="true">\n      \x3c!-- Headers of the table --\x3e\n      <div class="table-head">\n        <div class="table-row">\n          <div ng-if="ctrl.elementsWithChanges.length !== 1" class="tab-name">{{ \'__count__ tabs have changes\' | i18next:{ count: ctrl.elementsWithChanges.length} }}</div>\n          <div ng-if="ctrl.elementsWithChanges.length === 1" class="tab-name">{{ \'1 tab has changes\' | i18next }}</div>\n          <div class="tab-changes selective-restore-tab-changes" ng-bind-html="ctrl.getChangesTitleHtml()"></div>\n          <div class="tab-strategy selective-restore-tab-strategy">{{ \'Tab restore strategy\' | i18next }}</div>\n        </div>\n      </div>\n\n      \x3c!-- Body of the table --\x3e\n      <div class="table-body">\n        \x3c!-- Element with changes section --\x3e\n        <div ng-repeat="elementRestoreConfig in ctrl.elementsWithChanges" class="table-row table-changes table-row-{{ $index }}" ng-class="{ \'row-even\': $even }">\n          \x3c!-- Content for tab name column --\x3e\n          <div class="tab-name">\n            <os-svg ng-if="elementRestoreConfig.useSvgElementIcon()" icon="{{ elementRestoreConfig.getElementIconSrc() }}" alt="{{ elementRestoreConfig.getElementIconAlt() }}" class="icon"></os-svg>\n            <img ng-if="!elementRestoreConfig.useSvgElementIcon()" ng-src="{{ elementRestoreConfig.getElementIconSrc() }}" alt="{{ elementRestoreConfig.getElementIconAlt() }}" class="icon">\n            <span class="tab-name-{{ $index }}" data-bs-original-title="{{ elementRestoreConfig.elementTooltip }}">{{ elementRestoreConfig.elementName }}</span>\n          </div>\n\n          \x3c!-- Content for tab changes column --\x3e\n          <div class="tab-changes selective-restore-tab-changes" ng-class="{ \'tab-target\': true }">\n            <os-svg icon="{{ elementRestoreConfig.getTargetStatusIcon() }}" class="icon"></os-svg>\n            <span ng-bind="elementRestoreConfig.getTargetStatusString()"\n                  ng-class="{ \'no-changes\': elementRestoreConfig.getTargetStatus() === ctrl.ElementBranchStatusEnum.NO_CHANGES }"></span>\n            <os-svg ng-if="elementRestoreConfig.shouldShowDiscardedTabWarning()"\n                    icon="error"\n                    class="icon"\n                    data-bs-original-title="{{ \'tooltips:::Tab will not exist in __targetname__ after restore\' | i18next:{ targetname: ctrl.escapedTargetName } }}"\n                    data-bs-placement="top"></os-svg>\n          </div>\n\n          \x3c!-- Content for tab restore strategy column --\x3e\n          <div class="tab-strategy selective-restore-tab-strategy">\n            <os-select ng-model="elementRestoreConfig.strategy"\n                       ng-change="elementRestoreConfig.onStrategyChanged()"\n                       class="element-strategy-select element-strategy-container-{{ $index }}"\n                       backspace-reset="false"\n                       enter-activate="true">\n              <os-select-match>\n                <os-svg icon="{{ elementRestoreConfig.getStrategyIcon(false) }}" class="icon"></os-svg>\n                <span ng-bind-html="elementRestoreConfig.getStrategyString()"></span>\n                <div ng-if="elementRestoreConfig.isCustomized" class="element-strategy-triangle"></div>\n              </os-select-match>\n              <os-select-choices repeat="option.value.value as (key, option) in elementRestoreConfig.dropdownOptions | osSelectParameterSearch:$select.search:true">\n                <os-svg icon="{{ ctrl.getRestoreStrategyIcon(option.value.value, false) }}" class="icon"></os-svg>\n                <span ng-bind-html="option.value.name | highlight:escapeHTML($select.search)" class="element-strategy-dropdown-text"></span>\n              </os-select-choices>\n            </os-select>\n          </div>\n        </div>\n\n        \x3c!-- Elements without changes section --\x3e\n        <div class="table-row unchanged-tabs-head">\n          <div class="unchanged-tabs-head-row" ng-class="{ \'unchanged-tabs-collapsible-head-row\': ctrl.elementsWithoutChanges.length !== 0 }" ng-click="ctrl.toggleNoChangesSection()">\n            <div ng-if="ctrl.elementsWithoutChanges.length !== 0" class="unchanged-tabs-toggle">\n              <os-svg icon="dropdown-arrow" class="unchanged-tabs-toggle-icon" ng-class="{ \'unchanged-tabs-toggle-icon-collapsed\' : ctrl.noChangesSectionCollapsed }"></os-svg>\n            </div>\n            <div ng-if="ctrl.elementsWithoutChanges.length === 0" class="unchanged-tabs-filler"></div>\n            <div ng-if="ctrl.elementsWithoutChanges.length !== 1" class="unchanged-tabs-title">{{ \'__count__ tabs have no changes\' | i18next:{ count: ctrl.elementsWithoutChanges.length} }}</div>\n            <div ng-if="ctrl.elementsWithoutChanges.length === 1" class="unchanged-tabs-title">{{ \'1 tab has no changes\' | i18next }}</div>\n          </div>\n        </div>\n        <div ng-show="!ctrl.noChangesSectionCollapsed" ng-repeat="elementRestoreConfig in ctrl.elementsWithoutChanges" class="table-row unchanged-tab-row" ng-class="{ \'row-even\' : $even }">\n          <div class="tab-name">\n            <os-svg ng-if="elementRestoreConfig.useSvgElementIcon()" icon="{{ elementRestoreConfig.getElementIconSrc() }}" alt="{{ elementRestoreConfig.getElementIconAlt() }}" class="icon"></os-svg>\n            <img ng-if="!elementRestoreConfig.useSvgElementIcon()" ng-src="{{ elementRestoreConfig.getElementIconSrc() }}" alt="{{ elementRestoreConfig.getElementIconAlt() }}" class="icon">\n            <span class="tab-name-{{ $index }}" data-bs-original-title="{{ elementRestoreConfig.elementTooltip }}">{{ elementRestoreConfig.elementName }}</span>\n          </div>\n\n          <div data-automation="tab-changes" ng-class="{ \'tab-target\': true }">\n            <span></span>\n          </div>\n        </div>\n      </div>\n 