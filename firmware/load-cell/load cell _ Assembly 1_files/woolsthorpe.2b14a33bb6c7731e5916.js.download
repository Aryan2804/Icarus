             resize-last="true"\n               os-disabled="{{ctrl.collapsed}}">\n      \x3c!-- the row contains left and right panels--\x3e\n\n      <os-layout class="top-row"\n                 os-axis="x"\n                 os-size="100%"\n                 resize-last="true"\n                 os-disabled="{{ctrl.collapsed}}">\n        <os-layout os-hidden="{{ctrl.showingComments}}" os-size="false" os-min-size="280">\n          <div class="os-grow flyout-content">\n            <task-workflow-property-sheet class="container-fluid flyout-tab"\n                                          form-ctrl="taskForm"\n                                          placeholders="placeholders"\n                                          task="ctrl.workflowableTask"\n                                          on-change="ctrl.onPropertyChange(propertyId, value)"\n                                          show-full-comments="ctrl.toggleComments"></task-workflow-property-sheet>\n          </div>\n        </os-layout>\n        \x3c!-- property sheet --\x3e\n        <os-layout os-size="{{ctrl.detailsPaneWidth}}"\n                   os-min-size="{{ctrl.detailsCurrentMinSize}}"\n                   storage-id="{{ctrl.taskDialogStorageId}}"\n                   os-hidden="{{ctrl.showingComments}}"\n                   id="task-detail-pane">\n          <div class="tabbed-panel">\n            <div class="os-column-splitter-container os-grow os-full-height">\n              <div class="os-row os-grow os-full-height">\n                <div class="os-row">\n                  <div class="button-bar os-col">\n                    <div class="button-bar-group os-col">\n                      <div class="button-container os-row disable-user-select"\n                           ng-repeat="tab in ctrl.getTabList()">\n                        <button type="button" class="action-button"\n                             ng-class="{\'active\': ctrl.getSelectedTab().id === tab.id,\'button-is-extension\': !!tab.tabData}"\n 