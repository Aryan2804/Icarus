de-centerlines-checkbox">\n          <input type="checkbox" class="form-check-input" ng-model="dialog.centerlines">{{"Include bend centerlines" | i18next}}\n        </label>\n      </div>\n      <div class="form-check" ng-if="!!dialog.sheetMetalFlat">\n        <label class="checkbox form-check-label os-include-bendlines-checkbox">\n          <input type="checkbox" class="form-check-input" ng-model="dialog.bendlines">{{"Include bend tangent lines" | i18next}}\n        </label>\n      </div>\n      <div class="form-check" ng-if="!!dialog.sheetMetalFlat">\n        <label class="checkbox form-check-label os-include-cbore-csink-checkbox">\n          <input type="checkbox" class="form-check-input" ng-model="dialog.includeCboreCsink">{{"Include counterbore and countersink lines" | i18next}}\n        </label>\n      </div>\n      <div class="form-check" ng-if="!!dialog.sheetMetalFlat && getShowFormedOptions()">\n        <label class="checkbox form-check-label os-include-formed-outline-checkbox">\n          <input type="checkbox" class="form-check-input" ng-model="dialog.includeFormedOutlines">{{"Include form feature outlines" | i18next}}\n        </label>\n      </div>\n      <div class="form-check" ng-if="!!dialog.sheetMetalFlat && getShowFormedOptions()">\n        <label class="checkbox form-check-label os-include-formed-centermark-checkbox">\n          <input type="checkbox" class="form-check-input" ng-model="dialog.includeFormedCentermarks">{{"Include form feature centermarks" | i18next}}\n        </label>\n      </div>\n      <div class="form-check" ng-if="!!dialog.sketchesEnabled">\n        <label class="checkbox form-check-label os-include-sketches-checkbox">\n          <input type="checkbox" class="form-check-input" ng-model="dialog.sketches">{{"Include visible sketches" | i18next}}\n        </label>\n      </div>\n    </div>\n  </div>\n  <div ng-if="spinner.show" class="modal-body">\n    <os-spinner spinner="spinner"></os-spinner>\n  </div>\n  <div class="modal-foo