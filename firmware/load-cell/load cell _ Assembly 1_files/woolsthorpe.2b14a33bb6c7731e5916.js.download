up">\n                <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown">\n                    HLR\n                </button>\n                <ul class="dropdown-menu" role="menu">\n                    <li ng-repeat="(key, value) in viewState.current.segTypeStats">\n                        <a  class="dropdown-item" data-bs-original-title="{{key}} sergments, click to toggle on/off" data-bs-placement="bottom-end" ng-click="toggleSegmentTypeVisibleField(key)" href="#">\n                            <span ng-show="value.visible" class="glyphicon glyphicon-ok"></span>\n                            <span ng-show="viewState.base.segTypeStats.hasOwnProperty(key) && value.count == viewState.base.segTypeStats[key].count" class="badge float-end">{{value.count}}</span>\n                            <span ng-show="!viewState.base.segTypeStats.hasOwnProperty(key) || value.count != viewState.base.segTypeStats[key].count" class="badge float-end bg-success">{{value.count}}</span>\n                            <span ng-show="!viewState.base.segTypeStats.hasOwnProperty(key) || value.count != viewState.base.segTypeStats[key].count" class="badge float-end bg-info">{{viewState.base.segTypeStats[key].count}}</span>\n                            {{ key }}\n                        </a>\n                    </li>\n                    <li ng-if="viewState.current.segTypeStats.length" role="presentation" class="dropdown-divider"></li>\n                    <li>\n                        <a href="#" ng-disabled="!viewState.current.allSegmentVisible" ng-click="toggleSegmentTypeVisibleField()">\n                            <span ng-show="viewState.current.allSegmentVisible" class="glyphicon glyphicon-ok"></span>\n                            <span ng-show="viewState.current.data && viewState.current.allSegmentCount == viewState.base.allSegmentCount" class="badge float-end">{{viewState.current.allSegmentCount}}</span>\n                            <span ng-show="view