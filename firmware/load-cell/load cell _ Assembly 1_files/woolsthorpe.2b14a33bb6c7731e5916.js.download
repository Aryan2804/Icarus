iption} }}</h2>\n      </div>\n    </div>\n    <div ng-show="ctrl.isServerError && !ctrl.showConfirmation && !ctrl.isInitError">\n      <div class="os-pro-subtext os-order-details">\n        <os-svg icon="error"></os-svg>\n        {{\'Something went wrong, check your billing address and card details.\' | i18next}}\n      </div>\n    </div>\n    <div ng-show="ctrl.isInitError">\n      <div class="os-pro-subtext os-order-details">\n        <os-svg icon="error"></os-svg>\n        {{\'Something went wrong. Try again or contact Onshape Support.\' | i18next}}\n      </div>\n    </div>\n    <div class="os-col os-billing-wrapper">\n      <div class="os-row" ng-if="ctrl.requestingPlan === false" ng-class="{\'os-justify-between os-app-purchase-paid\': !ctrl.isFreePurchase, \'os-justify-center os-wrap os-app-purchase-free\': ctrl.isFreePurchase}">\n        <div ng-class="{\'os-col\': !ctrl.isFreePurchase || ctrl.showCompanyOption, \'os-row\': ctrl.isFreePurchase && !ctrl.showCompanyOption}">\n          <os-form>\n            <div ng-if="!ctrl.showConfirmation">\n              <div ng-if="ctrl.showCompanyOption" class="purchase-seat-count">\n                <div class="os-row os-upgrade-options-title"><span>{{ \'Details\' | i18next}}</span></div>\n                <div class="company-details-body company-seat-count">\n                  <company-seat-component company-name="ctrl.companyName" purchase-details="ctrl.purchaseDetails" user-seat-desc="ctrl.userSeatDescription" change-seats="ctrl.changeSeats(seatsVal)" disable-submit="ctrl.disablePurchase()" confirm-purchase="ctrl.doConfirmPurchase(osForm)"></company-seat-component>\n                </div>\n              </div>\n              <div class="os-form-group">\n                <osx-payment-options ng-if="ctrl.shouldShowPaymentOptions()"></osx-payment-options>\n                <div class="clearfix"></div>\n              </div>\n              <div ng-if="ctrl.currentPlan && !ctrl.processingPayment && !ctrl.purchaseComplete" cla