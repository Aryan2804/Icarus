ertyId, value)"\n                                                  show-company-dropdown="ctrl.workflowableTask.isMultiCompany">\n                    </task-metadata-property-sheet>\n                    <div class="picker-container workflow-picker" ng-if="::ctrl.getIsEnterprise()">\n                      <label class="control-label"><span>{{\'Task workflow\' | i18next }}</span></label>\n                      <div class="os-row workflow-select-row">\n                        <select class="form-control workflow-selector no-margin"\n                                ng-model="ctrl.selectedTaskWorkflow"\n                                ng-options="option as ctrl.getDisplayName(option) for option in ctrl.workflows track by option.id"\n                                ng-change="ctrl.handleWorkflowChange(option)"\n                                ng-disabled="ctrl.shouldDisableWorkflowSelector()"\n                        ></select>\n                        <button class="os-button"\n                           ng-click="ctrl.toggleWorkflowDiagram($event)"\n                           data-bs-original-title="{{ \'tooltips:::View workflow\' | i18next }}">\n                          <os-svg icon="workflow-preview-button"></os-svg>\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                  <div class="flyout-tab"\n                       ng-if="ctrl.getSelectedTab().id === ctrl.panelTabs.DOCLINKS">\n                    <task-select-item task="ctrl.workflowableTask" show-add-references="!ctrl.currentUser.isLight"></task-select-item>\n                  </div>\n                  <div class="flyout-tab"\n                       ng-if="ctrl.getSelectedTab().id === ctrl.panelTabs.TASKINFO">\n                    <task-date-property-sheet form-ctrl="taskForm"\n                                              task="ctrl.workflowableTask"\n                                              placeholders="placeholders"\n     