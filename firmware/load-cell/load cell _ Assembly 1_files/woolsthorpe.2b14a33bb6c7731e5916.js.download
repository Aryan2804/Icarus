ts" | i18next}}</a>\n            </li>\n          </ul>\n        </li>\n      </div>\n    </div>\n      \x3c!-- Filter on configuration parameter --\x3e\n      <div class="dropdown select-container-wrapper">\n        <button data-bs-toggle="dropdown" class="dropdown-toggle simple-select max-width-limit ellipseOverflowText">\n          <div data-bs-original-title={{$ctrl.getCurrentConfigParameterName()}} data-bs-placement="left"\n            class="w-100 text-start ellipseOverflowText">\n            {{$ctrl.getCurrentConfigParameterName()}}\n          </div>\n        </button>\n        <ul class="os-select-choices os-select-choices-content os-select-dropdown dropdown-menu" role="menu">\n          <li class="clickable-input max-width-limit" ng-click="$ctrl.currentConfigurationParam = null">\n            <a class="dropdown-item ellipseOverflowText" ng-class="{ selected: $ctrl.currentConfigurationParam == null }" href="#">\n              {{\'All inputs\' | i18next}}\n            </a>\n          </li>\n          <li class="clickable-input max-width-limit" ng-repeat="configParam in $ctrl.allConfigurationParams"\n            ng-click="$ctrl.setCurrentConfigParameter(configParam)" data-bs-original-title={{configParam.getDisplayName()}} data-bs-placement="right">\n            <a class="dropdown-item ellipseOverflowText" ng-class="{ selected: $ctrl.currentConfigurationParam.getParameterId() === configParam.getParameterId() }" href="#">\n              {{configParam.getDisplayName()}}\n            </a>\n          </li>\n        </ul>\n      </div>\n    </div>\n    <div class="os-row os-pin-right os-align-center">\n      <button type="button" class="btn-close" ng-click="$ctrl.onClose()" aria-hidden="true"></button>\n    </div>\n  </div>\n  <div class="modal-body scroll-y p-0">\n    <div class="d-flex w-100 h-100">\n      \x3c!-- Visibilty condition construction section --\x3e\n      <div class="visibility-conditions-section w-75 scroll-y">\n        <div class="config-param-row" 