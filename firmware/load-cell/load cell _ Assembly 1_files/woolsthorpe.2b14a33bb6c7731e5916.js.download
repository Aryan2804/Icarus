 tabs into this publication\' | i18next}}">\n      <os-svg icon="assembly-insert-button"></os-svg>\n      <span class="align-insert-tab-text">{{ \'Insert document tabs\' | i18next }}</span>\n    </button>\n  </div>\n\n  \x3c!-- Main content --\x3e\n  <div class="tab-list-container os-col" os-tab-manager-list>\n    <div class="document-tab-list tab-tree" ng-class="view.tabs">\n      <div class="alert alert-info no-search-results" ng-if="!isEmptyTree && numberOfResults === 0">\n        <p>{{"No results found" | i18next}} </p>\n        <button class="btn btn-secondary" ng-click="TabCtrl.clearAllFilters()">{{TabCtrl.getSearchHelpText()}}</button>\n      </div>\n      <element-tree class="os-col os-grow os-full-height"\n                    is-publication="TabCtrl.isPublication"\n                    filter-mode="view.filters"\n                    help-message="filterHelpMessage"\n                    num-results="numberOfResults"\n                    is-empty-tree="isEmptyTree"\n                    view-mode="view.tabs"\n                    has-focus="hasFocus"\n                    clear-filters="TabCtrl.clearAllFilters()"\n                    on-select="setHighlightedTab(tab)"></element-tree>\n    </div>\n  </div>\n\n  \x3c!-- Element thumbnail --\x3e\n  <div class="element-thumbnail" ng-if="view.preview && numberOfResults > 0">\n    <div class="element-name d-flex align-items-center" data-bs-original-title="{{highlightedTab.getElementName()}}" overflow-tooltip="true">\n      <os-svg class="element-icon add-space-right" icon="{{highlightedTab.getIconSrc()}}"></os-svg>\n      {{highlightedTab.getElementName()}}\n    </div>\n    <os-thumbnail class="thumbnail-image"\n                  document-id="{{documentId}}"\n                  has-thumbnail="{{::highlightedTab.hasThumbnail()}}"\n                  workspace-id="{{workspaceId}}"\n                  version-id={{versionId}}\n                  element-id="{{highlightedTab.elementId}}"\n                  api-configuration="{