>\n            </os-svg>\n          </div>\n          \x3c!-- Indicators for variable studio references: entire, partial, automatic. --\x3e\n          <div class="table-header-icon reference-icon" ng-if="variableTable.isVariableStudioReference()"\n               data-bs-original-title="{{ variableTable.getTooltip() }}"\n               data-bs-placement="left">\n            <os-svg icon="{{ variableTable.getIcon() }}"></os-svg>\n          </div>\n          \x3c!-- If we can rename the table, show a string parameter. --\x3e\n          <div class="editable-title" ng-if="variableTable.getCanRenameTable()">\n            <span class="os-table-title-sizer os-table-display-name">{{variableTable.nameBtParameter.getPendingStringValue()}}</span>\n            <div class="title-parameter"\n                os-parameter="variableTable.nameBtParameter"\n                data-bs-original-title="{{ variableTable.nameBtParameter.getParameterError() }}">\n            </div>\n          </div>\n          \x3c!-- Else, just show a title. --\x3e\n          <div class="os-table-title variable-table-title"\n              ng-if="!variableTable.getCanRenameTable()"\n              ng-class="{\'title-error\': variableTable.isFailedReference()}">\n            {{variableTable.getTableDisplayName()}}\n          </div>\n          \x3c!-- referenced variable studio version and update --\x3e\n          <div class="table-header-icon version-icon" ng-if="variableTableController.getShouldShowVersionInfo(variableTable)"\n              ng-click="variableTableController.revisionIconClick(variableTable)"\n              data-bs-original-title="{{ variableTable.getVersionTooltip() }}">\n            <os-svg icon="{{ variableTableController.getVersionIcon(variableTable) }}"></os-svg>\n          </div>\n          <div class="os-table-title os-table-header-addon" ng-if="variableTable.getHasLocationString()">\n            {{ variableTable.locationString }}\n          </div>\n          <div class="table-header-icon reference-icon status-icon"\n               ng-if="variableTable.getHasStatus()">\n            <os-svg icon="{{ variableTable.getStatusIcon() }}"\n                    class="os-icon-small"\n                    data-bs-original-title="{{ variableTable.getStatusMessage() }}"></os-svg>\n          </div>\n        </div>\n\n        \x3c!-- variable table more button --\x3e\n        \x3c!-- Use ng-show nested inside an ng-if to solve BEL-79834 (each dropdown needs its own angular scope which is provided by ng-if but also needs the ng-show so that the dropdown isn\'t removed (so it can get all of its events) --\x3e\n        <div ng-if="true" class="os-no-shrink">\n          <li class="dropdown os-table-more-button-container"\n              ng-show="variableTable.getShouldShowTableMenu()">\n            <a data-bs-toggle="dropdown"\n              class="os-table-more-button-control"\n              ng-click="$parent.removeContextMenuStyle(true)">\n              <os-svg icon="overflow"></os-svg>\n            </a>\n\n            <ul class="dropdown-menu dropdown-menu-end os-table-more-menu"\n                ng-class="variableTable.getThreeDotMenuClass($index)">\n              <li ng-if="variableTable.getCanCopyTable()">\n                <a class="dropdown-item" os-clipboard\n                  os-generate-clipboard-text="variableTable.copyTableDataForClipboard()"\n                  os-clipboard-success="variableTable.onCopyTableSuccess();"\n                  os-clipboard-error="variableTable.onCopyTableFailed(e);">{{ "Copy table" | i18next}}</a>\n              </li>\n\n              <li ng-if="variableTable.getCanRenameTable()">\n                <a class="dropdown-item" ng-click="variableTable.startTableRename()">{{ "Rename" | i18next }}</a>\n              </li>\n              <li ng-if="variableTable.getCanGoToVariableStudio()">\n                <a class="dropdown-item" ng-click="variableTable.goToVariableStudio()">{{ variableTable.getGoToVariableStudioLabel() }}</a>\n              </li>\n              <li ng-if="variableTable.getCanShowUpdateLinkedDocument()">\n                <a class="dropdown-item" ng-click="variableTableController.revisionIconClick(variableTable)">{{ "Update linked document…" | i18next }}</a>\n              </li>\n              <li ng-if="variableTableController.moveVariableTableManager.getCanMoveTableUp(variableTable.getReferenceId())">\n                <a class="dropdown-item" ng-click="variableTableController.moveVariableTableManager.moveTableUp(variableTable.getReferenceId())">{{ "Move up" | i18next }}</a>\n              </li>\n              <li ng-if="variableTableController.moveVariableTableManager.getCanMoveTableDown(variableTable.getReferenceId())">\n                <a class="dropdown-item" ng-click="variableTableController.moveVariableTableManager.moveTableDown(variableTable.getReferenceId())">{{ "Move down" | i18next }}</a>\n              </li>\n              <li ng-if="variableTableController.getCanExpandAllTables()">\n                <a class="dropdown-item" ng-click="variableTableController.expandAllVariableTables()">{{ "Expand all tables" | i18next}}</a>\n              </li>\n              <li ng-if="variableTableController.getCanCollapseAllTables()">\n                <a class="dropdown-item" ng-click="variableTableController.collapseAllVariableTables()">{{ "Collapse all tables" | i18next}}</a>\n              </li>\n              <li ng-if="variableTable.getCanEditReference()">\n                <a class="dropdown-item" ng-click="variableTableController.editVariableTableReference(variableTable)">{{ "Edit reference…" | i18next }}</a>\n              </li>\n              <li ng-if="variableTable.getCanRemoveReference()">\n                <a class="dropdown-item" ng-click="variableTable.removeReference()">{{ "Remove reference" | i18next }}</a>\n              </li>\n              <li ng-if="variableTableController.getCanShowCreateTaskMenuItem()">\n                <a class="dropdown-item" ng-click="variableTableController.showTaskDialog(variableTable.fullTableId)">{{ "Create task…" | i18next }}</a>\n              </li>\n            </ul>\n          </li>\n        </div>\n      </div>\n    </div>\n    \x3c!-- Table. --\x3e\n    <div ng-show="variableTable.isExpanded">\n      <os-table ng-if="!variableTable.isFailedReference()"\n                bt-table="variableTable.btTable"\n                resizable="true"\n                data-parameter-id="{{variableTable.btTable.getTableId()}}"\n                context-menu-manager="variableTable.contextMenuManager"\n                cell-parameter-manager="variableTable.cellParameterManager"\n                add-row-manager="variableTable.addRowManager"\n                highlight-manager="variableTable.highlightManager"\n                move-row-manager="variableTable.moveRowManager"\n                class="os-table-wrapper">\n      </os-table>\n    </div>\n  </div>\n  \x3c!-- Info text for elements without variables. --\x3e\n  <div ng-if="variableTableController.getShouldShowInfoBubble()">\n    <osc-zero-state-screen\n      class="zero-state-screen-container"\n      icon="variable-table-empty"\n      message="{{variableTableController.getZeroStateMessage()}}"\n      linkurl="{{variableTableController.getHelpUrl()}}"\n      linktext="{{variableTableController.getHelpUrlLabel()}}">\n    </osc-zero-state-screen>\n  </div>\n  <drop-indicator class="drop-indicator"\n                  ng-if="variableTableController.moveVariableTableManager.getSupportsDragAndDrop()"\n                  drop-info-observable="variableTableController.moveVariableTableManager.getDropInfoObservable()">\n  </drop-indicator>\n</div>\n')}]),e.exports=i},15536:function(e,t,n){var i="/project/web/ts/versions-and-history/versionsAndHistoryContent.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'<div>\n  <div class="versiongraph-mode-menu-and-history-container">\n    <filter-document-history on-submit="ctrl.submitHistorySearch(filterParams)"\n                             on-reset="ctrl.resetHistorySearch()"\n                             document-id="documentId"\n    ></filter-document-history>\n    <version-graph-mode-selector ng-if="hasMultipleBranches()" branch-filter="ctrl.appliedBranchFilter" is-disabled="ctrl.isFilterHistoryMode"\n      on-filter-change="toggleBranchDisplay(selectedMode, updateDefaultMode)">\n    </version-graph-mode-selector>\n  </div>\n  <div class="versiongraph-advanced-filters-container">\n    <button class="os-button os-clear document-filter-button" id="showMergesToggle"\n      ng-class="{\'os-active\': ctrl.showMerges}"\n      ng-click="toggleIncludeMergesAndFetchVersionGraph()"\n      ng-disabled="ctrl.isFilterHistoryMode || ctrl.doingGraphItemQuery || !showContent"\n      data-bs-original-title="{{getShowHideMergesTooltip()}}"\n      data-bs-placement="bottom">\n        <os-svg class="os-svg-icon" icon="mergelines"></os-svg>\n    </button>\n    <button class="os-button os-clear document-filter-button" id="showAutoVersionsToggle"\n      ng-class="{\'os-active\': ctrl.showAutoVersions}"\n      ng-click="toggleIncludeAutoVersionsAndFetchVersionGraph()"\n      ng-disabled="ctrl.isFilterHistoryMode || ctrl.doingGraphItemQuery || !showContent"\n      data-bs-original-title="{{getShowHideAutoVersionsTooltip()}}"\n      data-bs-placement="bottom">\n        <os-svg class="os-svg-icon" icon="auto-version"></os-svg>\n    </button>\n  </div>\n</div>\n\n<div os-versions-and-history-graph\n     class="os-version-graph show-advanced-filters"\n     ng-show="showContent && !ctrl.isFilterHistoryMode"\n     width="{{svgContainerWidth}}px"\n     oncontextmenu="return false;"\n     ng-class="{\'show-horizontal-scroll\': svgWidth > svgContainerWidth}"\n     style="max-width:{{svgContainerWidth}}px;"\n></div>\n<div ng-if="!showContent && !ctrl.isFilterHistoryMode" class="os-version-graph-spinner">\n  <div class="os-spinner-large os-spinner-spinning"></div>\n</div>\n<div ng-show="showContent" class="versions-history-table-container">\n  \x3c!-- Header --\x3e\n  <div class="os-flex-table-header">\n    <div class="os-flex-col os-item-workspace-or-version-graph inside-document" ng-if = "!ctrl.isFilterHistoryMode" style="flex: 1 0 0; -webkit-flex: 1 0 0; z-index:2000;">\n      <span class="left-right-arrow left-arrow" ng-show="svgWidth > svgContainerWidth" ng-click="scrollVersionGraphToLeftEdge()">\n        <img ng-src="/images/arrow-left.svg"/>\n      </span>\n      <span class="left-right-arrow right-arrow" ng-show="svgWidth > svgContainerWidth" ng-click="scrollVersionGraphToRightEdge()">\n        <img ng-src="/images/arrow-right.svg"/>\n      </span>\n    </div>\n    <div class="os-flex-col os-item-workspace-or-version-name inside-document" ng-show="!ctrl.isFilterHistoryMode">\n      <span>{{ "Name" | i18next}}</span>\n    </div>\n    <div class="os-flex-col os-item-modified-by-and-date inside-document" ng-show="!ctrl.isFilterHistoryMode">\n      <span>{{ "Modified" | i18next}}</span>\n    </div>\n    <div class="os-flex-col history-search-results-header" ng-show="ctrl.isFilterHistoryMode">\n      <span>{{ "Description" | i18next}}</span>\n    </div>\n    <div class="os-flex-col history-search-results-header" ng-show="ctrl.isFilterHistoryMode">\n      <span>{{ "Modified by" | i18next}}</span>\n    </div>\n  </div>\n\n  \x3c!-- Table body --\x3e\n  <div class="versions-history-table-body">\n    <div ng-repeat="graphItem in ctrl.getDisplayedGraphItems()" ng-class="{\'selected\': isSelected(graphItem),\n                  \'selectedForReference\': isSelectedForReference(graphItem),\n                  \'click-disabled\': isLoadingMoment,\n                  \'not-allowed\': isUnavailableForRepair(graphItem),\n                  \'compare-target-highlight\': !isInCompareSetupMode && graphItem.isCompareTarget(),\n                  \'compare-base-highlight\': !isInCompareSetupMode && graphItem.isCompareBase(),\n                  \'compare-target-bar\': graphItem.isCompareTarget(),\n                  \'compare-base-bar\': graphItem.isCompareBase(), separator: graphItem.isSeparator(), change: graphItem.isChange() || graphItem.isMoreFilteredRecords(),\n                  \'branch-point\': graphItem.isBranchPoint(),\n                  \'collapsed-changes\': graphItem.isCollapsedChanges(),\n                  \'nonloaded-changes\': graphItem.isNonloadedChanges(),\n                  \'no-filter-results\': graphItem.isNoFilterResults(),\n                  \'history-search-result\': ctrl.isFilterHistoryMode,\n                  \'compare-disabled\': isInCompareSetupMode && oldCompareBaseSelected && graphItem.isCompareTarget(),\n                  \'new-changes\': graphItem.getIsNewChange(),\n                  \'tagged-change\': ctrl.isTaggedChange(graphItem)}"\n       class="os-flex-table-row"\n       id="graphItem-{{graphItem.id}}"\n       ng-mouseover="setChangeHovered(graphItem, true)"\n       ng-mouseleave="setChangeHovered(graphItem, false)"\n       data-bs-html="true"\n       data-bs-original-title="{{graphItem.getShortTooltip()}}"\n       data-bs-expanded-content="{{graphItem.getExpandedTooltip()}}"\n       os-context-menu="getActionMenu(graphItem)"\n       os-context-menu-close-event="COLLAPSE_FLYOUT"\n       data-bs-placement="right"\n       tooltip-expand-delay="0">\n    <div class="os-flex-col os-item-workspace-or-version-graph inside-document"\n         ng-if = "!graphItem.getIsRelatedToChangeViewModel() && !ctrl.isFilterHistoryMode"\n         ng-click="openOrCompareWorkspace(documentId, graphItem)"\n         style="flex: 1 0 0; -webkit-flex: 1 0 0;">\n      </div>\n    <div class="os-flex-col os-item-workspace-or-version-graph inside-document change-item"\n         ng-if = "graphItem.getIsRelatedToChangeViewModel() && !ctrl.isFilterHistoryMode"\n         ng-click="openMomentOrShowChanges(graphItem)"\n         style="flex: 1 0 0; -webkit-flex: 1 0 0;">\n      </div>\n      <div class="os-flex-col auto-version-icon" ng-if="graphItem.isChainUpdateVersion()"\n        ng-click="openOrCompareWorkspace(documentId, graphItem)"\n        style="position: absolute; left: {{svgContainerWidth}}px;">\n        <os-svg icon="auto-version" />\n      </div>\n      \x3c!-- Name --\x3e\n      <div ng-if="graphItem.isWorkspace()" class="os-flex-col os-item-workspace-or-version-name inside-document"\n        ng-click="openOrCompareWorkspace(documentId, graphItem)">\n        <div class="workspace-name-wrapper">\n          <span class="workspace-name {{graphItem.getBranchColorClass()}}">\n            <span ng-if="graphItem.isLocked()">\n              <os-svg icon="lock-icon_static" class="branch-lock-icon"></os-svg>\n            </span>\n            {{graphItem.name}}\n          </span>\n        </div>\n        <span class="change-details allowed-override" ng-click="toggleWorkspaceOrVersionExpanded($event, graphItem)">\n          <os-svg\n            ng-if="graphItem.hasAssociatedChanges()"\n            class="os-icon-xsmall changes-expanded-toggle"\n            icon="{{graphItem.getMicroversionDetailsIcon()}}">\n          </os-svg>\n          <span\n            ng-class="{\'n-changes\': graphItem.hasAssociatedChanges(), \'enable-when-disabled\': isInCompareSetupMode && oldCompareBaseSelected && graphItem.isCompareTarget()}">\n            {{graphItem.getMicroversionDetailsDescription()}}\n          </span>\n        </span>\n      </div>\n      <div ng-if="graphItem.isVersion()" class="os-flex-col os-item-workspace-or-version-name inside-document"\n        ng-click="openOrCompareWorkspace(documentId, graphItem)">\n        <span class="version-name">{{graphItem.name}}</span>\n        <br>\n        <span ng-if="graphItem.parent" class="change-details"\n          ng-class="{\'allowed-override\': graphItem.isExpandable()}"\n          ng-click="toggleWorkspaceOrVersionExpanded($event, graphItem)">\n          <os-svg\n            ng-if="graphItem.hasAssociatedChanges()"\n            class="os-icon-xsmall changes-expanded-tog