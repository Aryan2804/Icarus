eld)"\n                    ng-options="option for option in controller.allCountFields"\n                    ng-model="controller.currentSortCountField">\n            </select>\n          </form>\n        </th>\n        <th>\n          <form class="form-inline">\n            <label class="os-bold">Sizes:</label>\n            <select class="form-control"\n                    ng-change="controller.onSortSizeFieldChange(controller.currentSortSizeField)"\n                    ng-options="option for option in controller.allSizeFields"\n                    ng-model="controller.currentSortSizeField">\n            </select>\n          </form>\n        </th>\n      </tr>\n      <tr ng-repeat="eInfo in controller.getElementList()">\n        <td>\n          <table class="table table-bordered">\n            <tr><td><a target="_blank" ng-href="{{eInfo.href}}">{{ eInfo.id }}</a></td></tr>\n            <tr><td>{{ eInfo.name }}</td></tr>\n            <tr><td>{{ eInfo.type }}</td></tr>\n          </table>\n        </td>\n        <td>\n          <table class="table table-bordered table-striped">\n            <tr ng-repeat="countKey in controller.getCountKeys(eInfo)">\n              <td style="width: 50%">{{ countKey }}</td>\n              <td>{{ controller.getCountValue(countKey, eInfo) }}</td>\n            </tr>\n          </table>\n        </td>\n        <td>\n          <table class="table table-bordered table-striped">\n            <tr ng-repeat="sizeKey in controller.getSizeKeys(eInfo)">\n              <td style="width: 50%">{{ sizeKey }}</td>\n              <td>{{ controller.getSizeValue(sizeKey, eInfo) }} {{controller.getSelectedSizeUnits()}}</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </div>\n</div>\n')}]),e.exports=i},71208:function(e,t,n){var i="/project/web/woolsthorpe/app/partials/documentMenu.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'\x3c!-- Commands and divider for document --\x3e\n<li ng-if="NavbarC