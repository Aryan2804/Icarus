r year.">\n      </span>\n      <span class="try-upgrade-button"><button class="btn btn-secondary professional-button" ng-click="$ctrl.goToRenewStudentPlan()"\n          data-bs-html="true" data-bs-original-title="{{$ctrl.getEduButtonTooltip()}}">{{"Renew" | i18next}}</button>\n      </span>\n    </div>\n    <div class="os-plan-area info-message" ng-if="$ctrl.isPaidCustomerInPast() && !$ctrl.showInactiveCompanyBanner()">\n      <span ng-i18next="[html:i18next]Your <strong>Free</strong> subscription only allows public data. Upgrade to Onshape Professional to create, edit and share private data with your team."></span>\n      <osx-plan-upgrade class="try-upgrade-button" button-style="btn-secondary"></osx-plan-upgrade>\n    </div>\n    <div class="os-plan-area os-grow warning-message" ng-if="$ctrl.showInactiveCompanyBanner()">\n      <span ng-i18next="[html:i18next]({companyType: $ctrl.getCompanyType()})Your __companyType__ is <strong>inactive</strong> and all your documents are read-only. To continue editing your documents, upgrade your Onshape subscription or downgrade to a free account."> </span>\n      <div class="try-upgrade-button" ng-if="$ctrl.isCompanyAccountInactive() && $ctrl.isUserProOwner()"><button class="btn btn-secondary" ng-click="$ctrl.manageOnshapeSubscription()" data-bs-original-title=\'{{"Manage Onshape subscription" | i18next}}\'>{{"Manage Onshape subscription" | i18next}}</button></div>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n\n  \x3c!-- Selected Inactive Company Banner --\x3e\n  <div class="os-billing-banner" ng-if="$ctrl.showCompanyInactiveBanner()">\n    <div class="os-plan-area os-grow warning-message">\n      <span ng-i18next="[html:i18next]({companyType: $ctrl.getCompanyType()})Your __companyType__ is <strong>inactive</strong> and all your documents are read-only. To continue editing your documents, upgrade your Onshape subscription or downgrade to a free account."> </span>\n      <div class="try-upgrade-button" ng-if="$ctrl