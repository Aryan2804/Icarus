ons}}}\n{{{edgeFragmentUtilityFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n  DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n  discardIfIsGap(vLength, vLineStipple);\n\n  float opacityScale = smoothstep(0.0, uLineFilterWidth, 0.5 * (vLineWidth + uLineFilterWidth) - abs(vDistance));\n  vec4 color = vec4(uMatchesCompareColor, 1.0);\n  if (opacityScale > 0.3) {\n    vec4 compareSample = TEXTURE_2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n    float compareDepth = decodeDepth(compareSample.zw);\n    if (!isSameDepth(vDepth, compareDepth)) {\n      color = vec4(uTintColor, 1.0);\n    }\n  }\n\n  color = mix(color, uBackgroundColor, uBackgroundMixProportion);\n  color.a *= opacityScale;\n\n  FRAG_COLOR = color;\n}\n"},12117:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform FRAGMENT_PRECISION vec4 uViewport;\nuniform vec3 uTintColor;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nFRAG_IN lowp vec4 vColor;\nFRAG_IN FRAGMENT_PRECISION float vDepth;\n\n{{{pointFragmentUtilityFunctions}}}\n{{{depthNormalFunctions}}}\n{{{compareFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n  vec4 color = vec4(uTintColor, 1.0);\n\n  vec4 compareSample = TEXTURE_2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n  float compareDepth = decodeDepth(compareSample.zw);\n\n  if (isSameDepth(vDepth, compareDepth)) {\n    color = vec4(uMatchesCompareColor, 1.0);\n  }\n\n  vec4 backgroundColor = vec4(1.0, 1.0, 1.0, 1.0);\n  FRAG_COLOR = getPointColor(color, backgroundColor);\n}\n"},54576:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform vec3 uSpecular;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\nuniform vec3 uTintColor;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\nFRAG_IN lowp vec3 vNormal;\nFRAG_IN mediump vec2 vTextureCoordinate;\nFRAG_IN mediump float vOpacity;\nFRAG_IN FRAGMENT_PRECISION float vDepth;\n\n{{{depthNormalFunctions}}}\n{{{compareFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n{{{cosmeticThreadFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 compareSample = TEXTURE_2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n    vec3 compareNormal = decodeNormal(compareSample.xy);\n    float compareDepth = decodeDepth(compareSample.zw);\n\n    vec3 ambient, diffuse;\n\n    vec3 facingNormal = flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs);\n\n    if (isSameFace(vDepth, compareDepth, facingNormal, compareNormal)) {\n        ambient = uColorAmbientFactor * uMatchesCompareColor;\n        diffuse = uColorDiffuseFactor * uMatchesCompareColor;\n    } else {\n        ambient = uColorAmbientFactor * uTintColor;\n        diffuse = uColorDiffuseFactor * uTintColor;\n    }\n\n    vec3 threadedNormal = getThreadedNormal(vPosition, vNormal);\n\n    FRAG_COLOR = lightFragment(ambient, diffuse, uSpecular, vOpacity, vPosition, threadedNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},27278:function(e,t){"use strict";t.A="{{{fs-draw-faces-decals}}}"},74121:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform vec3 uSpecular;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\nuniform vec3 uTintColor;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\nFRAG_IN lowp vec3 vNormal;\nFRAG_IN mediump vec2 vTextureCoordinate;\nFRAG_IN mediump float vOpacity;\nFRAG_IN FRAGMENT_PRECISION float vDepth;\n\n{{{depthNormalFunctions}}}\n{{{compareFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 compareSample = TEXTURE_2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n    vec3 compareNormal = decodeNormal(compareSample.xy);\n    float compareDepth = decodeDepth(compareSample.zw);\n\n    vec3 ambient, diffuse;\n\n    vec3 facingNormal = flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs);\n\n    if (isSameFace(vDepth, compareDepth, facingNormal, compareNormal)) {\n        ambient = uColorAmbientFactor * uMatchesCompareColor;\n        diffuse = uColorDiffuseFactor * uMatchesCompareColor;\n    } else {\n        ambient = uColorAmbientFactor * uTintColor;\n        diffuse = uColorDiffuseFactor * uTintColor;\n    }\n\n    FRAG_COLOR = lightFragment(ambient, diffuse, uSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},40046:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform vec3 uSpecular;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\nuniform vec3 uTintColor;\nuniform float uBlendOverdrawAdjustment;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\nFRAG_IN lowp vec3 vNormal;\nFRAG_IN mediump vec2 vTextureCoordinate;\nFRAG_IN mediump float vOpacity;\nFRAG_IN mediump vec4 vVertexColor;\n\n{{{planeIdFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 compareSample = TEXTURE_2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n    vec3 ambient, diffuse;\n    float opacity = vOpacity;\n\n    if (isPlaneInSet(vVertexColor, compareSample)) {\n        ambient = uColorAmbientFactor * uMatchesCompareColor;\n        diffuse = uColorDiffuseFactor * uMatchesCompareColor;\n        opacity *= uBlendOverdrawAdjustment;\n    } else {\n        ambient = uColorAmbientFactor * uTintColor;\n        diffuse = uColorDiffuseFactor * uTintColor;\n    }\n\n    FRAG_COLOR = lightFragment(ambient, diffuse, uSpecular, opacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},95250:function(e,t){"use strict";t.A="/**\n * Will return a sign to flip the normal if it is pointing away from the camera. This is useful for illuminating back\n * faces as though they are pointed at the camera.\n *\n * @param normal   View-space normal at the fragment (or vertex).\n * @param position View-space position (same space as `normal`), typically vPosition.\n */\nfloat getNormalSign(vec3 normal, vec3 position) {\n  float signPerspective  = sign(dot(normal, -position));\n  float signOrthographic = sign(normal.z);\n  return uPMatrix_fs[3][3] * signOrthographic - uPMatrix_fs[2][3] * signPerspective;\n}\n"},12253:function(e,t){"use strict";t.A="uniform float uActiveHighlightIndex;\n#ifdef USE_VERTEX_HIGHLIGHT_TEXTURE\nuniform sampler2D uHighlightColorTexture;\nuniform float uHighlightColorTextureWidth;\n#endif\n\n// Indicates whether or not the interior parts of the selection should be hidden.\nuniform int uHideSelectionInterior;\n\nbool entityHasHighlight(float flags) {\n  return IS_BIT_1_SET(flags);\n}\n\nbool isHighlightTypeActive(float encodedHighlightType) {\n  return (abs(uActiveHighlightIndex - encodedHighlightType * 255.0) < 0.5);\n}\n\nbool isHighlighted(float flags, bool occurrenceHasHighlight) {\n  // Highlight if the per-vertex highlight flag is set, or if the uniform override is set and this vertex is visible\n  return occurrenceHasHighlight || entityHasHighlight(flags);\n}\n\nbool isHighlightedForIndex(float flags, float entityHighlightType, float occurrenceHighlightType) {\n  // Highlight if the per-vertex highlight flag is set, or if the uniform override is set and this vertex is visible,\n  // and if the highlight matches the index of the highlight type being blended.\n  return isHighlightTypeActive(occurrenceHighlightType) ||\n         (isHighlightTypeActive(entityHighlightType) && entityHasHighlight(flags));\n}\n\n#ifdef USE_VERTEX_HIGHLIGHT_TEXTURE\n\nvec4 getColorModifiedByHighlight(vec4 highlightId, vec4 vertexColor) {\n  if (uHideSelectionInterior > 0) {\n    return vertexColor;\n  }\n\n  vec4 finalColor = vertexColor;\n  if (!interiorHighlightIsSuppressed(aHighlightId.a) && IS_BIT_1_SET(aHighlightId.a)) {\n    float index = highlightId.r * 255.0;\n    vec4 highlightColor = TEXTURE_2D(uHighlightColorTexture, vec2((0.5 + index) / uHighlightColorTextureWidth, 0.5));\n    vec3 entityHighlight = mix(vertexColor.rgb, highlightColor.rgb, highlightColor.a);\n    finalColor = vec4(entityHighlight, highlightColor.a);\n  }\n\n  return finalColor;\n}\n\n#else\n\n// If highlight texture reads are not supported in the vertex shader, we leave the color changes to the overlay pass\nvec4 getColorModifiedByHighlight(vec4 highlightId, vec4 vertexColor) {\n  return vertexColor;\n}\n\n#endif\n"},61089:function(e,t){"use strict";t.A="uniform float uUseMask;\nuniform sampler2D uMask;\nuniform vec2 uMaskWidthHeight;\n\nFRAG_IN FRAGMENT_PRECISION float vDepth;\n\n{{{compareFunctions}}}\n{{{depthNormalFunctions}}}\n\nvoid discardIfDepthMatchesMask() {\n    if (uUseMask > 0.0) {\n        vec4 maskSample = TEXTURE_2D(uMask, gl_FragCoord.xy / uMaskWidthHeight);\n        float maskDepth = decodeDepth(maskSample.zw);\n        if (!isSameDepth(vDepth, maskDepth)) {\n            discard;\n        }\n    }\n}\n\nvoid discardIfNormalDepthMatchesMask(vec3 normal) {\n    if (uUseMask > 0.0) {\n        vec4 maskSample = TEXTURE_2D(uMask, gl_FragCoord.xy / uMaskWidthHeight);\n        vec3 maskNormal = decodeNormal(maskSample.xy);\n        float maskDepth = decodeDepth(maskSample.zw);\n        if (!isSameFace(vDepth, maskDepth, normal, maskNormal)) {\n            discard;\n        }\n    }\n}\n\nvec4 encodeDepthWithZeroNormalColor() {\n    vec4 color = vec4(0.0);\n    color.zw = encodeDepth(vDepth);\n    return color;\n}\n\nvec4 encodeNormalDepthColor(vec3 normal) {\n    vec4 color;\n    color.xy = encodeNormal(normal);\n    color.zw = encodeDepth(vDepth);\n    return color;\n}\n"},89651:function(e,t){"use strict";t.A="uniform float uPickPassIteration;\n\n{{{utilityFunctions}}}\n\n#define IDS_PER_OCCURRENCE_SLICE 4096.0\n\nvec4 encodePickingId(float occurrenceId, vec4 pickId) {\n  vec4 occurrenceIdEncoded = vec4(0.0, 0.0, 0.0, 0.0);\n\n  // The occurrence id gets 12 bits to encode its id.  First we must figure out the value of the slice of the whole\n  // id which is being encoded.\n  float divided = occurrenceId / IDS_PER_OCCURRENCE_SLICE;\n  float whole = 0.0;\n  float fraction = modf(divided, whole);\n  // If the pick pass iteration is 0, take the bits of less signficance.  If it is 1, take the bits of higher significance.\n  // For all other passes, we will not support an encoding of the occurrence id, since we only have 24 bits for the\n  // whole id.  If the pick pass iteration is something other than 0 or 1, this should evaluate to 0, since there\n  // should be no data needed from the occurrence id in subsequent passes.\n  float occurrenceSlice = (fraction * IDS_PER_OCCURRENCE_SLICE * float(uPickPassIteration == 0.0)) +\n    (whole * float(uPickPassIteration == 1.0));\n\n  // Now we must encode the 12 bits into a color value.  The 8 most-significant bits go into the red channel.  The\n  // 4 least-significant bits go into the the 4 most-significant bits of the green channel.\n  divided = occurrenceSlice / 16.0;  // 16 = 2^4.  This division should result in values between 0 and 255.9375\n  fraction = modf(divided, whole);\n  occurrenceIdEncoded.r = whole / 255.0;\n  occurrenceIdEncoded.g = fraction * BYTE_FRACTION_TO_NORMALIZED_FLOAT;  // This should result in values between 0 and 240, with all component bits occupying the 4 most-significant spots\n\n  return occurrenceIdEncoded + pickId;\n}\n"},94604:function(e,t){"use strict";t.A="{{{utilityFunctions}}}\n\n// Returns true if left and right share any bits\nbool anyBitsSetInBoth(float left, float right) {\n    float multiplier = 2.0;\n    bool hasAny = false;\n    for (int i = 0; i < 8; ++i) {\n        hasAny = hasAny || (isBitSet(left, 255.0 / multiplier) && isBitSet(right, 255.0 / multiplier));\n        multiplier *= 2.0;\n    }\n    return hasAny;\n}\n\nbool isPlaneInSet(vec4 planeId, vec4 setBitfield) {\n    return anyBitsSetInBoth(setBitfield.r, planeId.r) || anyBitsSetInBoth(setBitfield.g, planeId.g) ||\n           anyBitsSetInBoth(setBitfield.b, planeId.b) || anyBitsSetInBoth(setBitfield.a, planeId.a);\n}\n"},77347:function(e,t){"use strict";t.A="uniform mediump float uPointFilterWidth;\nuniform mediump float uUsePrimitivePoints;\n\nFRAG_IN mediump vec2  vOffset;      // screen offset from the point center in multiples of radius\nFRAG_IN mediump vec3  vPointFont;   // x: radial divisions (0=off, 1=circle, 2=ring, 3=ring+dot), y: angular divisions (0=off, 2=minus, 4=plus, 6=asterisk), z: boldness of radial divisions 0-100 representing % of circle occupied by rings\nFRAG_IN mediump float vPointRadius;\n\n{{{utilityFunctions}}}\n\nvec4 getPointColor(vec4 pointColor, vec4 bgColor) {\n    // BEL-267428: For primitive GL points, gl_PointCoord gives the coordinate of each fragment\n    // within [0,1]x[0,1] the point sprite. Offset this coordinate to be centered\n    // around the old fragment at (0.5, 0.5) and scaled to the point radius.\n    vec2 offset = vOffset;\n    if (uUsePrimitivePoints == 1.0) {\n        offset = (gl_PointCoord - vec2(0.5)) * 2.0 * vPointRadius;\n    }\n    float angularSegmentWidth = 0.33 * vPointRadius;\n    float distance = length(offset);\n    float angle = atan(offset.y, offset.x);\n\n    // the style determines the number of radial and angular segments (rounding needed due to precision weirdness)\n    float radialSegmentCount = round(vPointFont[0]);\n    float angularSegmentCount = round(vPointFont[1]);\n\n    // determines thickness of rings\n    float ringFont = clamp(vPointFont[2] / 100.0, 0.0, 1.0);\n\n    // radial pattern\n    float radialOpacity = 0.0;\n    float radialColorMix = 0.0;\n    if (radialSegmentCount > 0.0)\n    {\n        // snap to the closest radial segment\n        float radialStep = vPointRadius / radialSegmentCount;\n        float closestIndex = round(distance / radialStep);\n        // enforce no transitions at center and farther than the perimeter\n        closestIndex = clamp(closestIndex, 1.0, radialSegmentCount);\n        // find the boundary where opacity transition will happen\n        float closestBoundary = closestIndex * radialStep;\n        // flip the order of transitions for even segments (counting from the outside)\n        float flip = 2.0 * mod(radialSegmentCount - closestIndex, 2.0) - 1.0;\n        // find the adjustment for the font (size of each ring * (2x - 1))\n        float fontAdjustment = mix(0.0, vPointRadius / max(radialSegmentCount, 1.0) * (ringFont - 0.5) * 2.0, min(radialSegmentCount, 1.0));\n        // smooth out the opacity transitions to appear antialiased\n        float radialValue = smoothstep(-uPointFilterWidth, uPointFilterWidth, 2.0 * (flip * (distance - closestBoundary) + fontAdjustment));\n        // calculate whether the fragment is inside or outside the outermost ring\n        float isInside = clamp(radialSegmentCount - closestIndex, 0.0, 1.0);\n        // blend with opacity outside glyph, blend with color inside glyph\n        // mix is used with a boolean for faster branching\n        radialOpacity = mix(radialValue, 1.0, isInside);\n        radialColorMix = mix(1.0, radialValue, isInside);\n    }\n\n    // angular pattern\n    float angularOpacity = 0.0;\n    if (angularSegmentCount > 0.0)\n    {\n        //remove color mixing effect from inside rings when an angular pattern is used\n        radialOpacity = min(radialOpacity, radialColorMix);\n        radialColorMix = 1.0;\n\n        // snap to the closest angular segment\n        float angleStep = TAU / angularSegmentCount;\n        float closestAngle = round(angle / angleStep) * angleStep;\n        // opacity will change in the direction perpendicular to the closest angle diameter\n        vec2 perpendicularDirection = vec2(-sin(closestAngle), cos(closestAngle));\n        float perpendicularDistance = abs(dot(offset, perpendicularDirection));\n        // smooth out the opacity transitions to appear antialiased\n        angularOpacity = smoothstep(-uPointFilterWidth, uPointFilterWidth, angularSegmentWidth - 2.0 * perpendicularDistance);\n    }\n\n    // fade to transparent at the outer perimeter of the glyph\n    float perimeterOpacity = smoothstep(-uPointFilterWidth, 0.0, vPointRadius - distance);\n\n    // combine the total opacity scale by adding the angular and radial styles, and cropping them with the perimeter\n    float opacityScale = min(perimeterOpacity, max(angularOpacity, radialOpacity));\n\n    // determine the color mix of this fragment based on angular shape and radial ring location\n    float colorScale = max(angularOpacity, radialColorMix);\n\n    // empty style results in a solid rectangle\n    // Note: the isEmpty variable is employed because, on some systems, putting the statement directly in the\n    // max() function will result in an ambiguously overloaded function call.\n    float isEmpty = float(radialSegmentCount + angularSegmentCount == 0.0);\n    opacityScale = max(opacityScale, isEmpty);\n    colorScale = max(colorScale, isEmpty);\n\n    // mix the colors and opacity\n    vec4 mixedColor = mix(bgColor, pointColor, colorScale);\n    mixedColor.a *= clamp(opacityScale, 0.0, 1.0);\n\n    return mixedColor;\n}\n"},12314:function(e,t){"use strict";t.A="#ifndef SECTION_PLANE_CLIPPING_FUNCTIONS\n\n#define SECTION_PLANE_CLIPPING_FUNCTIONS 1\n\nuniform mediump mat4  uSectionPlaneEquations;\nuniform mediump float uSectionPlaneCount;\nuniform lowp int    uClippedBySectionPlanes;\n\n// This is used to add some tolerance to the clipping tests so that the face that defines the section plane is\n// not clipped itself. This value is provided by the application so that it can be modulated by the model bounds\n// such that large depth ranges will have a large threshold.\nuniform float uEndcapZFightingThreshold;\n\n// BEL-46902: this is a separate value used to add an offset to the equations that test clip planes against each other.\n// They need a higher tolerance and hence are given a separate value.\nuniform float uInterEndcapZFightingThreshold;\n\nvec4 getSectionPlaneEquation(vec4 selector) {\n  return selector * uSectionPlaneEquations;\n}\n\nbool passesSectionPlaneClippingTest(vec3 cameraPosition) {\n  // TODO: is it quicker to early exit with a branch or just always do the matrix multiply?\n  if (uClippedBySectionPlanes == 0 || uSectionPlaneCount < 1.0) {\n    return true;\n  } else {\n    vec4 planeResults = uSectionPlaneEquations * vec4(cameraPosition, 1.0);\n\n    bool passes = (uSectionPlaneCount < 1.0 || planeResults.x > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 2.0 || planeResults.y > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 3.0 || planeResults.z > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 4.0 || planeResults.w > uEndcapZFightingThreshold);\n\n    return passes;\n  }\n}\n\nbool passesNormalSectionPlaneClippingTest(vec3 cameraPosition) {\n  // TODO: is it quicker to early exit with a branch or just always do the matrix multiply?\n  if (uClippedBySectionPlanes == 0 || uSectionPlaneCount < 1.0) {\n    return true;\n  } else {\n    vec4 dotResults = vec4(0.0);\n\n    for (int i = 0; i < 4; i++) {\n      vec4 selector = vec4(0.0);\n      selector[i] = 1.0;\n      vec4 normal = getSectionPlaneEquation(selector);\n      dotResults[i] = normal[2];// equivalent to dot'ing with vec3(0.0, 0.0, 1.0), the camera space look vector\n    }\n\n    vec4 planeResults = uSectionPlaneEquations * vec4(cameraPosition, 1.0);\n\n    bool passes = (uSectionPlaneCount < 1.0 || dotResults[0] > 0.0 || planeResults.x > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 2.0 || dotResults[1] > 0.0 || planeResults.y > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 3.0 || dotResults[2] > 0.0 || planeResults.z > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 4.0 || dotResults[3] > 0.0 || planeResults.w > uEndcapZFightingThreshold);\n\n    return passes;\n  }\n}\n\nbool passesAllButOneSectionPlaneClippingTest(vec3 cameraPosition, vec4 selector) {\n  // TODO: is it quicker to early exit with a branch or just always do the matrix multiply?\n  if (uSectionPlaneCount < 1.0) {\n    return true;\n  } else {\n    vec4 planeResults = uSectionPlaneEquations * vec4(cameraPosition, 1.0);\n\n    bool passes = (uSectionPlaneCount < 1.0 || selector[0] > 0.0 || planeResults.x > uInterEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 2.0 || selector[1] > 0.0 || planeResults.y > uInterEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 3.0 || selector[2] > 0.0 || planeResults.z > uInterEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 4.0 || selector[3] > 0.0 || planeResults.w > uInterEndcapZFightingThreshold);\n\n    return passes;\n  }\n}\n\n#endif\n"},79028:function(e,t){"use strict";t.A="const float outsideIsolationOrder = 256.0;\nconst float partCountOrder        = 16.0;\n"},74337:function(e,t){"use strict";t.A="uniform mat4 uSectionPlaneTangents;\nuniform mat4 uSectionPlaneCenters;\n\n{{{sectionPlaneConstants}}}\n{{{sectionPlaneClippingFunctions}}}\n\nvec4 getSectionPlaneTangent(vec4 selector) {\n  return selector * uSectionPlaneTangents;\n}\n\nvec4 getSectionPlaneCenter(vec4 selector) {\n  return selector * uSectionPlaneCenters;\n}\n\nvoid getSectionPlaneFrame(vec4 selector, out vec3 point, out vec3 uAxis, out vec3 vAxis) {\n  vec4 equation = getSectionPlaneEquation(selector);\n  point = getSectionPlaneCenter(selector).xyz;\n\n  uAxis = getSectionPlaneTangent(selector).xyz;\n  vAxis = cross(equation.xyz, -uAxis);\n}\n\n// get the number of parts outside of isolate and number of total parts intersected\nvec2 getIsolateAndInterferenceInfoFromAlpha(float alpha) {\n  float outsideIsolationCount = floor(alpha / outsideIsolationOrder);\n  float higherBits = outsideIsolationCount * outsideIsolationOrder;\n  float partCount = floor((alpha - higherBits) / partCountOrder);\n  return vec2(outsideIsolationCount, partCount);\n}\n"},23768:function(e,t){"use strict";t.A="vec4 medianFilterEndcapSamples(vec4 sample0, vec4 sample1, vec4 sample2) {\n  sample0 = abs(sample0);\n  sample1 = abs(sample1);\n  sample2 = abs(sample2);\n\n  // Compute the median alpha value. This small median filter is necessary for robustness in the cases of\n  // single-pixel cracks or rasterization errors that can sometimes appear on large assemblies.\n  vec4 selectedSample = sample1;\n  if ((sample1.a <= sample0.a && sample0.a <= sample2.a) ||\n      (sample2.a <= sample0.a && sample0.a <= sample1.a)) {\n    selectedSample = sample0;\n  } else if ((sample0.a <= sample2.a && sample2.a <= sample1.a) ||\n             (sample1.a <= sample2.a && sample2.a <= sample0.a)) {\n    selectedSample = sample2;\n  }\n\n  return selectedSample;\n}\n"},22735:function(e,t){"use strict";t.A="uniform float uSectionPlanePatternFade;\nuniform float uSectionPlanePatternThickness;\nuniform float uSectionPlanePatternPacingVariation;\nuniform float uSectionPlanePatternScale;\nuniform vec4  uSectionPlaneIntersectingColor;\nuniform vec4  uSectionPlanePreSelectColor;\nuniform vec4  uSectionPlaneSelectColor;\nuniform float uSectionPlanePatternIsBlackAndWhite;\nuniform float uSectionPlaneEndcapAlpha;\nuniform float uSectionPlaneIsPreSelected;\nuniform float uSectionPlaneIsSelected;\nuniform mat4  uSectionPlaneSelectorColor;\nuniform float uSectionPlaneIsolateContextOpacity;\nuniform float uSectionPlaneIntersectingAdditionalAlpha;\n\n#define SECTION_PLANE_SELECTOR_COLOR_MIX 0.1\n\n{{{sectionPlaneEndcapFunctions}}}\n\nfloat getColorHash(vec4 color) {\n  return mod(color.r * 1000.0, 1000.0) + mod(color.g * 1000.0, 1000.0) + mod(color.b + 1000.0, 1000.0);\n}\n\n// Maps the position of the fragment in the section plane to a sawtooth ramp from 0.0 to 1.0.\n// The direction of the hatching is determined by hashing the incoming part color.\nfloat getHatchingCycle(vec2 inPlanePosition, vec4 incomingColor, float pace) {\n  float colorHash = getColorHash(incomingColor);\n  vec2 hatchDirection = vec2(cos(colorHash), sin(colorHash));\n  float hatchDistance = dot(hatchDirection, inPlanePosition);\n  return mod(hatchDistance, uSectionPlanePatternScale * pace) / (uSectionPlanePatternScale * pace);\n}\n\n// Takes the hatching sawtooth function and runs it through a smooth step transfer function\n// that produces a step from 0.0 to 1.0 to 0.0 again. The cycle is scaled by a variable based\n// on the color. The first edge of the smooth step is set by the uSectionPlanePatternThickness.\n// The smoothness is a constant factor of the hatching scale.\nfloat getHatchingSmoothstep(vec2 inPlanePosition, vec4 incomingColor) {\n  float rolloffWidth = min(uSectionPlanePatternThickness / 2.0, 0.1);\n  float interiorWidth = uSectionPlanePatternThickness - rolloffWidth * 2.0;\n\n  float colorMod = mod(getColorHash(incomingColor), 1.0);\n  float variation = uSectionPlanePatternPacingVariation;\n  float cyclePace = mix(1.0, variation * variation, colorMod) / variation;\n\n  float cycle = getHatchingCycle(inPlanePosition, incomingColor, cyclePace);\n\n  float stepWidth = rolloffWidth / cyclePace;\n  float upEdge = 1.0 - stepWidth - interiorWidth / cyclePace;\n  float stepup = smoothstep(upEdge - stepWidth, upEdge, cycle);\n  float stepdown = 1.0 - smoothstep(1.0 - stepWidth, 1.0, cycle);\n  return (cycle < upEdge) ? stepup : stepdown;\n}\n\n// Get the hatching pattern color. If the brightest component of the incoming color is\n// small, the pattern color will be a brighter version of the incoming color, otherwise it\n// will be a darker version.\nvec4 getHatchingColor(vec2 inPlanePosition, vec4 incomingColor, out float smoothedCycle) {\n  const float DARK_THRESHOLD = 0.4;\n  const float BLACK_AND_WHITE_DARK_LEVEL = 0.4;\n\n  vec4 baseColor = mix(incomingColor, vec4(1.0, 1.0, 1.0, 1.0), uSectionPlanePatternIsBlackAndWhite);\n  float patternFade = mix(uSectionPlanePatternFade, BLACK_AND_WHITE_DARK_LEVEL, uSectionPlanePatternIsBlackAndWhite);\n\n  float maxComponent = max(baseColor.r, max(baseColor.g, baseColor.b));\n  bool incomingIsDark = maxComponent < DARK_THRESHOLD;\n\n  smoothedCycle = getHatchingSmoothstep(inPlanePosition, incomingColor);\n\n  if (incomingIsDark) {\n    float brightenAmount = mix(0.0, (1.0 - patternFade) * 2.0, smoothedCycle);\n    vec4 colorWhenIncomingIsBlack = vec4(brightenAmount, brightenAmount, brightenAmount, 1.0);\n    vec4 colorWhenIncomingIsDark = vec4(incomingColor.rgb * (1.0 + brightenAmount), 1.0);\n\n    return mix(colorWhenIncomingIsBlack, colorWhenIncomingIsDark, maxComponent / DARK_THRESHOLD);\n  } else {\n    float darkenAmount = mix(1.0, patternFade, smoothedCycle);\n    return vec4(baseColor.rgb * darkenAmount, 1.0);\n  }\n}\n\nvec4 getSectionPlaneColor(vec4 selector, vec3 position, vec4 incomingColor, out float hatchingOpacity) {\n\n  float alpha = incomingColor.a;\n  vec2 outsideIsolationCountAndTotalPartCount = getIsolateAndInterferenceInfoFromAlpha(alpha);\n  float outsideIsolationCount = outsideIsolationCountAndTotalPartCount[0];\n  float partCount = outsideIsolationCountAndTotalPartCount[1];\n  float higherBits = (outsideIsolationCount * outsideIsolationOrder) + (partCount * partCountOrder);\n  float finalAlphaColor = clamp(alpha - higherBits, 0.0, 1.0);\n  float isolatedCount = partCount - outsideIsolationCount;\n  if (isolatedCount == 0.0)\n  {\n    finalAlphaColor *= uSectionPlaneIsolateContextOpacity;  // If all parts are outside isolation, mute them\n  }\n\n  float isIntersecting = 0.0;\n  if (partCount > 1.0) {\n    isIntersecting = 1.0;\n    finalAlphaColor = clamp(finalAlphaColor + uSectionPlaneIntersectingAdditionalAlpha, 0.0, 1.0);\n  }\n\n  vec3 center, uAxis, vAxis;\n  getSectionPlaneFrame(selector, center, uAxis, vAxis);\n\n  vec3 offset = position - center;\n  vec2 texCoord = vec2(dot(uAxis, offset), dot(vAxis, offset));\n\n  vec4 hatchingColor = getHatchingColor(texCoord, incomingColor, hatchingOpacity);\n  vec4 unselectedColor = mix(hatchingColor, uSectionPlaneIntersectingColor, isIntersecting);\n  unselectedColor = mix(unselectedColor, selector * uSectionPlaneSelectorColor, SECTION_PLANE_SELECTOR_COLOR_MIX);\n\n  vec4 preselectedColor = mix(unselectedColor, uSectionPlanePreSelectColor, uSectionPlaneIsPreSelected * uSectionPlanePreSelectColor.a);\n  vec4 selectedColor = mix(preselectedColor, uSectionPlanePreSelectColor, uSectionPlaneIsSelected * uSectionPlaneSelectColor.a);\n  return vec4(selectedColor.rgb, finalAlphaColor * uSectionPlaneEndcapAlpha);\n}\n"},578:function(e,t){"use strict";t.A="{{{sectionPlaneClippingFunctions}}}\n\n#if defined(USE_SECTION_PLANES) && !defined(SKIP_SECTION_PLANES)\n\nvoid discardIfPositionFailsSectionPlaneClippingTest(vec3 position) {\n  if (!passesSectionPlaneClippingTest(position)) {\n    discard;\n  }\n}\n\nvoid discardIfPositionFailsNormalSectionPlaneClippingTest(vec3 position) {\n  if (!passesNormalSectionPlaneClippingTest(position)) {\n    discard;\n  }\n}\n\nvoid discardIfPositionFailsAllButOneSectionPlaneClippingTest(vec3 position, vec4 selector) {\n  if (!passesAllButOneSectionPlaneClippingTest(position, selector)) {\n    discard;\n  }\n}\n\n#define DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(x) discardIfPositionFailsSectionPlaneClippingTest(x)\n\n#define DISCARD_IF_POSITION_FAILS_NORMAL_SECTION_PLANE_CLIPPING_TEST(x) discardIfPositionFailsNormalSectionPlaneClippingTest(x)\n\n#define DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(x, y) discardIfPositionFailsAllButOneSectionPlaneClippingTest(x, y)\n\n#else\n\n#define DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(x)\n\n#define DISCARD_IF_POSITION_FAILS_NORMAL_SECTION_PLANE_CLIPPING_TEST(x)\n\n#define DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(x, y)\n\n#endif\n\n\n"},12065:function(e,t){"use strict";t.A="// These attributes and varyings mimic two mat4 matrices with 4 vec4 varyings.  From the CPU client perspective\n// the attributes are bound the same.  However, some GPU drivers do not appear to handle mat4 attributes and varyings\n// properly.  (See BEL-188540)\n\nVERT_IN vec4 aContactTraction;\nVERT_IN vec4 aContactTraction1;\nVERT_IN vec4 aContactTraction2;\nVERT_IN vec4 aContactTraction3;\n\nVERT_IN vec4 aContactPairCoordinate;\nVERT_IN vec4 aContactPairCoordinate1;\nVERT_IN vec4 aContactPairCoordinate2;\nVERT_IN vec4 aContactPairCoordinate3;\n\nVERT_OUT vec4 vContactTraction;\nVERT_OUT vec4 vContactTraction1;\nVERT_OUT vec4 vContactTraction2;\nVERT_OUT vec4 vContactTraction3;\n\nVERT_OUT vec4 vContactPairCoordinate;\nVERT_OUT vec4 vContactPairCoordinate1;\nVERT_OUT vec4 vContactPairCoordinate2;\nVERT_OUT vec4 vContactPairCoordinate3;\n\n#define CUSTOM_VARYING_SETTINGS \\\n  vContactTraction = aContactTraction;      \\\n  vContactTraction1 = aContactTraction1;     \\\n  vContactTraction2 = aContactTraction2;     \\\n  vContactTraction3 = aContactTraction3;     \\\n  vContactPairCoordinate = aContactPairCoordinate;  \\\n  vContactPairCoordinate1 = aContactPairCoordinate1; \\\n  vContactPairCoordinate2 = aContactPairCoordinate2; \\\n  vContactPairCoordinate3 = aContactPairCoordinate3;\n"},36650:function(e,t){"use strict";t.A='// This file contains the body of a function that can be parameterized with macros.  The function will sample\n// in the neighborhood around the fragment being shaded by fs-draw-draftAnalysis.glsl.  The samples it is taking are\n// whether or not a given location is undercut.  The body will return a weight that can be used to shade the fragment\n// with a corresponding contribution from the undercut color.  The result is akin to doing percentage-closer shadow\n// filtering on a shadow map.\n// The macros that can be configured are:\n//\n//   FILTER_RADIUS - the "radius" of the box filter in each direction of the draft shadow map texture. The total\n//   number of samples in each direction is 2*FILTER_RADIUS + 1\n//\n//   SAMPLE_BIAS_FACTOR - this biases the number of undercut samples in order to negate some sampling errors that result\n//   from aliasing in the shadow map.  For example, a bias of 0.75 means that three quarters of the samples need be\n//   classified as undercut before the fragment is considered to be undercut.  A value of 0.5, is a lower threshold and\n//   only half the samples need to be classified as undercut for the fragment to be considered undercut.  After the\n//   bias is applied, the remainder of the sample magnitude is utilized to provide a smooth transition in weights from\n//   0.0 (no undercut) to 1.0 (full undercut)\n\n  vec3 with = sampleLocation(uPMVMatrixWith);\n  vec3 against = sampleLocation(uPMVMatrixAgainst);\n\n  vec2 withLocation = with.xy;\n  vec2 againstLocation = against.xy;\n  float withDepth = with.z;\n  float againstDepth = against.z;\n\n  float undercutSamples = 0.0;\n\n  float shadowBias = max(0.003 * (1.0 - normalDotDraftDirection), 0.0001);\n\n  float totalSamples = (2.0 * FILTER_RADIUS + 1.0) * (2.0 * FILTER_RADIUS + 1.0);\n  for (float x = -FILTER_RADIUS; x <= FILTER_RADIUS; x += 1.0) {\n    for (float y = -FILTER_RADIUS; y <= FILTER_RADIUS; y += 1.0) {\n      vec4 textureSample = TEXTURE_2D(uDraftShadowMap, vec2(withLocation.x + x * uDraftShadowMapPixelWidth, withLocation.y + y * uDraftShadowMapPixelHeight));\n      if (withDepth - shadowBias > textureSample[0] && againstDepth - shadowBias > textureSample[1]) {\n        undercutSamples += 1.0;\n      }\n    }\n  }\n\n  float sampleBias = totalSamples * SAMPLE_BIAS_FACTOR;\n  return clamp((undercutSamples - sampleBias) / (totalSamples - sampleBias), 0.0, 1.0);\n'},57445:function(e,t){"use strict";t.A="// square root of 2\n#define SQRT2 1.41421356237\n\n// full circle in radians\n#define TAU 6.28318530718\n\n// 1.0 / 255.0\n#define ONE_255 0.0039215686\n\n// 0.5 / 255.0\n#define HALF_255 .0019607843\n\n// A constant to convert from a fraction of a byte to a normalized float between 0 and 1.0.  This is useful\n// for creating byte encodings in color channels.  It equates to 256.0 / 255.0\n#define BYTE_FRACTION_TO_NORMALIZED_FLOAT 1.0039215686\n\n// An epsilon value to avoid division by zero.\n#define EPSILON 0.000001\n\n// used in weight functions for faster computation of standard powers\n#define SQUARED(x) ((x)*(x))\n#define CUBED(x) ((x)*(x)*(x))\n#define FOURTH_POWER(x) ((x)*(x)*(x)*(x))\n\n// Avoid clash with ES 3.00 built-in round()\n#ifdef WEBGL1\n  float round(float value) {\n    // return the value rounded to the nearest integer\n    return floor(value + 0.5);\n  }\n#endif\n\nfloat impulse(float value, float variable) {\n  // return the Dirac delta function at value for variable (1 iff variable == value, 0 otherwise)\n  return step(value, variable) * step(-value, -variable);\n}\n\n// Slop factor to work around imprecise calculations on some amd cards/drivers.  1 / 256 is the closest a number\n// can be to 0.5 in the isBitSet calculation and still _not_ have the bit set (i.e., the bit field is 0x7F and\n// we are checking to see if bit 8 is set).  For that case, we take half the minimum distance: 0.5 / 255\n#define HALF_256 0.001953125\n\n/**\n * Determines if the given bit is set in the normalizedFlags variable\n * @param normalizedFlags a number in the range 0-1.0 that comes from a normalized 8-bit attribute\n * @param bitShiftMultiplier a constant that will shift the normalized value such that the fractional component can be used to determine if the bit is set\n */\nbool isBitSet(float normalizedFlags, float bitShiftMultiplier) {\n  float shifted = normalizedFlags * bitShiftMultiplier;\n  // If the fractional portion is greater than or equal to 0.5, the bit is set.\n  // We use a greater than comparison with a tolerance to work around precision issues on some AMD drivers.\n  return (shifted - floor(shifted)) > 0.5 - HALF_256;\n}\n\n// Helper macros that setup bit tests for different bits.  For bit N, the multiplier is 255 / 2^N\n#define IS_BIT_1_SET(normalizedFlags) isBitSet(normalizedFlags, 255.0 / 2.0)\n\nbool interiorHighlightIsSuppressed(float normalizedFlags) {\n    return isBitSet(normalizedFlags, 255.0 / 4.0);\n}\n\n/**\n * Compare two numbers with the given tolerance.\n * @return True if the difference between the numbers is less than the tolerance\n */\nbool compareWithTolerance(float number1, float number2, float tolerance) {\n  return abs(number1 - number2) < tolerance;\n}\n\n// Returns a grayscale value for the given rgb color\nvec3 rgbToGrayscale(vec3 rgb) {\n  // Coefficients found here:  http://www.tannerhelland.com/3643/grayscale-image-algorithm-vb6/\n  float gray = rgb.r * 0.299 + rgb.g * 0.587 + rgb.b * 0.114;\n  return vec3(gray, gray, gray);\n}\n\n// Avoid clash with ES 3.00 built-in modf()\n#ifdef WEBGL1\n  // Splits the given value into whole and fractional components\n  float modf(float value, out float whole) {\n    whole = floor(value);\n    return value - whole;\n  }\n#endif\n\n\nvec2 getNearFar(mat4 uPMatrix) {\n    vec2 nearFar;\n    float a = uPMatrix[2][2];\n    float b = uPMatrix[3][2];\n    float nearOrthographic = (b + 1.0) / a;\n    float farOrthographic = (b - 1.0) / a;\n    float nearPerspective = b / (a - 1.0);\n    float farPerspective = b / (a + 1.0);\n    nearFar.x = uPMatrix[3][3] * nearOrthographic - uPMatrix[2][3] * nearPerspective;\n    nearFar.y = uPMatrix[3][3] * farOrthographic - uPMatrix[2][3] * farPerspective;\n    return nearFar;\n}\n\n// Functions from http://lolengine.net/blog/2013/07/27/rgb-to-hsv-in-glsl\nvec3 rgb2hsv(vec3 c) {\n    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);\n    vec4 p = c.g < c.b ? vec4(c.bg, K.wz) : vec4(c.gb, K.xy);\n    vec4 q = c.r < p.x ? vec4(p.xyw, c.r) : vec4(c.r, p.yzx);\n\n    float d = q.x - min(q.w, q.y);\n    float e = 1.0e-10;\n    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\n}\n\nvec3 hsv2rgb(vec3 c) {\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\n/**\n * Blends sourceColor on top of destinationColor and returns the result.  This achieves a similar effect to\n * using gl.blendFuncSeparate(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA, gl.ONE, gl.ONE_MINUS_SRC_ALPHA);\n */\nvec4 blendColors(vec4 destinationColor, vec4 sourceColor) {\n    destinationColor.rgb = clamp(destinationColor.rgb * (1.0 - sourceColor.a) + sourceColor.rgb * sourceColor.a, 0.0, 1.0);\n    destinationColor.a = clamp(destinationColor.a * (1.0 - sourceColor.a) + sourceColor.a, 0.0, 1.0);\n    return destinationColor;\n}\n\n// Translates a vector to normal space coords for visualizing direction. This is intended for debug purposes.\nvec3 vecToNormalSpace(vec3 v) {\n    return vec3(.5) + (normalize(v) * .5);\n}"},40857:function(e,t){"use strict";t.A="VERT_IN vec4 aPickId;\n\n{{{picking}}}\n\nvec4 getPickingId() {\n  return encodePickingId(uOccurrenceId, aPickId);\n}\n"},12431:function(e,t){"use strict";t.A="\nuniform float uOccurrenceId;\n\n#define OFF_SCREEN_POSITION vec4(5.0, 5.0, 5.0, 1.0)\n\nvec2 ndcToScreen(vec4 ndc, vec4 viewport) {\n  return vec2((ndc.x * 0.5 + 0.5) * viewport[2],\n              (ndc.y * 0.5 + 0.5) * viewport[3]);\n}\n"},66908:function(e,t){"use strict";t.A="{{{compatibility}}}\n\n{{{setContactVaryings}}}\n{{{vs-OITAccumulation}}}\n"},10036:function(e,t){"use strict";t.A="{{{vs-OITAccumulation}}}"},63818:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nVERT_OUT FRAGMENT_PRECISION vec3 vModelPosition;\n#define CUSTOM_VARYING_SETTINGS vModelPosition = aVertexPosition;\n\n{{{vs-OITAccumulation}}}\n"},99885:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform vec3 uSpecular;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\nuniform float uTintFactor;\nuniform vec3 uTintColor;\nuniform bool uApplyTranslucentAlphaToAll;\nuniform float uTranslucentPassAlpha;\nuniform float uIsolateTranslucentAlpha;\n\nuniform float uHighlightSpecularContribution;\n\nuniform bool uOutsideIsolation;\nuniform float uIsolateContextOpacity;\n\nVERT_IN vec3 aVertexPosition;\nVERT_IN vec3 aVertexNormal;\nVERT_IN vec2 aTextureCoordinate;\nVERT_IN vec4 aVertexColor;\nVERT_IN vec4 aHighlightId;\n\n#ifndef CUSTOM_VARYING_SETTINGS\n#define CUSTOM_VARYING_SETTINGS\n#endif\n\nVERT_OUT vec3 vPosition;\nVERT_OUT lowp vec3 vNormal;\nVERT_OUT mediump vec2 vTextureCoordinate;\nVERT_OUT lowp vec3 vAmbient;\nVERT_OUT lowp vec3 vDiffuse;\nVERT_OUT lowp vec3 vSpecular;\nVERT_OUT lowp float vOpacity;\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n  CUSTOM_VARYING_SETTINGS\n\n  vec4 position = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = position.xyz;\n\n  vNormal = mat3(uMVMatrix) * aVertexNormal;\n  vTextureCoordinate = aTe