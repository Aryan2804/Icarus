e, maskTextureCoordinates(gl_FragCoord.xy));\n    vec4 sample2 = TEXTURE_2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(1.0, 0.0)));\n\n    vec4 selectedSample = medianFilterEndcapSamples(sample0, sample1, sample2);\n\n    // This test uses a soft threshold to deal with possible numerical imprecision where adding and subtracting\n    // the same values doesn't result in a zero. The threshold value is chosen to be an invisible alpha level.\n    if (selectedSample.a < 0.001) {\n        discard;\n    }\n\n    vec2 outsideIsolationCountAndTotalPartCount = getIsolateAndInterferenceInfoFromAlpha(selectedSample.a);\n    if (outsideIsolationCountAndTotalPartCount[0] == outsideIsolationCountAndTotalPartCount[1])\n    {\n        discard;\n    }\n\n    vec4 pickingColor = encodePickingId(uOccurrenceId, vec4(0.0, 0.0, 0.0, 1.0));\n    FRAG_COLOR = pickingColor;\n}\n"},68732:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nDECLARE_FRAG_COLOR\n\nFRAG_IN lowp  vec4 vPickingIndex;\nFRAG_IN highp vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    FRAG_COLOR = vPickingIndex;\n}\n"},58253:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN lowp vec4 vPickingIndex;\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    FRAG_COLOR = vPickingIndex;\n}\n"},14578:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform vec4 uViewport;\nuniform int uDoSetTest;\nuniform sampler2D uPlaneIdSetBuffer;\n\nFRAG_IN vec3 vPositionForSection;\nFRAG_IN vec4 vVertexColor;\n\n{{{planeIdFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n    if (uDoSetTest > 0) {\n        vec4 compareSample = TEXTURE_2D(uPlaneIdSetBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n        if (!isPlaneInSet(vVertexColor, compareSample)) {