)) ? \'expanded\' : \'collapsed\'}}"/>\n              </div>\n              <os-svg ng-if="configParam.getIsCosmetic()" class="cosmetic-icon" icon="configuration-exclude-properties"\n                data-bs-original-title="{{\'tooltips:::Excluded from affecting configured properties\' | i18next}}"></os-svg>\n              <div class="config-param-name" data-bs-placement="top" data-bs-original-title="{{configParam.getDisplayName()}}">\n                {{configParam.getDisplayName()}}\n              </div>\n              <div ng-if="$ctrl.showWarningIcon(configParam.getParameterId())" class="flex-even-spacing h-100">\n                <os-svg class="param-warn-icon" icon="performance-warning"\n                  data-bs-original-title="{{\'Some options do not have an option rule. They will always be hidden.\' | i18next}}"\n                  data-bs-placement="right" />\n              </div>\n              <div ng-if="!$ctrl.getIsExpanded(configParam.getParameterId())" class="condition-summary-text w-90"\n                data-bs-original-title="{{$ctrl.getParameterVisibilityText(configParam.getParameterId())}}">\n                {{$ctrl.getParameterVisibilityText(configParam.getParameterId())}}\n              </div>\n            </div>\n          </div>\n\n          <div ng-if="$ctrl.getIsExpanded(configParam.getParameterId())">\n            \x3c!-- Section to build a parameter visibility statement --\x3e\n            <div ng-if="$ctrl.getParameterVisibilityStatement(configParam.getParameterId())"\n              class="flex-even-spacing mb-2"\n              data-automation="visibility-condition-row"\n              data-row={{$index}}\n              >\n              <visibility-condition-statement class="w-100" statement="$ctrl.getParameterVisibilityStatement(configParam.getParameterId())" config-param="configParam"\n                get-config-params-for-setting-visibility-condition="$ctrl.getConfigParamsForSettingParameterVisibilityCondition(parameterId, conditionIndex)"