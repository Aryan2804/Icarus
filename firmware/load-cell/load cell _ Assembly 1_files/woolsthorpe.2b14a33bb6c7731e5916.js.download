vec4 uHighlightColor1;\nuniform vec4 uHighlightColor2;\nuniform vec4 uHighlightColorBorder;\nuniform float uInteriorHighlightOpacity;\nuniform int uOutlineOverlappingInteriorRegions;\n\n// Indicates whether or not the interior parts of the selection should be hidden.\nuniform int uHideSelectionInterior;\n\n// The total number of samples in the neighborhood:\n#define TOTAL_SAMPLES 4\n\n// A distance that is outside of the neighborhood of samples\n#define DISTANCE_BEYOND_NEIGHBORHOOD 10000.0\n\n// Highlight ids are not decoded exactly.  Hence we need to compare them with some tolerance.\n#define COMPARE_TOLERANCE 0.01\n\n{{{utilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\n// Take the information from the highlight buffer sample to reconstruct an id for the highlight.  The goal is to\n// wind up with the same id for fragments that have been touched by the same combinations of highlights.\nfloat getSampleId(vec4 textureSample) {\n  // We need to divide by the number of crossings so that the same highlight that accumulated its same id several\n  // times will be equivalent to an adjacent highlight that is the same, but crossed a different number of times.\n  // Some samples will have zero crossings - so we will set those samples to divide by the minimum number of crossings\n  // a highlight can have (other than zero).\n  return (16.0 * textureSample[1] + textureSample[2]) / max(ONE_255, textureSample[3]);\n}\n\nbool isNumberWhole(float number) {\n  return abs(floor(number + 0.5) - number) < COMPARE_TOLERANCE;\n}\n\nvoid main(void) {\n\n  // Sample locations contains the x, y offset from the center of the pixel.  The z-component contains the length\n  // of the offset.  This is pre-computed for efficiency's sake.\n  vec3 sampleLocations[TOTAL_SAMPLES];\n  sampleLocations[0] = vec3(-1.0, -1.0, 1.41421356237);\n  sampleLocations[1] = vec3(-1.0, 1.0, 1.41421356237);\n  sampleLocations[2] = vec3(1.0, -1.0, 1.41421356237);\n  sampleLocations[3] = vec3(1.0, 1.0, 1.41421356237);\n\n  // Get the highlight index (r channel), id (g, b channels) and count (a channel) from the highlight buffer\n  vec4 centralSample = TEXTURE_2D(uHighlightBuffer, vTextureCoordinate);\n\n  // By default the color will be totally transparent, unless the pixel is near or on a highlight\n  FRAG_COLOR = vec4(uHighlightColor1.rgb, 0.0);\n\n  // Sample within a radius of this pixel to determine if we're near the edge of the highlight\n  float distance = DISTANCE_BEYOND_NEIGHBORHOOD;\n  float centralId =  getSampleId(centralSample);\n  bool centralWhole = isNumberWhole(centralId);\n\n  for (int i = 0; i < TOTAL_SAMPLES; ++i) {\n    vec2 offset = sampleLocations[i].xy / uViewport.zw;\n    vec2 uv = vTextureCoordinate + offset;\n    vec4 textureSample = TEXTURE_2D(uHighlightBuffer, uv);\n    float sampleId =  getSampleId(textureSample);\n    // Put the border on fragments that are on the outside of highlighted regions.  We can find the outsides by\n    // comparing the number of crossings (in the alpha channel).  We also want to put a border around highlights\n    // with different ids - so we will compare the id channels to see if they are different.\n\n    if (!compareWithTolerance(centralId, sampleId, COMPARE_TOLERANCE) &&\n       (centralWhole || isNumberWhole(sampleId) || uOutlineOverlappingInteriorRegions != 0)) {\n      distance = min(distance, sampleLocations[i].z);\n    }\n  }\n\n  // Color the interior of the highlight if it is not set to be hidden.\n  if (centralSample.a > 0.0 && uHideSelectionInterior != 1) {\n    // The mask value will be zero if the highlight is occluded, 1.0 otherwise. If the fragment  is not occluded,\n    // we can color the fragment based on how many highlights are in this fragment.\n    float occlusionMask = TEXTURE_2D(uHighlightMask, vTextureCoordinate).r;\n\n    FRAG_COLOR = vec4(uHighlightColor1.rgb, uHighlightColor1.a * uInteriorHighlightOpacity);\n\n    FRAG_COLOR.a = mix(0.0, FRAG_COLOR.a, occlusionMask);\n  }\n\n  // If this fragment is near the border of the highlight, draw a line\n  if (distance < DISTANCE_BEYOND_NEIGHBORHOOD) {\n    FRAG_COLOR = uHighlightColorBorder;\n  }\n}\n"},93513:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN lowp float vHighlighted;\nFRAG_IN highp vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    // The value of the fragment should take on the highlight value of the primitive.  The last fragment to pass\n    // the depth test will determine if a highlight was visible, or not.\n    FRAG_COLOR = vec4(vHighlighted, vHighlighted, vHighlighted, 1.0);\n}\n"},6581:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform FRAGMENT_PRECISION_OPTIONAL mat4 uPMatrix_fs;\nFRAG_IN vec3 vPosition;\nFRAG_IN vec3 vNormal;\nFRAG_IN FRAGMENT_PRECISION_OPTIONAL float vDepth;\n\nDECLARE_FRAG_COLOR\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{depthNormalFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec2 encNormal = encodeNormal(flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs));\n    vec2 encDepth  = encodeDepth(vDepth);\n\n    FRAG_COLOR = vec4(encNormal, encDepth);\n}\n"},28856:function(e,t){"use strict";t.A='{{{compatibility}}}\n\nDECLARE_FRAG_COLOR\n\nuniform mediump vec4 uViewport;\nuniform sampler2D uNormalDepthTexture;\n\n{{{depthNormalFunctions}}}\n\n// Median operations based on: http://graphics.cs.williams.edu/papers/MedianShaderX6/\n// Copyright notice:\n// Copyright (c) Morgan McGuire and Williams College, 2006\n// All rights reserved.\n//\n// Redistribution and use in source and binary forms, with or without\n// modification, are permitted provided that the following conditions are\n// met:\n//\n// Redistributions of source code must retain the above copyright notice,\n// this list of conditions and the following disclaimer.\n//\n// Redistributions in binary form must reproduce the above copyright\n// notice, this list of conditions and the following disclaimer in the\n// documentation and/or other materials provided with the distribution.\n//\n// THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\n// "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT\n// LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\n// A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT\n// HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,\n// SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT\n// LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,\n// DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\n// THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n// (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\n// OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n\n#define s2(a, b)                tempD = d[a]; d[a] = min(d[a], d[b]); d[b] = max(tempD, d[b]); tempN = n[a]; n[a] = min(n[a], n[b]); n[b] = max(tempN, n[b]);\n#define mn3(a, b, c)            s2(a, b); s2(a, c);\n#define mx3(a, b, c)            s2(b, c); s2(a, c);\n\n#define mnmx3(a, b, c)          mx3(a, b, c); s2(a, b);                                    // 3 exchanges\n#define mnmx4(a, b, c, d)       s2(a, b); s2(c, d); s2(a, c); s2(b, d);                    // 4 exchanges\n#define mnmx5(a, b, c, d, e)    s2(a, b); s2(c, d); mn3(a, c, e); mx3(b, d, e);            // 6 exchanges\n#define mnmx6(a, b, c, d, e, f) s2(a, d); s2(b, e); s2(c, f); mn3(a, b, c); mx3(d, e, f);  // 7 exchanges\n\n/**\n * Decodes depth and normal for adjacent pixels then find the median of them and re-encodes the median in the\n * returned value.\n */\nvec4 median() {\n  vec3 n[9];  // normals\n  float d[9]; // depths\n\n  for(int dX = -1; dX <= 1; ++dX) {\n    for(int dY = -1; dY <= 1; ++dY) {\n      vec2 offset = vec2(float(dX), float(dY));\n      vec2 uv = (gl_FragCoord.xy + offset - uViewport.xy) / uViewport.zw;\n      vec4 textureSample = TEXTURE_2D(uNormalDepthTexture, uv);\n      n[(dX + 1) * 3 + (dY + 1)] = decodeNormal(textureSample.xy);\n      d[(dX + 1) * 3 + (dY + 1)] = decodeDepth(textureSample.zw);\n    }\n  }\n\n  vec3 tempN;\n  float tempD;\n\n  mnmx6(0, 1, 2, 3, 4, 5);\n  mnmx5(1, 2, 3, 4, 6);\n  mnmx4(2, 3, 4, 7);\n  mnmx3(3, 4, 8);\n\n  vec4 result;\n  result.xy = encodeNormal(n[4]);\n  result.zw = encodeDepth(d[4]);\n\n  return result;\n}\n\nvoid main(void) {\n  FRAG_COLOR = median();\n}\n'},8161:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\n\n{{{normalDepthWithMaskFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    discardIfDepthMatchesMask();\n\n    FRAG_COLOR = encodeDepthWithZeroNormalColor();\n}\n"},3333:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform mat4 uPMatrix_fs;\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\nFRAG_IN FRAGMENT_PRECISION vec3 vNormal;\n\n{{{normalDepthWithMaskFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec3 facingNormal = flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs);\n    discardIfNormalDepthMatchesMask(facingNormal);\n\n    FRAG_COLOR = encodeNormalDepthColor(facingNormal);\n}\n"},49822:function(e,t){"use strict";t.A="{{{compatibility}}}\n\n{{{normalDepthWithMaskFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    discardIfDepthMatchesMask();\n\n    FRAG_COLOR = encodeDepthWithZeroNormalColor();\n}\n"},68180:function(e,t){"use strict";t.A="{{{compatibility}}}\n\n{{{depthNormalFunctions}}}\n\nuniform FRAGMENT_PRECISION_OPTIONAL mat4 uPMatrix_fs;\nuniform FRAGMENT_PRECISION_OPTIONAL mat4 uPMatrixInv_fs;\nuniform vec4 uViewport;\nuniform float uTest;\n\nFRAG_IN vec2 vTextureCoordinate;\nFRAG_IN vec2 vExtent;  // near distance and depth extent of the object\n\nuniform sampler2D uNormalDepthTexture;\nuniform sampler2D uRandomTexture;\nuniform vec2 uRandomTextureScale;\n\nuniform float uRadiusNear;\nuniform float uRadiusFar;\nuniform float uIntensity;\nuniform float uBias;\nuniform float uScale;\n\n#define nRadial 5  // number of occlusion sample rings\n#define nAngular 5  // number of occlusion samples per ring\n#define minResolution 2e-4  // smallest step in normalized depth\n\nDECLARE_FRAG_COLOR\n\nfloat getDepth(vec2 pixel) {\n  vec2 encodedDepth = TEXTURE_2D(uNormalDepthTexture, (pixel - uViewport.xy) / uViewport.zw).zw;\n  float depth = decodeDepth(encodedDepth);\n  return depth;\n}\n\nvec3 getPosition(vec2 pixel, float depth) {\n  float zView = -(vExtent[0] + vExtent[1] * depth);\n  float w = uPMatrix_fs[2][3] * zView + uPMatrix_fs[3][3];\n  vec3 ndc = 2.0 * vec3(pixel / uViewport.zw, depth) - 1.0;\n  vec4 position = uPMatrixInv_fs * vec4(w * ndc, w);\n  return position.xyz;\n}\n\nvec3 getPosition(vec2 pixel) {\n  float depth = getDepth(pixel);\n  return getPosition(pixel, depth);\n}\n\nfloat getOcclusion(vec2 pixel, vec3 position0, vec3 normal0) {\n  vec3 position = getPosition(pixel);\n  vec3 diff = position - position0;\n  float len = length(diff);\n  float dist = uScale * len / vExtent[1];\n  float occlusion = uIntensity * max(0.0, (dot(normal0, diff) - minResolution * vExtent[1]) / len - uBias) / (1.0 + dist * dist);\n  return occlusion;\n}\n\nvoid main(void) {\n    vec4 normalDepth = TEXTURE_2D(uNormalDepthTexture, vTextureCoordinate);\n    vec3 normal = decodeNormal(normalDepth.xy);\n    float depth = decodeDepth(normalDepth.zw);\n    vec3 position = getPosition(gl_FragCoord.xy, depth);\n\n\n    // loop through samples that define occlusion\n    float random = TEXTURE_2D(uRandomTexture, vTextureCoordinate * uRandomTextureScale).r;\n    float occlusion = 0.0;\n    float radiusMax = uRadiusNear + (uRadiusFar - uRadiusNear) * depth;\n    float radiusMin = radiusMax / float(nRadial);\n    float angleStep = 6.2831853 / float(nAngular);\n    float angle = 6.2831853 * random;  // randomly rotate the sampling rings\n    for (int i = 0; i < nRadial; ++i) {\n      float radius = radiusMin * float(i + 1);\n\n      for (int j = 0; j < nAngular; ++j) {\n        vec2 offset = radius * vec2(cos(angle), sin(angle));\n        occlusion += getOcclusion(gl_FragCoord.xy + offset, position, normal);\n        angle += angleStep;\n      }\n      angle -= angleStep / 2.0;  // ensure we hit the in-between samples in the next ring\n    }\n    occlusion /= float(nRadial * nAngular);\n    occlusion *= float(depth < 1.0);\n    FRAG_COLOR = vec4(occlusion, 0.0, 0.0, 1.0);\n}\n"},37837:function(e,t){"use strict";t.A="\n{{{compatibility}}}\n\nuniform vec4 uViewport;\nuniform sampler2D uOcclusionMap;\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    #define uFilterRadius 2\n\n    float occlusion = 0.0;\n    float count = 0.0;\n\n    for (int x = -uFilterRadius; x <= uFilterRadius; ++x) {\n      for (int y = -uFilterRadius; y <= uFilterRadius; ++y) {\n        vec2 offset = vec2(float(x), float(y));\n        vec2 uv = (gl_FragCoord.xy + offset - uViewport.xy) / uViewport.zw;\n        float occlusionSample = TEXTURE_2D(uOcclusionMap, uv).r;\n        float weight = 1.0 / (1.0 + dot(offset, offset));\n        occlusion += weight * occlusionSample;\n        count += weight;\n      }\n    }\n    occlusion /= count;\n\n    FRAG_COLOR = vec4(occlusion, 0.0, 0.0, 1.0);\n}\n"},85374:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN lowp vec4 vColor;\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    FRAG_COLOR = vColor;\n}\n"},57246:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN lowp vec4 vPickingIndex;\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nv