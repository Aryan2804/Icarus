/os-svg>\n      </a>\n      <div class="form-group" ng-if="isCAMToolPathExport()">\n        <label class="control-label">{{ \'Program number\' | i18next }}</label>\n        <input class="form-control" id="export-programname-input" type="number" name="programName" ng-required="true" step ="1" ng-trim="true" min="0" max="{{ CAM_MAX_PROGRAM_NUMBER }}" ng-model="program.name">\n        <span class="text-danger export-filename-error" ng-show="exportForm.programName.$invalid">{{ "Valid program number is required." | i18next }}</span>\n      </div>\n      <div class="form-group">\n        <label class="control-label" ng-if="!isCAMToolPathExport() && isMultiElementExport()">{{ \'Zip file name\' | i18next }}</label>\n        <label class="control-label" ng-if="!isMultiElementExport()">{{ \'File name\' | i18next }}</label>\n        <a class="export-rules-link" ng-if="!isCAMToolPathExport() && shouldShowExportRulesLink()" href="{{ exportRulesSettingsLink }}" target="_blank">{{ "View export rules" | i18next }}</a>\n        <span class="no-space-info" ng-show="options.format.name === \'OBJ\'">{{ "(OBJ names using spaces may not be supported by other systems)" | i18next }}</span>\n        <input class="form-control" id="export-filename-input" type="text" name="fileName" ng-change="onFileNameChangedByUser()" ng-required="true" ng-trim="true" maxlength="{{ MAX_INPUT_LENGTHS.name }}" ng-model="file.name" bt-focus="true">\n        <span class="text-danger export-filename-error" ng-show="exportForm.fileName.$invalid">{{ "Valid file name is required." | i18next }}</span>\n      </div>\n      <div class="form-group" ng-if="isCAMToolPathExport()">\n          <label class="control-label">{{ \'Machine model and post processor\' | i18next }}</label>\n          <input class="form-control" id="export-machinepost-input" ng-disabled="true" type="text" name="machinepostName" ng-trim="true" maxlength="{{ MAX_INPUT_LENGTHS.name }}" ng-model="machinepost.name">\n      </div>\n      <div class="form-group" ng-if="!isCAMToolPathExport()">\n        <label class="control-label">{{ "Format" | i18next }}</label>\n        <select tabindex="1" id="export-format-dropdown" class="form-control" ng-model="options.format"\n                ng-change="onFormatChanged()" ng-options="p.displayName || p.name for p in formats"></select>\n        <label class="csv-export-message" ng-show="options.format.name === \'INSPECTION_LIST\'">{{ "Exported csv file will contain an ordered list of all inspection symbols." | i18next }}</label>\n      </div>\n      <div class="alert alert-warning" ng-if="showDeprecatedExportWarning()">\n          <os-svg class="add-space-bottom" icon="performance-warning"></os-svg>\n          <span class="error-message">\n            {{ \'Export support for __formatName__ will be deprecated as of May 4, 2026.\' | i18next:{formatName: options.format.name} }}\n          </span>\n      </div>\n      <div class="form-check" ng-show="!isCAMToolPathExport() && !isUrdfExport() && isElementNative && options.format.name !== \'INSPECTION_LIST\'">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="axis-checkbox" class="form-check-input" type="checkbox" ng-model="options.yAxisIsUp" ng-checked="options.yAxisIsUp">{{ "Export models oriented Y axis up" | i18next }}</label>\n      </div>\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'STEP\' && isStepParasolidPreprocessingEnabled">\n        <label class="control-label">{{ "Preprocessing" | i18next }}</label>\n          <select class="form-control" id="step-parasolid-preprocessing-on-read"  ng-model="options.stepParasolidPreprocessingOption"\n                  ng-options="p.value as p.name for p in stepParasolidPreprocessing"></select>\n      </div>\n      <div class="form-group" ng-show="isElementNative && isUrdfExport()">\n        <label class="control-label">{{ "Geometry format" | i18next }}</label>\n          <select class="form-control" id="urdf-geometry-format-dropdown"  ng-model="options.urdfMeshFormat"\n                  ng-options="p.value as p.name for p in urdfMeshFormatOptions"></select>\n      </div>\n\n      <div class="form-group" ng-show="isUrdfExport() && options.urdfMeshFormat == GBTUrdfMeshFormat.STL">\n        <label class="control-label">{{"STL Format" | i18next}}</label>\n        <select class="stl-export-mode form-control" ng-model="options.urdfStlEncoding" ng-options="exportMode.value as exportMode.name for exportMode in stlEncodingChoices"> </select>\n      </div>\n\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'STEP\'">\n        <label class="control-label">{{ "Version" | i18next }}</label>\n          <select class="form-control" id="step-export-version-dropdown" tabindex="2" ng-model="options.stepVersionString"\n                  ng-options="v for v in stepVersions" ng-disabled="options.useLatestStepVersion" ng-change="updateWarnMeshExport()"></select>\n      </div>\n      <div class="alert alert-warning" ng-if="!!(getMbdCompositeStepWarning() && options.format.name === \'STEP\')">\n          <os-svg class="add-space-bottom" icon="performance-warning"></os-svg>\n          <span class="error-message">\n            {{getMbdCompositeStepWarning()}}\n          </span>\n      </div>\n\n      <div class="alert alert-warning" ng-if="!!(options.format.name === \'STEP\' && (mbdInvalidAnnotationSymbolWarning = getMbdInvalidAnnotationSymbolWarning()))">\n          <os-svg class="add-space-bottom" icon="performance-warning"></os-svg>\n          <span class="error-message">\n            {{mbdInvalidAnnotationSymbolWarning}}\n          </span>\n      </div>\n\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'RHINO\'">\n        <div>\n          <label class="control-label">{{ "Version" | i18next }}</label>\n          <select class="form-control" id="export-version-dropdown" tabindex="2" ng-model="options.rhinoVersion"\n                  ng-options="v for v in rhinoVersions" ng-disabled="options.useLatestRhinoVersion"></select>\n        </div>\n      </div>\n        <div class="form-check" ng-show="isElementNative && (options.format.name === \'RHINO\')">\n          <label class="checkbox form-check-label os-export-checkbox-label">\n          <input id="latest-version-rhino-checkbox" class="form-check-input" type="checkbox" ng-model="options.useLatestRhinoVersion" ng-change="onUseLatestVersionChanged()">{{ "Use latest version" | i18next }}</label>\n        </div>\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'PARASOLID\'">\n          <label class="control-label">{{ "Version" | i18next }}</label>\n          <select class="form-control" id="export-version-dropdown" tabindex="2" ng-model="options.versionString"\n                  ng-options="v for v in parasolidVersions" ng-disabled="options.useLatestParasolidVersion"></select>\n      </div>\n      <div class="form-check" ng-show="isElementNative && (options.format.name === \'STEP\' || options.format.name === \'PARASOLID\')">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="latest-version-checkbox" class="form-check-input" type="checkbox" ng-model="useLatestVersion" ng-change="onUseLatestVersionChanged()">{{ "Use latest version" | i18next }}</label>\n      </div>\n      <div class="form-check" ng-show="allowStepUnitsExport()">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="custom-step-units-checkbox" class="form-check-input" type="checkbox" ng-model="options.useCustomUnitsForStepExport"\n               ng-change="onUseCustomUnitsForStepExportChanged()">{{ "Use custom units for export" | i18next }}</label>\n      </div>\n      <div class="form-group" ng-show="options.useCustomUnitsForStepExport && (options.format.name === \'STEP\')">\n        <label class="control-label">{{ "Units" | i18next }}</label>\n        <select class="form-control" ng-model="options.stepExportUnit" ng-options="stepUnit.unitName for stepUnit in stepUnitChoices"> </select>\n      </div>\n      <div class="form-check" ng-show="allowMBDExport()">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="include-derived-tolerances-export-checkbox" class="form-check-input" type="checkbox" ng-model="options.includeDerivedTolerances">{{ "Include derived tolerances in export" | i18next }}</label>\n      </div>\n      <div class="form-check" ng-show="allowMBDExport()">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="custom-mbd-annotation-font-height-checkbox" class="form-check-input" type="checkbox" ng-model="options.useCustomAnnotationsFontHeightForStepExport"\n          ng-change="onUseCustomAnnotationsFontHeightForStepExportChanged()">{{ "Use custom annotation text height for MBD export" | i18next }}</label>\n      </div>\n      <div class="form-group" ng-show="showAnnotationsFontHeightExportOption()">\n        <label class="control-label">{{ getAnnotationsFontHeightLabelText() }}</label>\n        <input class="form-control" type="number" name="annotationsFontHeight"  ng-model="options.annotationsFontHeightInWorkspaceUnits"\n          min="0.0001" max="50" step="any" placeholder="min 0.0001, max 50"></input>\n        <span class="text-danger export-annotationsFontHeight-error" ng-show="exportForm.annotationsFontHeight.$invalid">{{ "Valid annotations text height in range from 0.0001 to 50 is required." | i18next }}</span>\n      </div>\n      <div class="form-group" ng-show="options.format.name === \'STL\'" ng-include="\'/project/web/woolsthorpe/app/partials/exportPartsStl.html\'"></div>\n      <div class="form-group" ng-show="hasTessellationResolution()" ng-include="\'/project/web/woolsthorpe/app/partials/exportPartsWithResolution.html\'"></div>\n      <div class="form-group form-check" ng-show="options.format.name === \'IGES\'">\n        <label class="checkbox os-export-checkbox-label form-check-label">\n          <input class="form-check-input" type="checkbox" ng-model="options.useIgesCompatibilityMode" value="individual">{{ "Use compatibility mode for surfaces and curves" | i18next }}\n        </label>\n      </div>\n      <div class="form-check" ng-show="isElementNative && supportsDracoCompression()">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n          <input ng-if="options.format.name === \'GLTF\'" id="compression-checkbox" class="form-check-input" type="checkbox" ng-model="options.useGltfCompression">\n          <input ng-if="options.format.name === \'GLB\'" id="compression-checkbox" class="form-check-input" type="checkbox" ng-model="options.useGlbCompression">\n          {{"Compress" | i18next}}\n        </label>\n      </div>\n      <div class="form-group">\n        <label class="control-label">{{ "Options" | i18next }}</label>\n        <select class="form-control" id="export-options-dropdown" tabindex="3" ng-model="download.option"\n                ng-options="n as n.label disable when n.disabled for n in download.options | filter:{disabled:false}" ng-change="onChangeExportOption()"></select>\n      </div>\n      <div class="form-group form-check" ng-if="!isCAMToolPathExport() && !isUrdfExport()" id="export-multiple-file-checkbox" ng-show="!isSinglePartExport">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n          <input class="form-check-input" type="checkbox" ng-model="download.shouldExportPartsAsIndividualFiles" ng-change="onShouldExportPartsAsIndividualFilesChanged()" value="individual">{{ "Export unique parts as individual files" | i18next }}\n        </label>\n      </div>\n        \x3c!-- Duplicated the "Apply Export Rule to Contents" check box for the case of Multi Part export,\n        so that it appears as a child option of "Export unique parts as individual files" BEL-162020--\x3e\n        <div ng-if="!isCAMToolPathExport() && download.shouldExportPartsAsIndividualFiles && canApplyMultiElementOrMultiPartExportRule() && isMultiPartExport()">\n            <div class="form-group form-check multi-part-export" id="export-rule-for-multiple-part-checkbox">\n                <label class="checkbox form-check-label os-export-checkbox-label">\n                    <input class="form-check-input" type="checkbox" ng-model="download.applyExportRulesForContents" value="individual">{{ "Apply export rules to contents" | i18next }}\n                </label>\n                <a class="export-rules-link multi-export-rules-link" href="{{ exportRulesSettingsLink }}" target="_blank">{{ "View export rules" | i18next }}</a>\n            </div>\n        </div>\n      <div ng-show="!isCAMToolPathExport() && allowHiddenEntitiesExport()">\n        <div class="form-group form-check">\n          <label class="checkbox form-check-label os-export-checkbox-label">\n            <input ng-disabled="isUrdfExport()" id="export-hidden-entities-checkbox" class="form-check-input" type="checkbox" ng-model="options.includeHiddenEntities">{{ "Include hidden instances in export" | i18next }}\n          </label>\n        </div>\n        <div class="alert alert-warning" ng-if="!!hiddenEntitiesWarning && !options.includeHiddenEntities">\n          <os-svg icon="performance-warning"></os-svg>\n          <span class="error-message">\n            {{ hiddenEntitiesWarning }}\n          </span>\n        </div>\n      </div>\n      <div ng-if="!isCAMToolPathExport() && isMultiElementExport() && canApplyMultiElementOrMultiPartExportRule()">\n        <div class="form-group form-check" id="export-rule-for-multiple-file-checkbox">\n          <label class="checkbox form-check-label os-export-checkbox-label">\n            <input class="form-check-input" type="checkbox" ng-model="download.applyExportRulesForContents" value="individual">{{ "Apply export rules to contents" | i18next }}\n          </label>\n          <a class="export-rules-link multi-export-rules-link" href="{{ exportRulesSettingsLink }}" target="_blank">{{ "View export rules" | i18next }}</a>\n        </div>\n      </div>\n      <div ng-if="isEmailAttachmentOptionSelected()">\n        <div class="form-group" id="export-email-to">\n          <label class="control-label">{{ "To" | i18next }}<span class="text-danger"  data-bs-original-title="{{\'Required\' | i18next}}" data-bs-placement="right">*</span></label>\n          <os-suggestions class="add-email"\n            get-suggestions="findFriends(query)"\n            is-valid-new-suggestion="isValidEmail(query)"\n            os-input-tokens\n            on-suggestion-selected="TokenController.addToken(suggestion)"\n            placeholder="{{ \'Add recipients\' | i18next }}">\n          </os-suggestions>\n        </div>\n\n        <div class="form-group">\n          <label class="control-label">{{ "Subject" | i18next }}</label>\n          <input class="form-control" type="text" ng-trim="true" maxlength="{{ MAX_INPUT_LENGTHS.name }}" ng-model="emailAsAttachment.subject">\n        </div>\n\n        <div class="form-group">\n          <label class="control-label">{{ "Message" | i18next }}</label>\n          <span ng-if="exportForm.message.$error.maxlength" class="fst-italic text-danger">{{"Character limit exceeded" | i18next}}</span>\n          <textarea class="form-control" ng-model-options="{ allowInvalid: true }" ng-maxlength="MAX_INPUT_LENGTHS.description" ng-class="{\'border-danger\' : exportForm.message.$error.maxlength}" rows="3" cols="40" ng-model="emailAsAttachment.message" name="message" placeholder="{{ \'Optional: include a personal message\' | i18next }}" ng-trim="false"></textarea>\n          <span class="d-flex justify-content-end" ng-class="{\'text-danger\' : exportForm.message.$error.maxlength}">{{emailAsAttachment.message.length + \'/\' +  MAX_INPUT_LENGTHS.description}}</span>\n        </div>\n\n        <div class="form-group expiry-date-container">\n          <label class="control-label">{{ "Expires in" | i18next }}</label>\n          <select class="form-control" ng-model="emailAsAttachment.validForDays" ng-options="exp.value as exp.label for exp in ctrl.emailLinkExpiryOptions">\n          </select>\n        </div>\n\n        <div class="form-group form-check" id="export-email-link-password-required-checkbox">\n          <label class="checkbox form-check-label">\n            <input type="checkbox" class="form-check-input" ng-model="emailAsAttachment.passwordRequired">{{ "Require password for download" | i18next }}\n          </label>\n        </div>\n\n        <div class="form-group" ng-if="emailAsAttachment.passwordRequired">\n          <label class="control-label">{{ "Password" | i18next }}<span class="text-danger" data-bs-original-title="{{ \'Required\' | i18next }}" data-bs-placement="right">*</span></label>\n          <os-password password="emailAsAttachment.password" placeholder-text="{{ \'Enter password\' | i18next }}"></os-password>\n        </div>\n\n        <div class="form-group form-check">\n          <label class="checkbox form-check-label">\n            <input type="checkbox" class="form-check-input" ng-model="emailAsAttachment.sendCopyToMe">{{ "Send me a copy" | i18next }}\n          </label>\n        </div>\n      </div>\n    </div>\n    <p ng-if="isCAMToolPathExport() && hasSuppressedToolPaths" class="alert alert-warning">\n      <os-svg icon="performance-warning"></os-svg>\n      <span>{{ file.name + " will be exported with toolpaths suppressed" | i18next }}</span>\n    </p>\n  </div>\n  <div ng-if="spinner.show" class="modal-body">\n    <os-spinner spinner="spinner"></os-spinner>\n  </div>\n  <div class="modal-footer">\n    <div class="flex-fill" ng-if="!isCAMToolPathExport() && meshSkipWarning">\n      <os-svg icon="performance-warning"></os-svg>\n      <span class="control-label ps-1">{{ "This export format excludes any mesh elements." | i18next }}</span>\n    </div>\n    <button class="btn btn-primary" type="submit" ng-hide="formats.length === 0 || noSelectedPartsToExport" ng-disabled="exportDisabled()">{{ "Export" | i18next }}</button>\n    <button class="btn btn-secondary button-cancel" type="button" ng-click="cancel()">{{ "Cancel" | i18next }}</button>\n  </div>\n</form>\n\n')}]),e.exports=i},59907:function(e,t,n){var i="/project/web/woolsthorpe/app/partials/exportDxfOrDwg.html";n(14080).module("ng").run(["$templateCache",function(e){e.put(i,'<form class="form-horizontal export-dxf-or-dwg-dialog" name="exportDxfOrDwgForm" ng-submit="doExport()" autocomplete="off">\n  <div class="modal-header os-row os-align-center">\n    <h4 class="modal-title os-grow"><span class="title-description">{{dialog.title}}</span></h4>\n    <a href="{{dialog.helpUrl}}" target="help">\n      <os-svg class="os-help-btn" icon="help-button"></os-svg>\n    </a>\n    <button type="button" class="btn-close" ng-click="cancel()" aria-hidden="true"></button>\n  </div>\n  <div ng-show="!spinner.show" class="modal-body modal-overflow">\n    <p ng-if="dialog.exportErrorMessage" class="alert alert-info" id="export-error-alert">\n      <a class="float-end" href="{{dialog.helpUrl}}" target="help">\n        <os-svg class="os-help-btn" icon="help-button"></os-svg>\n      </a>\n      {{ dialog.exportErrorMessage | i18next }}\n    </p>\n    <div class="me-4" ng-if="!dialog.exportErrorMessage">\n      <div class="form-group multi-line-label-group">\n        <label class="control-label" ng-if="isMultiElementExport()">{{ "Zip file name" | i18next }}</label>\n        <label class="control-label" ng-if="!isMultiElementExport()">{{ "File name" | i18next }}\n          <a class="export-rules-link" ng-if="shouldShowExportRulesLink()" href="{{ exportRulesSettingsLink }}" target="_blank">{{ "View export rules" | i18next }}</a>\n        </label>\n          <input id="drawing-export-filename-input" class="form-control" type="text" ng-trim="true" maxlength="{{MAX_INPUT_LENGTHS.name}}" ng-model="dialog.name"\n                 bt-focus="true" ng-change="onFileNameChangedByUser()" autocomplete="off" spellcheck="false">\n          <span class="text-danger" ng-show="!dialog.nameValid">{{ "Valid file name is required." | i18next }}</span>\n      </div>\n      <div class="form-group">\n        <label class="control-label">{{"Format" | i18next}}</label>\n          <select id="drawing-export-format-dropdown" class="stl-export-mode form-control" ng-change="onNewFormat()"\n                  ng-model="dialog.exportChoice" ng-options="exportChoice.displayName for exportChoice in dialog.exportChoices"> </select>\n        <div ng-if="dialog.isDrawing && dialog.exportChoice.warningLine1">\n          <label class="text-left">{{dialog.exportChoice.warningLine1}}</label>\n          <br ng-if="dialog.isDrawing && dialog.exportChoice.warningLine2"/>\n          <label class="text-left" ng-if="dialog.isDrawing && dialog.exportChoice.warningLine2">{{dialog.exportChoice.warningLine2}}</label>\n        </div>\n      </div>\n      <div class="form-group" ng-if="dialog.exportChoice.versions.length > 0">\n        <label class="control-label">{{"Version" | i18next}}</label>\n          <select ng-if="dialog.exportChoice.versions.length > 1" class="stl-export-mode form-control" ng-model="dialog.exportVersion" ng-options="exportVersion as exportVersion.name for exportVersion in dialog.exportChoice.versions"> </select>\n          <label class="control-label version-label" ng-if="dialog.exportChoice.versions.length === 1">{{dialog.exportChoice.versions[0].name}}</label>\n      </div>\n      <div class="form-group" ng-if="!!dialog.sheetMetalFlat">\n        <label class="control-label">{{ "Scope" | i18next }}</label>\n          <select class="form-control" id="export-flat-pattern-options-dropdown" tabindex="3" ng-model="dialog.flatPatternOption"\n                  ng-options="n as n.label for n in dialog.flatPatternOptions" ng-change="onChangeFlatPatternOption()"></select>\n        <div class="form-group" ng-if="!!dialog.flatPatternOption.warning">\n          <label class="control-label space-right"></label>\n            <label class="os-warning-text">{{dialog.flatPatternOption.warning}}</label>\n        </div>\n      </div>\n      <div class="form-group text-left" ng-if="dialog.isDrawing && dialog.exportVersion.warningLine1">\n          <label>{{dialog.exportVersion.warningLine1}}</label>\n          <br ng-if="dialog.isDrawing && dialog.exportVersion.warningLine2"/>\n          <label ng-if="dialog.isDrawing && dialog.exportVersion.warningLine2">{{dialog.exportVersion.warningLine2}}</label>\n      </div>\n      <div class="form-group" ng-if="dialog.exportChoice.sheets.length > 0">\n        <label class="control-label">{{"Sheets" | i18next}}</label>\n          <select class="stl-export-mode form-control" ng-model="dialog.exportSheet" ng-change="onSheetsChanges()" ng-options="exportSheet as exportSheet.label for exportSheet in dialog.exportChoice.sheets"> </select>\n          <div ng-if="dialog.exportSheet.id === \'customSheet\'">\n            <input class="stl-export-mode form-control" ng-model="dialog.customSheets" ng-change="onSheetInputChange()" placeholder="{{ \'e.g. 1-3, 5, 7-9\' | i18next }}" type="text" autocomplete="off" spellcheck="false">\n            <p ng-show="!dialog.isValidSheetInput" class="text-danger">\n              {{ sheetsExportErrorMessage }}\n            </p>\n          </div>\n      </div>\n      <div class="form-group" ng-if="getShowHidePdfVersionDropdown()">\n        <label class="control-label">{{"Version" | i18next}}</label>\n        <select ng-if="dialog.exportChoice.pdfVersions.length > 1" class="stl-export-mode form-control" ng-model="dialog.pdfVersion" ng-options="pdfVersion as pdfVersion.name for pdfVersion in dialog.exportChoice.pdfVersions"> </select>\n      </div>\n      <div class="form-group multi-line-label-group" ng-if="dialog.exportChoice.overriddenDimensions.length > 0">\n        <label class="control-label">{{"Overridden dimensions" | i18next}}</label>\n          <select id="drawing-export-overriddenDimensions-dropdown" class="stl-export-mode form-control" ng-model="dialog.exportOverriddenDimension" ng-options="exportOverriddenDimension as exportOverriddenDimension.label for exportOverriddenDimension in dialog.exportChoice.overriddenDimensions"> </select>\n      </div>\n      <div class="form-group" ng-if="dialog.exportChoice.explodeTextChoices.length > 0">\n        <label class="control-label">{{"Text" | i18next}}</label>\n          <select class="stl-export-mode form-control" ng-model="dialog.explodeText" ng-options="explodeTextChoice as explodeTextChoice.label for explodeTextChoice in dialog.exportChoice.explodeTextChoices"> </select>\n      </div>\n      <div class="form-group" ng-if="dialog.exportChoice.pdfTextChoices.length > 0">\n        <label class="control-label">{{"Text" | i18next}}</label>\n          <select id="drawing-export-text-dropdown" class="stl-export-mode form-control" ng-model="dialog.pdfText" ng-options="pdfTextChoice as pdfTextChoice.label for pdfTextChoice in dialog.exportChoice.pdfTextChoices"> </select>\n      </div>\n      <div class="form-group" ng-if="getShowColorDropdown()">\n        <label class="control-label">{{"Color" | i18next}}</label>\n          <select id="drawing-export-color-dropdown" class="stl-export-mode form-control" ng-model="dialog.pdfColor" ng-options="pdfColorChoice as pdfColorChoice.label for pdfColorChoice in dialog.exportChoice.pdfColorChoices"> </select>\n      </div>\n      <div class="form-group" ng-if="getShowColorDropdown() && dialog.isDrawing && dialog.pdfColor && dialog.pdfColor.warning">\n        <label class="control-label">&nbsp;</label>\n          <label>{{dialog.pdfColor.warning}}</label>\n      </div>\n      <div class="form-group" ng-if="getShowUnits()">\n        <label class="control-label">{{"Units" | i18next}}</label>\n        <div class="form-check" ng-if="showWorkspaceUnitCheckbox()">\n          <label class="checkbox form-check-label os-splines-as-polylines-checkbox">\n            <input type="checkbox" class="form-check-input" ng-model="dialog.useWorkspaceUnits" ng-change="onChangeUseWorkspaceUnit()">{{"Use workspace units" | i18next}}\n          </label>\n        </div>\n          <select id="drawing-units-dropdown" class="stl-export-mode form-control" ng-model="dialog.currentUnits.length"\n                  ng-options="lengthUnit as lengthUnit.unitName for lengthUnit in dialog.lengthUnitChoices" ng-change="onChangeUnits()"\n                  ng-disabled="disableUnitsDropdown()"> </select>\n      </div>\n      <div class="form-group">\n        <label class="control-label">{{ "Options" | i18next }}</label>\n          <select class="form-control" id="export-options-dropdown" tabindex="3" ng-model="dialog.downloadOption"\n                  ng-options="n as n.label for n in dialog.downloadOptions" ng-disabled="dialog.areExportOptionsDisabled" ng-change="onChangeExportOption()"></select>\n      </div>\n      <div ng-if="isEmailAttachmentOptionSelected()">\n        <div class="form-group">\n          <label class="control-label">{{ "To" | i18next }}<span class="text-danger" data-bs-original-title="{{\'Required\' | i18next}}" data-bs-placement="right">*</span></label>\n            <os-suggestions class="add-email"\n              get-suggestions="findFriends(query)"\n              is-valid-new-suggestion="isValidEmail(query)"\n              os-input-tokens\n              on-suggestion-selected="TokenController.addToken(suggestion)"\n              placeholder="{{ \'Add recipients\' | i18next }}">\n            </os-suggestions>\n        </div>\n        <div class="form-group">\n          <label class="control-label">{{ "Subject" | i18next }}</label>\n            <input class="form-control" type="text" ng-trim="true" maxlength="{{MAX_INPUT_LENGTHS.name}}" ng-model="emailAsAttachment.subject">\n        </div>\n        <div class="form-group">\n          <label class="control-label">{{ "Message" | i18next }}</label>\n            <span ng-if="exportDxfOrDwgForm.message.$error.maxlength" class="fst-italic text-danger">{{"Character limit exceeded" | i18next}}</span>\n            <textarea class="form-control" rows="3" cols="40" ng-model="emailAsAttachment.message" ng-model-options="{ allowInvalid: true }" ng-maxlength="MAX_INPUT_LENGTHS.description" name="message" placeholder="{{ \'Optional: include a personal message\' | i18next}}" ng-trim="false"></textarea>\n            <span class="d-flex justify-content-end" ng-class="{\'text-danger\' : exportDxfOrDwgForm.message.$error.maxlength}">{{emailAsAttachment.message.length + \'/\' +  MAX_INPUT_LENGTHS.description}}</span>\n        </div>\n        <div class="form-group">\n          <label class="control-label">{{"Expires in" | i18next}}</label>\n            <select class="form-control" ng-model="emailAsAttachment.validForDays" ng-options="exp.value as exp.label for exp in emailLinkExpiryOptions"> </select>\n        </div>\n\n        <div class="form-check">\n          <label class="checkbox form-check-label">\n            <input type="checkbox" class="form-check-input" ng-model="emailAsAttachment.passwordRequired">{{"Require password for download" | i18next}}\n          </label>\n        </div>\n\n        <div class="form-group" ng-if="emailAsAttachment.passwordRequired">\n          <label class="control-label">{{"Password" | i18next}}<span class="text-danger" data-bs-original-title="{{\'Required\' | i18next}}" data-bs-placement="right">*</span></label>\n            <os-password password="emailAsAttachment.password" placeholder-text="{{ \'Enter password\' | i18next }}"></os-password>\n        </div>\n\n        <div class="form-check">\n          <label class="checkbox form-check-label">\n            <input class="form-check-input" type="checkbox" ng-model="emailAsAttachment.sendCopyToMe">{{"Send me a copy" | i18next}}\n          </label>\n        </div>\n      </div>\n\n      <div ng-if="isMul