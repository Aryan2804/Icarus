        \x3c!-- end item icon --\x3e\n        <div class="os-where-used-section-header os-row os-grow">\n          \x3c!-- configuration filter dropdown --\x3e\n          <div class="ellipseOverflowText os-row" ng-if="$ctrl.hasConfig">\n            <div ng-if="$ctrl.configFiltersDisplay.length === 0">\n              <div class="os-search-highlight-name item-name-container ellipseOverflowText source-name" data-bs-original-title="{{$ctrl.sourceItem.name}}">\n                <span class="ellipseOverflowText">{{$ctrl.sourceItem.name}}</span>\n              </div>\n            </div>\n            <div ng-if="$ctrl.configFiltersDisplay.length > 0" class="ellipseOverflowText">\n              <div data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\' class="os-where-used-filter-dropdown os-row os-grow config">\n                <div class="os-search-highlight-name item-name-container ellipseOverflowText source-name" data-bs-original-title="{{$ctrl.sourceItem.name}}">\n                  <span class="ellipseOverflowText">{{$ctrl.sourceItem.name}}</span>\n                </div>\n                <span class="source-filter caret"></span>\n              </div>\n              <ul class="filter-drop-down dropdown-menu config" role="menu">\n                <li ng-repeat="anOption in $ctrl.getConfigFilterArray()" ng-class="{\'os-selected\': $ctrl.isConfigFilterSelected(anOption, $ctrl.selectedConfigFilter)}"\n                  class="os-selectable-item where-used-filter os-col" ng-click="$ctrl.changeConfigFilter(anOption)">\n                  <div class="os-row config-part-name">\n                    <os-svg icon="{{$ctrl.getTypeIcon(anOption)}}" bt-no-focus class="type-icon"></os-svg>\n                    <span class="name ellipseOverflowText" data-bs-original-title="{{anOption.partName}}">{{anOption.partName}}</span>\n                    <span class="versions os-row">\n                      <span class="ellipseOverflowText os-row" data-bs-original-title="{{anOption.version.name}}">\n                        <os-svg icon="{{$ctrl.getConfigVersionType(anOption)}}" class="selected-filter-icon" bt-no-focus></os-svg>\n                        <span class="other-versions ellipseOverflowText">{{anOption.version.name}}</span>\n                      </span>\n                      <span class="ellipseOverflowText os-row" ng-repeat="v in anOption.otherVersions" data-bs-original-title="{{v.name}}">\n                        <os-svg icon="{{$ctrl.getConfigVersionType(v)}}" class="selected-filter-icon" bt-no-focus></os-svg>\n                        <span class="other-versions ellipseOverflowText">{{v.name}}</span>\n                      </span>\n                    </span>\n                  </div>\n                  <div class="os-row">\n                    <where-used-config-list ng-if="anOption.configuration.length !== 0" config-filter="anOption" configuration-name="anOption.partName"\n                      class="config-params os-col" ng-class="{\'os-selected\': $ctrl.isConfigFilterSelected(anOption, $ctrl.selectedConfigFilter)}"></where-used-config-list>\n                    <span class="config-preview" ng-class="{\'non-config\' : anOption.configuration.length === 0}">\n                      <os-thumbnail\n                        class="thumbnail-image-dropdown"\n                        has-thumbnail=\'true\'\n                        document-id="{{anOption.document.id}}"\n                        workspace-id=""\n                        version-id="{{anOption.version.id}}"\n                        element-id="{{anOption.elementId}}"\n                        api-configuration="{{$ctrl.getApiconfigForThumbnail(anOption)}}"\n                        ideal-height="170"\n                        ideal-width="300"\n                        document-thumbnail-stamp="{{}}"\n                        fallback-image="{{$ctrl.getFallBackImage(anOption)}}"\n                        require-config-match="true"\n                        retry-on-error="true"\n                        watch-changes="true">\n                      </os-thumbnail>\n                    </span>\n                  </div>\n                </li>\n                <div ng-if="$ctrl.canShowConfigFilterMore()" class="show-more-less dropdown-item" ng-click="$ctrl.stopPropagation($event)">\n                  <span\n                    ng-if="!$ctrl.showingMoreConfigFilters"\n                    ng-click="$ctrl.toggleMoreConfigFilters($event)">\n                    {{\'Show more\' | i18next}}\n                  </span>\n                  <span ng-if="$ctrl.showingMoreConfigFilters"\n                    ng-click="$ctrl.toggleMoreConfigFilters($event)">\n                    {{\'Show less\' | i18next}}\n                  </span>\n                  </div>\n              </ul>\n            </div>\n          </div>\n          \x3c!-- end configuration filter dropdown --\x3e\n          \x3c!-- configuration versions dropdown --\x3e\n          <div ng-if="!$ctrl.isNewSource && $ctrl.canShowConfigVersionFilter()" class="os-row filter-container">\n            <div class="os-row">\n              <div id="where-used-source-filter">\n                <div ng-if="$ctrl.deDupeVersionFilters.length === 0" class="os-where-used-filter-dropdown os-row os-grow">\n                  <div class="ellipseOverflowText selected-filter-name">\n                    <span ng-if="\'all\' !== $ctrl.selectedConfigVersion.id">\n                      <os-svg icon="{{$ctrl.getFilterTypeIcon($ctrl.selectedConfigVersion)}}" bt-no-focus class="selected-filter-icon"></os-svg>\n                    </span>\n                    <span>{{$ctrl.getConfigVersionName($ctrl.selectedConfigVersion)}}</span>\n                  </div>\n                </div>\n                <div ng-if="$ctrl.deDupeVersionFilters.length > 0" data-bs-toggle="dropdown" class="os-where-used-filter-dropdown os-row os-grow">\n                  <div class="ellipseOverflowText selected-filter-name">\n                    <span ng-if="\'all\' !== $ctrl.selectedConfigVersion.id">\n                      <os-svg icon="{{$ctrl.getFilterTypeIcon($ctrl.selectedConfigVersion)}}" bt-no-focus class="selected-filter-icon"></os-svg>\n                    </span>\n                    <span>{{$ctrl.getConfigVersionName($ctrl.selectedConfigVersion)}}</span>\n                  </div>\n                  <span class="source-filter caret" ng-click="$ctrl.collapseMoreVersionFilter()"></span>\n                </div>\n                <ul ng-if="$ctrl.deDupeVersionFilters.length > 0" class="filter-drop-down dropdown-menu"\n                  role="menu" ng-class="{\'show-more-version-filter\': $ctrl.showingMoreVersionFilters}">\n                  <li ng-if="!$ctrl.showingMoreVersionFilters" ng-repeat="anOption in $ctrl.deDupeVersionFilters" ng-class="{\'os-selected\': $ctrl.isConfigVersionSelected(anOption)}"\n                    class="os-selectable-item where-used-filter" ng-click="$ctrl.changeSelectedConfigVersionFilter(anOption)">\n                    <a>\n                      <os-svg icon="{{$ctrl.getConfigVersionType(anOption)}}" bt-no-focus\n                        class="selected-filter-icon"></os-svg>\n                      <span class="ellipseOverflowText" data-bs-original-title="{{$ctrl.getConfigVersionName(anOption)}}">{{$ctrl.getConfigVersionName(anOption)}}</span>\n                    </a>\n                  </li>\n                  <li ng-if="$ctrl.showingMoreVersionFilters" ng-repeat="anOption in $ctrl.deDupeVersionFilters" class="os-selectable-item where-used-filter">\n                    <div class="card">\n                      <div class="header">\n                        <span>\n                          <os-svg icon="{{$ctrl.getFilterTypeIcon(anOption)}}" bt-no-focus class="selected-filter-icon"></os-svg>\n                          <span class="ellipseOverflowText" data-bs-original-title="{{$ctrl.getSourceFilterName(anOption)}}">{{$ctrl.getSourceFilterName(anOption)}}</span>\n                        </span>\n                      </div>\n                      <div ng-class="{\'os-selected\': $ctrl.isConfigVersionSelected(anOption)}" class="os-selectable-item">\n                        <div class="body os-row" ng-click="$ctrl.changeSelectedConfigVersionInMoreFilter(anOption)">\n                          <div class="os-col">\n                            <div class="name ellipseOverflowText">{{anOption.partName}}</div>\n                            <div class="os-item-identifier">\n                              <span class="os-item-identifier-part-number ellipseOverflowText">{{anOption.partNumber}}</span>\n                            </div>\n                          </div>\n                          <os-thumbnail\n                            class="thumbnail-image-dropdown"\n                            has-thumbnail=\'true\'\n                            document-id="{{$ctrl.sourceItem.documentId}}"\n                            workspace-id=""\n                            version-id="{{anOption.id}}"\n                            element-id="{{anOption.elementId}}"\n                            part-id="{{anOption.partId}}"\n                            ideal-height="170"\n                            ideal-width="300"\n                            document-thumbnail-stamp="{{}}"\n                            fallback-image="{{$ctrl.getFallBackImage(anOption)}}"\n                            retry-on-error="true"\n                            watch-changes="true">\n                          </os-thumbnail>\n                        </div>\n                      </div>\n                    </div>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n          \x3c!-- end configuration versions dropdown --\x3e\n          <div ng-if="!$ctrl.hasConfig" class="os-search-highlight-name item-name-container ellipseOverflowText source-name" data-bs-original-title="{{$ctrl.sourceItem.name}}">\n            <span class="ellipseOverflowText">{{$ctrl.sourceItem.name}}</span>\n          </div>\n          <div ng-if="!$ctrl.hasConfig" class="os-row filter-container">\n            <div class="os-row">\n              \x3c!-- non-configured icon --\x3e\n              <span ng-if="\'all\' !== $ctrl.selectedVersionFilter.id">\n                <os-svg icon="{{$ctrl.getFilterTypeIcon($ctrl.selectedVersionFilter)}}" bt-no-focus class="selected-filter-icon"></os-svg>\n              </span>\n              <span ng-if="\'all\' === $ctrl.selectedVersionFilter.id">\n                <os-svg icon="where-used-all-versions" bt-no-focus class="all-icon-release"></os-svg>\n              </span>\n              \x3c!-- end non-configured icon --\x3e\n              \x3c!-- non-configured versions dropdown --\x3e\n              <div id="where-used-source-filter">\n                <div ng-if="$ctrl.deDupeVersionFilters.length === 0" class="os-row os-grow">\n                  <div class="ellipseOverflowText selected-filter-name">\n                    <span data-bs-original-title="{{$ctrl.getSourceFilterName($ctrl.selectedVersionFilter)}}" data-bs-placement="bottom">{{$ctrl.getSourceFilterName($ctrl.selectedVersionFilter)}}</span>\n                  </div>\n                </div>\n                <div ng-if="$ctrl.deDupeVersionFilters.length > 0" data-bs-toggle="dropdown" class="os-where-used-filter-dropdown os-row os-grow">\n                  <div class="ellipseOverflowText selected-filter-name">\n                    <span data-bs-original-title="{{$ctrl.getSourceFilterName($ctrl.selectedVersionFilter)}}" data-bs-placement="bottom">{{$ctrl.getSourceFilterName($ctrl.selectedVersionFilter)}}</span>\n                  </div>\n                  <span class="source-filter caret" ng-click="$ctrl.collapseMoreVersionFilter()"></span>\n                </div>\n                <ul ng-if="$ctrl.deDupeVersionFilters.length > 0" class="filter-drop-down dropdown-menu" role="menu"\n                  ng-class="{\'show-more-version-filter\': $ctrl.showingMoreVersionFilters}">\n                  <li ng-if="!$ctrl.showingMoreVersionFilters" ng-repeat="anOption in $ctrl.deDupeVersionFilters"\n                    ng-class="{\'os-selected\': $ctrl.shouldSelectVersion(anOption)}"\n                    class="os-selectable-item where-used-filter" ng-click="$ctrl.changeSourceVersionFilter(anOption)">\n                    <a>\n                      <os-svg icon="{{$ctrl.getFilterTypeIcon(anOption)}}" bt-no-focus class="selected-filter-icon"></os-svg>\n                      <span class="ellipseOverflowText" data-bs-original-title="{{$ctrl.getSourceFilterName(anOption)}}">{{$ctrl.getSourceFilterName(anOption)}}</span>\n                    </a>\n                  </li>\n                  <li ng-if="$ctrl.showingMoreVersionFilters" ng-repeat="anOption in $ctrl.versionFiltersInGroup" class="where-used-filter">\n                    <div class="card">\n                      <div class="header">\n                        <span class="os-row">\n                          <os-svg icon="{{$ctrl.getFilterTypeIcon(anOption.items[0])}}" bt-no-focus class="selected-filter-icon"></os-svg>\n                          <span class="ellipseOverflowText" data-bs-original-title="{{$ctrl.getSourceFilterName(anOption.items[0])}}">{{$ctrl.getSourceFilterName(anOption.items[0])}}</span>\n                        </span>\n                      </div>\n                      <div ng-repeat="item in anOption.items" ng-class="{\'os-selected\': item.id === $ctrl.selectedVersionFilter.id && item.partId === $ctrl.selectedVersionFilter.partId}"\n                        class="selectable-item">\n                        <div class="body os-row" ng-click="$ctrl.changeSourceVersionFilter(item)">\n                          <div class="os-col">\n                            <div class="name ellipseOverflowText">{{item.partName}}</div>\n                            <div class="os-item-identifier">\n                              <span class="os-item-identifier-part-number ellipseOverflowText">{{item.partNumber}}</span>\n                            </div>\n                          </div>\n                          <os-thumbnail\n                            class="thumbnail-image-dropdown"\n                            has-thumbnail=\'true\'\n                            document-id="{{$ctrl.sourceItem.documentId}}"\n                            workspace-id=""\n                            version-id="{{item.id}}"\n                            element-id="{{item.elementId}}"\n                            part-id="{{item.partId}}"\n                            ideal-height="170"\n                            ideal-width="300"\n                            document-thumbnail-stamp="{{}}"\n                            fallback-image="{{$ctrl.getFallBackImageForItem(item)}}"\n                            watch-changes="true">\n                          </os-thumbnail>\n                        </div>\n                      </div>\n                    </div>\n                  </li>\n                  <div ng-if="$ctrl.needShowMore()" class="show-more-less" ng-click="$ctrl.stopPropagation($event)">\n                    <span\n                      ng-if="!$ctrl.showingMoreVersionFilters"\n                      ng-click="$ctrl.toggleMoreVersionFilters($event)">\n                      {{\'Show more\' | i18next}}\n                    </span>\n                    <span\n                      ng-if="$ctrl.showingMoreVersionFilters"\n                      ng-click="$ctrl.toggleMoreVersionFilters($event)">\n                      {{\'Show less\' | i18next}}\n                    </span>\n                  </div>\n                </ul>\n              </div>\n              \x3c!-- end non-configured versions dropdown --\x3e\n            </div>\n          </div>\n        </div>\n        <os-svg icon="view-preview" class="expand-collapse-source-preview type-icon view-icon"\n          ng-class="{\'active\': !$ctrl.sourcePreviewCollapsed}"\n          ng-click="$ctrl.toggleSourcePreview()" data-bs-original-title="{{\'Toggle preview\' | i18next}}"></os-svg>\n      </div>\n      \x3c!-- source item preview area --\x3e\n      <div ng-if="!$ctrl.sourcePreviewCollapsed && $ctrl.isQueryingWhereUsed && $ctrl.needReload" class="os-where-used-source-preview os-row" ng-class="{\'config\': $ctrl.shouldShowConfigList()}">\n        <div class="os-spinner-medium os-spinner-spinning"></div>\n      </div>\n      <div ng-show="!$ctrl.sourcePreviewCollapsed && (!$ctrl.isQueryingWhereUsed || ($ctrl.isQueryingWhereUsed && !$ctrl.needReload))" class="os-where-used-source-preview os-row" ng-class="{\'config\': $ctrl.shouldShowConfigList()}">\n        <os-thumbnail\n          ng-if="!$ctrl.hasConfig"\n          has-thumbnail=\'{{$ctrl.hasThumbnail()}}\'\n          document-id="{{$ctrl.sourceItem.documentId}}"\n          workspace-id="{{$ctrl.getVersionFilterForThumbnail().versionOrWorkspace === \'w\' ? $ctrl.selectedVersionFilter.id : \'\'}}"\n          version-id="{{$ctrl.getVersionFilterForThumbnail().versionOrWorkspace === \'v\' ? $ctrl.selectedVersionFilter.id : \'\'}}"\n          element-id="{{$ctrl.sourceItem.elementId}}"\n          part-id="{{$ctrl.sourceItem.partId}}"\n          ideal-height="170"\n          ideal-width="300"\n          document-thumbnail-stamp="{{$ctrl.sourceItem.thumbnailStamp ? $ctrl.sourceItem.thumbnailStamp : \'\'}}"\n          fallback-image="{{$ctrl.sourceItemDefaultPreview ? $ctrl.sourceItemDefaultPreview : $ctrl.getFallBackImageForItem($ctrl.sourceItem)}}"\n          watch-changes="true">\n        </os-thumbnail>\n        <where-used-config-list ng-if="$ctrl.shouldShowConfigList()" config-filter="$ctrl.selectedConfigFilter"\n            configuration-name="$ctrl.sourceItem.name" class="config-params ellipseOverflowText os-col"></where-used-config-list>\n        <span class="config-preview" ng-if="$ctrl.hasConfig">\n          <os-thumbnail\n            ng-if="!$ctrl.isDefaultConfigFilter()"\n            has-thumbnail=\'true\'\n            document-id="{{$ctrl.selectedConfigFilter.document.id}}"\n            workspace-id="{{$ctrl.selectedConfigFilter.versionOrWorkspace === \'w\' ? $ctrl.selectedConfigFilter.version.id : \'\'}}"\n            version-id="{{$ctrl.selectedConfigFilter.versionOrWorkspace === \'v\' ? $ctrl.selectedConfigFilter.version.id : \'\'}}"\n            element-id="{{$ctrl.selectedConfigFilter.elementId}}"\n            api-configuration="{{$ctrl.getApiconfigForThumbnail($ctrl.selectedConfigFilter)}}"\n            ideal-height="170"\n            ideal-width="300"\n            document-thumbnail-stamp="{{$ctrl.sourceItem.thumbnailStamp ? $ctrl.sourceItem.thumbnailStamp : \'\'}}"\n            fallback-image="{{$ctrl.sourceItemDefaultPreview ? $ctrl.sourceItemDefaultPreview : $ctrl.getFallBackImage($ctrl.selectedConfigFilter)}}"\n            require-config-match="true"\n            retry-on-error="true"\n            watch-changes="true">\n          </os-thumbnail>\n          <os-thumbnail\n            ng-if="$ctrl.isDefaultConfigFilter()"\n            has-thumbnail=\'true\'\n            document-id="{{$ctrl.sourceItem.documentId}}"\n            workspace-id="{{$ctrl.sourceItemVersionOrWorkspace === \'w\' ? $ctrl.sourceItemVersionWorkspaceId : \'\'}}"\n            version-id="{{$ctrl.sourceItemVersionOrWorkspace === \'v\' ? $ctrl.sourceItemVersionWorkspaceId : \'\'}}"\n            element-id="{{$ctrl.sourceItem.elementId}}"\n            part-id="{{$ctrl.sourceItem.partId}}"\n            ideal-height="170"\n            ideal-width="300"\n            document-thumbnail-stamp="{{$ctrl.sourceItem.thumbnailStamp ? $ctrl.sourceItem.thumbnailStamp : \'\'}}"\n            fallback-image="{{$ctrl.sourceItemDefaultPreview ? $ctrl.sourceItemDefaultPreview : $ctrl.getFallBackImageForItem($ctrl.sourceItem)}}"\n            require-config-match="true"\n            watch-changes="true">\n          </os-thumbnail>\n        </span>\n      </div>\n      \x3c!-- 