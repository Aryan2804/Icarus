anner system-check-loading-banner">{{"Checking your browser" | i18next}}</h3>\n        </div>\n        <div ng-controller="CompatibilityChecksController as sysCheck" ng-show="sysCheck.isCheckComplete === true">\n            <div ng-if="ctrl.getIsSystemCheckSpinnerDone()">\n                <div class="system-check-result-container" ng-if="sysCheck.doAllWebSocketChecksPass() && sysCheck.doAllWebGLChecksPass()">\n                    <os-svg icon="notification-success" class="result-icon-container"></os-svg>\n                    <h3 class="modal-banner system-check-success-banner">{{ "Browser looks good!" | i18next}}</h3>\n                </div>\n                <div class="system-check-result-container system-check-error-container" ng-if="!sysCheck.doAllWebSocketChecksPass() || !sysCheck.doAllWebGLChecksPass()">\n                    <div  class="system-check-error-row" ng-if="!sysCheck.isCoreWebGLSupported()">\n                        <os-svg icon="error" class="system-check-error-icon"></os-svg>\n                        <div class="system-check-error-text">{{"Enable WebGL in your browser for more consistent performance." | i18next}}</div>\n                    </div>\n                    <div  class="system-check-error-row" ng-if="sysCheck.areExtensionsMissing()">\n                        <os-svg icon="error" class="system-check-error-icon"></os-svg>\n                        <div class="system-check-error-text">{{"WebGL extensions are missing. See \\"Full performance check\\" for more information." | i18next}}</div>\n                    </div>\n                    <div  class="system-check-error-row" ng-if="!sysCheck.doAllWebSocketChecksPass()">\n                        <os-svg icon="error" class="system-check-error-icon"></os-svg>\n                        <div class="system-check-error-text">{{"There was a problem creating a Websocket connection to Onshape\'s servers. This usually means you are using a HTTP proxy which does not support Websockets." | i18next}}</div>\n