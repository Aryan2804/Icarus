"\n  oncontextmenu="return false;"\n  ng-class="{\'is-on-root\': tabController.selectedGroup.isRoot()}"\n  ng-hide="tabController.shouldHideTabBar()"\n>\n  <div class="os-tab-bar-controls">\n    <div ng-hide="hideEnabledAddElementButton()"\n         id="add-element-button"\n         class="btn-add-element"\n         data-bs-original-title="{{ \'Insert new tab\' | i18next }}">\n      <os-svg icon="plus-button"></os-svg>\n    </div>\n    <div ng-show="showDisabledAddElementButton()" class="disabled">\n      <os-svg icon="plus-button"></os-svg>\n    </div>\n  </div>\n  \x3c!-- parent folders --\x3e\n  <div class="os-tab-bar-breadcrumbs"\n       ng-if="tabController.selectedGroup && !tabController.selectedGroup.isRoot()"\n       ng-class="{\'is-collapsed\': tabController.breadcrumbsAreCollapsed}">\n    <div class="os-tab-bar-breadcrumb"\n         ng-repeat="parent in tabController.selectedParentsForDisplay"\n         data-bs-original-title="{{ parent.getElementName() }}"\n         ng-click="tabController.openGroup(parent)"\n         >\n      <div class="breadcrumb-content" ng-if="$first">\n        <os-svg icon="home-button"></os-svg>\n      </div>\n      <div class="breadcrumb-flag" ng-if="!$first"></div>\n      <div class="breadcrumb-content"\n          ng-if="!$first">\n          <os-svg icon="folder"></os-svg>\n          <span>{{ parent.getElementName() }}</span>\n      </div>\n    </div>\n    <div class="os-tab-bar-breadcrumb tab-bar-breadcrumb-folders-dropdown-container"\n          ng-if="tabController.selectedParentsForDropdown.length > 0"\n          ng-click="tabController.toggleSelectedParentDropdown()"\n          data-bs-original-title="{{ \'Parent folders\' | i18next}}"\n          >\n      <div class="tab-bar-breadcrumb-folders-dropdown" ng-if="tabController.showSelectedParentsDropdown">\n        <div\n          class="tab-bar-breadcrumb-folders-dropdown-row"\n          ng-repeat="parent in tabController.selectedParentsForDropdown"\n          data-bs-original-title="{{ parent.getElementName() }}"\n          ng-click="tabController.openGroup(parent)">\n          <div class="breadcrumb-content">\n            <os-svg icon="folder"></os-svg>\n            <span>{{ parent.getElementName() }}</span>\n          </div>\n        </div>\n      </div>\n      <div class="tab-bar-breadcrumb-folders-dropdown-placeholder" ng-if="!tabController.showSelectedParentsDropdown"></div>\n      <div class="breadcrumb-flag"></div>\n      <div class="breadcrumb-content">\n        <span class="hidden-folders-dropdown-toggle">...</span>\n      </div>\n    </div>\n    \x3c!-- current folder --\x3e\n    <div class="os-tab-bar-breadcrumb"\n         data-bs-original-title="{{ tabController.selectedGroup.getElementName() }}">\n      <div class="breadcrumb-flag"></div>\n      <div class="breadcrumb-content">\n        <os-svg icon="folder"></os-svg>\n        <span>{{ tabController.selectedGroup.getElementName() }}</span>\n      </div>\n    </div>\n  </div>\n\x3c!-- normal elements --\x3e\n  <div class="document-tabs-container">\n    <div class="left-tab-shadow"></div>\n    <tab-list class="os-tab-bar-tablist">\n      <tab-list-item class="os-tab-bar-tab"\n        ng-repeat="tab in tabController.visibleTabs"\n        tab="tab" rename-observable="::tabController.tabRenameObservable"\n        ng-class="{\'active\': tab.getIsActive() || tab.getElementId() === tabController.activeTabId, \'disabled\': tab.getIsDisabled(), \'hidden\':  tab.getIsRemoved(), \'os-tab-bar-tab-group\': tab.isGroup}"\n        data-has-thumbnail="{{tab.hasThumbnail()}}"\n        data-id="{{::tab.getElementId()}}" data-icon-src="{{tab.getIconSrc()}}">\n      </tab-list-item>\n    </tab-list>\n    <div class="right-tab-shadow"></div>\n  </div>\n  <div class="os-row os-no-shrink">\n    <li class="document-tabs-button document-tabs-scroll-button hidden scroll-left" oncontextmenu="return false;" ng-mousedown="tabController.scrollTabsLeft($event)">\n      <div id="scroll-elements-left-button"