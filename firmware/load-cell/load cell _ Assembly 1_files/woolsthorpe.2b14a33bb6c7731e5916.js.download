wState(\'searchVisible\')}"\n              ng-click="setViewState(\'searchVisible\', \'toggle\')"\n              data-bs-original-title="{{filters.searchText}}">\n        <os-svg ng-class="{\'active\': !!filters.searchText}" icon="search-button"></os-svg>\n      </button>\n      <div uib-dropdown class="dropdown" ng-if="!TabCtrl.isPublication">\n        <button class="os-button os-clear tab-manager-sort-button"\n          uib-dropdown-toggle\n          data-bs-original-title="{{TabCtrl.displayText.sortText}}">\n          <os-svg ng-class="{\'active\': !!filters.predicate.value}" icon="tab-sort-dropdown"></os-svg>\n        </button>\n        <ul uib-dropdown-menu class="dropdown-menu tab-manager-dropdown-menu document-panel-dropdown-menu" menu-width="none">\n          <li class="dropdown-item"\n              ng-class="{\'selected\': predicate.label === filters.predicate.label}"\n              ng-click="setViewState(\'sortBy\', predicate.id)"\n              ng-repeat="predicate in predicates">\n            <span>{{predicate.label}}</span>\n          </li>\n        </ul>\n      </div>\n      <button class="os-button os-clear tab-manager-filter-button"\n              ng-class="{\'os-active\': getViewState(\'filterButtonsVisible\')}"\n              ng-click="setViewState(\'filterButtonsVisible\', \'toggle\')"\n              data-bs-original-title="{{TabCtrl.displayText.filterText}}">\n        <os-svg ng-if="!TabCtrl.someFilterActive()" icon="filter-results-button"></os-svg>\n        <os-svg ng-if="TabCtrl.someFilterActive()" icon="filter-collapsed-button"></os-svg>\n      </button>\n      <div class="view-icons">\n        <os-svg class="view-icon"\n                icon="view-list"\n                ng-click="setViewState(\'tabs\', \'list-view\')"\n                ng-class="{\'active\': view.tabs === \'list-view\'}"\n                data-bs-original-title="{{(\'List view\' | i18next)}}"></os-svg>\n        <os-svg class="view-icon"\n                icon="view-card"\n       